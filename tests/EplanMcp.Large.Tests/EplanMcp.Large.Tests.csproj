<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Every test here is Size=Large: it needs a running EPLAN with the fixture project (README.md). CI builds the project
      but filters out Large tests, which leaves this assembly with zero tests; exit code 8 ("zero tests ran") is then
      not a failure.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests start the real eplanmcp.exe, which this reference copies next to them. -->
    <ProjectReference Include="..\..\src\EplanMcp.Host\EplanMcp.Host.csproj" />
    <!-- P6 has no registered planning endpoint; feed checked Bridge evidence into the actual pure planner. -->
    <ProjectReference Include="..\..\src\EplanMcp.Bridge.Core\EplanMcp.Bridge.Core.csproj" />
    <Compile Include="..\EplanMcp.Bridge.Core.Tests\FakePropertyReadAdapter.cs" Link="FakePropertyReadAdapter.cs" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- Input files the import tests copy below the imports root (S34's device list exports of the sample project). -->
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
