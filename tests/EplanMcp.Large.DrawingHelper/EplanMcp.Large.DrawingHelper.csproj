<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only reader and rollback probe; no fault injection is exposed through production operations. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <IsPackable>false</IsPackable>
    <EplanBinPath Condition="'$(EplanBinPath)' == ''">C:\Program Files\EPLAN\Platform\2026.0.3\Bin</EplanBinPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EplanMcp.Bridge.Eplan\EplanMcp.Bridge.Eplan.csproj" />
    <PackageReference Include="Newtonsoft.Json" ExcludeAssets="runtime" PrivateAssets="all" />
    <Reference Include="WindowsBase" />
    <Reference Include="Eplan.EplApi.AFu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.AFu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Starteru">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.Starteru.dll</HintPath>
    </Reference>
    <Reference Include="Eplan.EplApi.Systemu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.Systemu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Baseu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.Baseu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.DataModelu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.DataModelu.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
