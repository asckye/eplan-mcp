            "string",
            "null"
          ]
        },
        "recovered": {
          "type": "boolean"
        }
      },
      "$defs": {
        "point": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
