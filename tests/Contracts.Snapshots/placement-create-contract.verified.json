{
  "profile": "full",
  "tool": {
    "name": "eplan_placement_create",
    "title": "Create text and graphics on an EPLAN page",
    "description": "Creates text, line, rectangle, polyline, arc, ellipse, path_text or image on a Circuit, Overview or Graphics page; mm, bottom left, y up; angles in degrees. Path_text is native path function text for device function descriptions and reports. Image file: relative imports path. Omit dry_run to preview; false executes. One undo; approval outside scratch. Text needs the project display language or ??_??; ??_?? cannot be mixed with languages (A54). Example: {\"project\":\"P\",\"page\":\"1\",\"items\":[{\"kind\":\"line\",\"points\":[[1,1],[2,2]]}]}.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "page",
        "items"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "line",
                  "rectangle",
                  "path_text",
                  "polyline",
                  "arc",
                  "ellipse",
                  "image"
                ]
              },
              "position": {
                "type": "array"
              },
              "points": {
                "type": "array"
              },
              "corners": {
                "type": "array"
              },
              "center": {
                "type": "array"
              },
              "contents": {
                "type": "object"
              },
              "height_mm": {
                "type": "number"
              },
              "radius_mm": {
                "type": "number"
              },
              "radius_x_mm": {
                "type": "number"
              },
              "radius_y_mm": {
                "type": "number"
              },
              "angle": {
                "type": "number"
              },
              "start_angle": {
                "type": "number"
              },
              "end_angle": {
                "type": "number"
              },
              "file": {
                "type": "string"
              }
            }
          }
        },
        "snap_to_grid": {
          "type": "boolean",
          "default": true
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "show_page": {
          "type": "boolean",
          "default": false,
          "description": "Open page (UI)."
        },
        "response_format": {
          "enum": [
            "concise",
            "detailed"
          ],
          "default": "concise"
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "page",
        "execution",
        "dryRun",
        "gridSize",
        "boundarySource",
        "items",
        "changes",
        "connectionChanges"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "execution": {
          "enum": [
            "not_started",
            "committed"
          ]
        },
        "dryRun": {
          "type": "boolean"
        },
        "gridSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "boundarySource": {
          "enum": [
            "Page.Size",
            "unverified"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requested",
              "actual",
              "bounds",
              "snapped"
            ],
            "properties": {
              "requested": {
                "$ref": "#/$defs/item"
              },
              "actual": {
                "$ref": "#/$defs/item"
              },
              "bounds": {
                "type": [
                  "array",
                  "null"
                ],
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "snapped": {
                "type": "boolean"
              }
            }
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        },
        "connectionChanges": {
          "type": "array",
          "maxItems": 0
        },
        "fingerprint": {
          "type": "string"
        },
        "pageShown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hint": {
