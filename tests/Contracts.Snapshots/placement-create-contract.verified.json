          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "item": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "position",
                "contents",
                "height_mm"
              ],
              "properties": {
                "kind": {
                  "const": "text"
                },
                "position": {
