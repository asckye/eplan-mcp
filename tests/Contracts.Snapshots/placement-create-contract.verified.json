              "additionalProperties": false,
              "required": [
                "kind",
                "corners"
              ],
              "properties": {
                "kind": {
                  "const": "rectangle"
                },
                "corners": {
                  "$ref": "#/$defs/pair"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "points"
              ],
              "properties": {
                "kind": {
                  "const": "polyline"
                },
                "points": {
                  "$ref": "#/$defs/points"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "center",
                "radius_mm",
                "start_angle",
                "end_angle"
              ],
              "properties": {
                "kind": {
                  "const": "arc"
                },
                "center": {
                  "$ref": "#/$defs/point"
                },
                "radius_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                },
                "start_angle": {
                  "type": "number"
                },
                "end_angle": {
                  "type": "number"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "center",
                "radius_x_mm",
