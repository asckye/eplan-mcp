<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF leaves System.IO out of the implicit usings (System.Windows.Shapes.Path); the shared test files need it. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Host tests' clock that moves only when told to, for deadlines and timers. -->
    <Compile Include="..\EplanMcp.Host.Tests\Safety\ManualTime.cs" Link="Shared\ManualTime.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EplanMcp.Workbench\EplanMcp.Workbench.csproj" />
    <!-- The real Host channel talks to the real Workbench pipe server in the Medium tests. -->
    <ProjectReference Include="..\..\src\EplanMcp.Host\EplanMcp.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The Workbench's own source, scanned by the theme and accessibility tests (SourceScan): embedded, so the tests
      need no file system and read what is built, not a copied list (as TIA's tests do).
    -->
    <EmbeddedResource Include="..\..\src\EplanMcp.Workbench\**\*.xaml;..\..\src\EplanMcp.Workbench\**\*.cs"
                      Exclude="..\..\src\EplanMcp.Workbench\bin\**;..\..\src\EplanMcp.Workbench\obj\**"
                      LogicalName="Source/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
