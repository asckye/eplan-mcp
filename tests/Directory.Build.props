<Project>
  <!--
    Test projects inherit the repository rules (warnings as errors included) and add the xUnit v3 setup.
    Each test class carries [Trait("Size", "Small|Medium|Large")] so CI can filter (docs/standards/testing.md).
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code reads better without ConfigureAwait noise; xUnit has no synchronization context to escape. -->
    <NoWarn>$(NoWarn);CA2007;CA1707</NoWarn>
    <!--
      CI asks every test assembly for a TRX report (development-workflow section 7). The default name is a timestamp, so
      two assemblies that finish in the same microsecond overwrite each other's report and the test count floor finds no
      results; a name per assembly cannot collide.
    -->
    <TestingPlatformCommandLineArguments Condition="'$(CI)' == 'true'">$(TestingPlatformCommandLineArguments) --report-xunit-trx-filename $(MSBuildProjectName).trx</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup>
    <!-- xUnit v3 runs on Microsoft.Testing.Platform (selected in global.json); no VSTest adapter needed. -->
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <!-- Names a hung test in CI (EPLANMCP_HANG_REPORT_DIR); see the file. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/HangWatch.cs" Link="Shared/HangWatch.cs" />
    <TestingPlatformBuilderHook Include="5D0F3A9E-6C1B-4E57-9B2A-0F4C8E7D1A63" DisplayName="Hang watch" TypeFullName="EplanMcp.Tests.HangWatch" />
  </ItemGroup>
</Project>
