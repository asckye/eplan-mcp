    <EmbeddedResource Include="..\EplanMcp.Large.Tests\fixtures\batch-read-recipes.json" LogicalName="BatchReadRecipes.json" />
    <EmbeddedResource Include="..\EplanMcp.Large.Tests\fixtures\batch-write-recipes.json" LogicalName="BatchWriteRecipes.json" />
    <EmbeddedResource Include="..\..\catalog\eplan-2026.0.3\types.jsonl" LogicalName="CatalogTypes.jsonl" />
