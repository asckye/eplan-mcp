    { "id": "host", "type": "backend", "label": "Host", "sublabel": "eplanmcp.exe" },
    { "id": "bridge", "type": "backend", "label": "Bridge", "sublabel": "管道线程" },
    { "id": "main", "type": "external", "label": "EPLAN 主线程", "sublabel": "DataModel API" },
