{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "EplanMcp 开发工作流程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "docs/diagrams/development-workflow/development-workflow.html",
    "legend": {
      "entries": {
        "frontend": { "label": "人工操作" },
        "backend": { "label": "开发步骤" },
        "security": { "label": "关卡与审批" },
        "external": { "label": "外部输入 / 实机环境" },
        "database": { "label": "主干仓库" }
      }
    }
  },
  "lanes": [
    { "id": "plan", "label": "规划" },
    { "id": "design", "label": "设计（L2 / L3）" },
    { "id": "build", "label": "实现与评审" },
    { "id": "gate", "label": "质量关卡" },
    { "id": "release", "label": "交付" }
  ],
  "phases": [
    { "id": "phase_plan", "label": "规划", "fromCol": 0, "toCol": 1 },
    { "id": "phase_make", "label": "设计与实现", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "phase_verify", "label": "验证与交付", "fromCol": 4, "toCol": 5 }
  ],
  "groups": [
    { "id": "merge_gate", "label": "合并前必须通过", "lane": "gate", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["issue", "triage", "impl", "pr", "ci", "live", "merge"],
  "nodes": [
    { "id": "issue", "lane": "plan", "col": 0, "type": "external", "label": "Issue", "sublabel": "问题与验收标准" },
    { "id": "triage", "lane": "plan", "col": 1, "type": "backend", "label": "分级与就绪", "sublabel": "L0–L3 · DoR" },
    { "id": "spec", "lane": "design", "col": 2, "type": "backend", "label": "设计产物", "sublabel": "工具规格 / 设计文档" },
    { "id": "adr", "lane": "design", "col": 3, "type": "security", "label": "ADR", "sublabel": "Proposed → 人工确认", "tag": "单向门" },
    { "id": "impl", "lane": "build", "col": 3, "type": "backend", "label": "实现", "sublabel": "短分支 · 小步提交" },
    { "id": "pr", "lane": "build", "col": 4, "type": "frontend", "label": "PR 与评审", "sublabel": "自查清单 · AI 评审" },
    { "id": "ci", "lane": "gate", "col": 4, "type": "security", "label": "CI 关卡", "sublabel": "构建 · 测试 · 契约快照", "tag": "禁止 AI 署名" },
    { "id": "live", "lane": "gate", "col": 5, "type": "external", "label": "实机测试", "sublabel": "EPLAN · scratch 项目" },
    { "id": "merge", "lane": "release", "col": 5, "type": "database", "label": "合并 main", "sublabel": "CHANGELOG · SemVer" }
  ],
  "edges": [
    { "id": "issue-triage", "from": "issue", "to": "triage", "variant": "default" },
    { "id": "triage-impl", "from": "triage", "to": "impl", "label": "L0 / L1", "variant": "emphasis" },
    { "id": "triage-spec", "from": "triage", "to": "spec", "label": "L2 / L3", "variant": "default", "role": "branch" },
    { "id": "spec-adr", "from": "spec", "to": "adr", "label": "L3", "variant": "security" },
    { "id": "spec-impl", "from": "spec", "to": "impl", "label": "L2 已合并", "variant": "default" },
    { "id": "adr-impl", "from": "adr", "to": "impl", "label": "Accepted", "variant": "security" },
    { "id": "impl-pr", "from": "impl", "to": "pr", "variant": "emphasis" },
    { "id": "pr-ci", "from": "pr", "to": "ci", "variant": "emphasis" },
    { "id": "ci-impl", "from": "ci", "to": "impl", "label": "失败退回", "variant": "security", "role": "error" },
    { "id": "ci-live", "from": "ci", "to": "live", "label": "涉及 EPLAN", "variant": "emphasis" },
    { "id": "ci-merge", "from": "ci", "to": "merge", "label": "不涉及 EPLAN", "variant": "default", "role": "branch" },
    { "id": "live-merge", "from": "live", "to": "merge", "label": "结果写进 PR", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "变更分级",
      "items": [
        "L0 琐碎：直接 PR",
        "L1 常规：Issue + PR",
        "L2 显著：先合并工具规格或设计文档",
        "L3 架构级：ADR，人工确认后生效"
      ]
    },
    {
      "dot": "emerald",
      "title": "完成标准",
      "items": [
        "CI 全绿，契约快照已逐项审视",
        "写操作有审批、审计和回滚",
        "实机测试结果写进 PR",
        "CHANGELOG 已更新，没有 AI 署名"
      ]
    }
  ]
}
