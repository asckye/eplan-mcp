# ---- Build output ----
[Bb]in/
[Oo]bj/
artifacts/
publish/
*.binlog

# ---- IDE / tooling ----
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo
*.DotSettings.user

# ---- Test results / coverage ----
TestResults/
coverage/
*.coverage
*.trx

# ---- Runtime data produced by local runs (audit logs, scratch projects, exports) ----
.local/
logs/
*.log

# ---- NuGet ----
*.nupkg
*.snupkg
packages/

# ---- Repository-specific ----
# Reference checkouts of other projects; never part of this product.
third_party/
# Machine-specific backups (e.g. exported registry keys). May contain personal data.
backup/

# ---- EPLAN artefacts that must never be committed ----
# Real customer projects and their databases. Test fixtures live under tests/fixtures/ and are allow-listed there.
*.elk
*.edb/
*.zw1
!tests/fixtures/**/*.zw1

# ---- Agent skills ----
# Installed skill files are restored from skills-lock.json (see README, development tools); only the lock is tracked.
.claude/skills/archify/
# archify scratch folders (candidates, receipts, browser evidence); finished diagrams live in docs/diagrams/.
.archify/
# archify delivery receipts next to each diagram (provenance of one local run, not reviewed content).
docs/diagrams/**/*.delivery.json
