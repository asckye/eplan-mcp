<?xml version="1.0" encoding="utf-8"?>
<!--
  Single package source + source mapping:
  - avoids NU1507 (multiple sources with Central Package Management), which TreatWarningsAsErrors would turn into a build break;
  - closes dependency-confusion attacks via machine-level feeds (see docs/standards/security.md, SEC-15).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
