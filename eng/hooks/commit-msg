#!/usr/bin/env bash
# Local git hook. Enable once per clone:  git config core.hooksPath eng/hooks
# Merge and fixup commits are exempt from the subject format, never from the attribution rule.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
first_line="$(head -n 1 "$1")"
if [[ "$first_line" =~ ^(Merge|Revert\ \"|fixup!|squash!) ]]; then
    exec bash "$root/eng/scripts/check-commit-message.sh" "$1"
fi
exec bash "$root/eng/scripts/check-commit-message.sh" --subject "$1"
