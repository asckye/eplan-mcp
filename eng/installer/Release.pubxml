<Project>
  <!-- Keep bundling properties local to Host; global command-line properties would also affect its references. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'EplanMcp.Host'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'EplanMcp.Host'">
    <!-- Match the single-file analyzer shipped with global.json's SDK; SDK roll-forward must not change the lock. -->
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks" ILLinkPackVersion="10.0.12" />
  </ItemGroup>
</Project>
