{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asckye/eplan-mcp/schemas/pack-lock.schema.json",
  "title": "EplanMcp pack lock (pack.lock.json), lockVersion 1",
  "type": "object",
  "properties": {
    "lockVersion": {
      "type": "integer",
      "description": "The lock format. A reader refuses a version it does not know.",
      "const": 1
    },
    "pack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "manifestSha256"
      ],
      "additionalProperties": false,
      "description": "One exact pack version, by the SHA-256 of its pack.json; the manifest lists every resource's hash, so this pins the content too."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "manifestSha256"
        ],
        "additionalProperties": false,
        "description": "One exact pack version, by the SHA-256 of its pack.json; the manifest lists every resource's hash, so this pins the content too."
      }
    }
  },
  "required": [
    "lockVersion",
    "pack"
  ],
  "additionalProperties": false,
  "description": "pack.lock.json beside pack.json: the pack itself and every pack it needs, directly or through another, at the exact version resolved. Sorted by id and without times, so one resolution gives one file."
}
