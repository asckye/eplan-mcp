<Project>
  <!--
    Central Package Management: every NuGet version is declared here exactly once.
    Projects reference packages without a Version attribute.
    Adding a dependency needs a reason in the PR description (see docs/process/development-workflow.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Official MCP C# SDK (Apache-2.0); 2.x implements the 2026-07-28 revision and keeps 2025-11-25 clients working. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!--
      Bridge JSON (MIT). Compile-time only in the Bridge: EPLAN 2026 ships 13.0.3 and the add-in uses that copy
      (coding standards 9.7). Never raise above the version in the EPLAN Bin directory.
    -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <!--
      MIT. Build time only, never shipped: rejects EPLAN members that look like reads but write
      (src/EplanMcp.Bridge.Eplan/BannedSymbols.txt, M2 design section 5).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <!-- Apache-2.0. Runs on Microsoft.Testing.Platform, which global.json selects for `dotnet test`. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
