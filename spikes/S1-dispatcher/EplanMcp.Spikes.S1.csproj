<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unsigned spike add-in (see S0); spike S1 measures main-thread dispatch from a background thread. -->
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>EplanMcp.Spikes.S1</AssemblyName>
    <RootNamespace>EplanMcp.Spikes.S1</RootNamespace>
    <AssemblyTitle>EplanMcp.Spikes.S1</AssemblyTitle>
  </PropertyGroup>

  <!-- EPLAN assemblies are referenced from the local installation and never copied (Private=false). -->
  <ItemGroup>
    <Reference Include="Eplan.EplApi.AFu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.AFu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Baseu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.Baseu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.DataModelu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.DataModelu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.HEServicesu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.HEServicesu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WPF Dispatcher (System.Windows.Threading) backs EplanMainThreadDispatcher and offers Invoke with a timeout. -->
    <Reference Include="WindowsBase" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(EplanBinPath)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
