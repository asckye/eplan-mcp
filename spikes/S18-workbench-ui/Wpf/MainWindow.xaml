<Window
    x:Class="EplanMcp.Spikes.S18.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:TiaOpenness.Gui.ViewModels"
    Width="1040" Height="900"
    Background="{DynamicResource Primer.bg}" Foreground="{DynamicResource Primer.text}"
    FontFamily="{DynamicResource Ui.Font}" FontSize="{DynamicResource Type.Body}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Prototype controls, not part of the approval card. -->
    <StackPanel Margin="24">
      <TextBlock x:Name="PageTitle" Style="{StaticResource Primer.PageTitle}" />
      <TextBlock x:Name="LanguageLabel" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Type.Caption}" Margin="0,24,0,8" />
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="LangZh" Content="中文" GroupName="Language" AutomationProperties.AutomationId="LangZh" Checked="OnLanguageChecked" Margin="0,0,16,0" />
        <RadioButton x:Name="LangEn" Content="English" GroupName="Language" AutomationProperties.AutomationId="LangEn" Checked="OnLanguageChecked" />
      </StackPanel>
      <TextBlock x:Name="ThemeLabel" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Type.Caption}" Margin="0,24,0,8" />
      <RadioButton x:Name="ThemeSystem" GroupName="Theme" AutomationProperties.AutomationId="ThemeSystem" Checked="OnThemeChecked" Margin="0,0,0,8" />
      <RadioButton x:Name="ThemeLight" GroupName="Theme" AutomationProperties.AutomationId="ThemeLight" Checked="OnThemeChecked" Margin="0,0,0,8" />
      <RadioButton x:Name="ThemeDark" GroupName="Theme" AutomationProperties.AutomationId="ThemeDark" Checked="OnThemeChecked" Margin="0,0,0,8" />
      <RadioButton x:Name="ThemeHighContrast" GroupName="Theme" AutomationProperties.AutomationId="ThemeHighContrast" Checked="OnThemeChecked" />
      <TextBlock x:Name="ResultText" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Type.Caption}" Margin="0,24,0,0" AutomationProperties.AutomationId="Result" />
      <StackPanel x:Name="FontCheckPanel" Visibility="Collapsed" Margin="0,16,0,0" />
    </StackPanel>

    <!-- The pending-approval drawer, as TIA's DrawerPanel (Primer.Drawer) at the approvals width (Drawer.Width 480). -->
    <Border Grid.Column="1" Width="{StaticResource Drawer.Width.Approvals}" Margin="0,8,8,8" Style="{StaticResource Primer.Drawer}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="56" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="24,0" Style="{StaticResource Primer.Divider}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- APR-02: focus goes to this heading when the card is shown, never to a button. Wraps: the English title does
                 not fit on one line in Maple Mono at 480 px (TIA trims it with an ellipsis). -->
            <TextBlock x:Name="TitleText" Focusable="True" FocusVisualStyle="{StaticResource Primer.Focus}" KeyboardNavigation.IsTabStop="False"
                       AutomationProperties.AutomationId="Title" AutomationProperties.HeadingLevel="Level1"
                       FontSize="{DynamicResource Ui.FontSize.Section}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="360"
                       TextWrapping="Wrap" TextTrimming="None" Margin="0,8" />
            <Border Style="{StaticResource Primer.PendingCountBadge}" Tag="1" Margin="12,0,0,0">
              <TextBlock Text="1" Style="{StaticResource Primer.CountText}" />
            </Border>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <!-- One item of TIA's ApprovalsDrawer list, with EplanMcp's fields. -->
          <Border Margin="24,16,24,24" Padding="0" Style="{StaticResource Primer.PendingRequest}">
            <StackPanel>
              <!-- 1. Head: client (unverified), transport chip, host and version, status chip. -->
              <Border Padding="12,0" MinHeight="40" Style="{StaticResource Primer.CardHead}">
                <DockPanel VerticalAlignment="Center">
                  <ContentControl DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}" Tag="{x:Static vm:FeatureTone.Warning}">
                    <TextBlock x:Name="StateText" Style="{StaticResource Primer.StatusText}" />
                  </ContentControl>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClientValue" FontWeight="SemiBold" AutomationProperties.AutomationId="Client" />
                    <TextBlock x:Name="UnverifiedText" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Type.Caption}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    <Border Padding="8,0" Margin="8,0" Style="{StaticResource Primer.Chip}">
                      <TextBlock x:Name="TransportText" Style="{StaticResource Primer.Mono}" FontSize="{DynamicResource Type.Code}" />
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="HostText" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Type.Caption}" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
              </Border>

              <StackPanel Margin="12">
                <!-- 2. Label and value rows. -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="72" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition MinHeight="24" />
                    <RowDefinition MinHeight="24" />
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="ProjectLabel" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0" />
                  <!-- Wraps instead of TIA's ellipsis: the card must show the full path (M5 design 4.6). -->
                  <TextBlock x:Name="ProjectValue" Grid.Column="1" Style="{StaticResource Primer.Mono.text}" FontSize="{DynamicResource Type.Code}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.AutomationId="Project" />
                  <TextBlock x:Name="InstanceLabel" Grid.Row="1" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0" />
                  <TextBlock x:Name="InstanceValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource Primer.Text}" FontSize="{DynamicResource Type.Caption}" AutomationProperties.AutomationId="Instance" />
                </Grid>

                <!-- 3. Inset, scrollable operations: action / object / tool. Object text comes from the project, cleaned. -->
                <Border Padding="12,0" Style="{StaticResource Primer.InputSurface}">
                  <ScrollViewer MaxHeight="216" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Operations" AutomationProperties.AutomationId="Changes">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid MinHeight="{StaticResource List.RowHeight}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Action}" FontSize="{DynamicResource Type.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Primer.Text.warn}" />
                            <!-- Wraps instead of TIA's ellipsis: in Maple Mono a 480 px drawer leaves room for about 14 Chinese characters. -->
                            <TextBlock Grid.Column="1" Text="{Binding Object}" FontSize="{DynamicResource Type.Caption}" VerticalAlignment="Center" Margin="0,4,8,4" TextWrapping="Wrap" TextTrimming="None" />
                            <TextBlock Grid.Column="2" Text="{Binding Tool}" Style="{StaticResource Primer.Mono.textFaint}" FontSize="{DynamicResource Type.Code}" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                <TextBlock x:Name="ChangesSource" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Type.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <!-- 4. Risk badges as text, request metadata on the right. -->
                <DockPanel Margin="0,12,0,0">
                  <TextBlock x:Name="MetadataText" DockPanel.Dock="Right" Style="{StaticResource Primer.Mono.textFaint}" FontSize="{DynamicResource Type.Code}" Margin="4,0,0,0" />
                  <ItemsControl x:Name="Risks">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="8,4" Margin="0,0,4,4" Style="{StaticResource Primer.WarningBadge}">
                          <TextBlock Text="{Binding}" FontSize="{DynamicResource Type.Caption}" FontWeight="SemiBold" Style="{StaticResource Primer.Text.warn}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>

                <!-- 5. Countdown in the mono style on the right, progress bar under it (APR-06). -->
                <StackPanel Margin="0,8,0,0">
                  <DockPanel>
                    <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" Style="{StaticResource Primer.ToneText}" Tag="{x:Static vm:FeatureTone.Normal}"
                               FontFamily="{DynamicResource Ui.FontMono}" FontSize="{DynamicResource Type.Code}" AutomationProperties.AutomationId="Countdown" />
                    <TextBlock x:Name="AutoRejectText" Style="{StaticResource Primer.Muted}" />
                  </DockPanel>
                  <ProgressBar x:Name="CountdownBar" Style="{StaticResource Primer.Progress}" Maximum="100" Margin="0,8,0,12" AutomationProperties.AutomationId="CountdownBar" />
                </StackPanel>

                <!-- 6. Right-aligned: a quiet link for the parameters, then Reject and Approve, same size and same default
                     style (ADR-0014: no accent Run style on Approve), neither default, no access key. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.IsSharedSizeScope="True">
                  <Button x:Name="ParametersButton" Style="{StaticResource Primer.Link}" Click="OnParameters" AutomationProperties.AutomationId="Parameters" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="Answer" />
                      <ColumnDefinition SharedSizeGroup="Answer" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RejectButton" Style="{StaticResource Primer.Secondary}" IsDefault="False" IsCancel="False" Margin="8,0,0,0" AutomationProperties.AutomationId="Reject" Click="OnAnswer" />
                    <Button x:Name="ApproveButton" Grid.Column="1" Style="{StaticResource Primer.Secondary}" IsDefault="False" IsCancel="False" Margin="8,0,0,0" AutomationProperties.AutomationId="Approve" Click="OnAnswer" />
                  </Grid>
                </StackPanel>

                <Border x:Name="ParametersBlock" Padding="12" Margin="0,12,0,0" Visibility="Collapsed" Style="{StaticResource Primer.CodeBlock}">
                  <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ParametersText" Style="{StaticResource Primer.CodeText}" AutomationProperties.AutomationId="ParametersJson" />
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
