<Window
    x:Class="EplanMcp.Spikes.S18.WpfFluent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="820" Height="920">
  <!-- Same layout as prototype A: 8 px grid, 32 px page margin, 24 px card padding, Caption 12 / Body 14 / Subtitle 20. -->
  <Grid x:Name="Root" Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Prototype controls, not part of the approval card. -->
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="LanguageLabel" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <RadioButton x:Name="LangZh" Content="中文" GroupName="Language" AutomationProperties.AutomationId="LangZh" Checked="OnLanguageChecked" Margin="0,0,8,0" />
      <RadioButton x:Name="LangEn" Content="English" GroupName="Language" AutomationProperties.AutomationId="LangEn" Checked="OnLanguageChecked" Margin="0,0,32,0" />
      <TextBlock x:Name="ThemeLabel" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <RadioButton x:Name="ThemeSystem" GroupName="Theme" AutomationProperties.AutomationId="ThemeSystem" Checked="OnThemeChecked" Margin="0,0,8,0" />
      <RadioButton x:Name="ThemeLight" GroupName="Theme" AutomationProperties.AutomationId="ThemeLight" Checked="OnThemeChecked" Margin="0,0,8,0" />
      <RadioButton x:Name="ThemeDark" GroupName="Theme" AutomationProperties.AutomationId="ThemeDark" Checked="OnThemeChecked" />
    </StackPanel>

    <Border x:Name="Card" Grid.Row="2" Padding="24" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="*" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- WPF lets a TextBlock take keyboard focus directly. -->
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True"
                   AutomationProperties.AutomationId="Title" AutomationProperties.HeadingLevel="Level1" />

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="ToolLabel" FontSize="12" Margin="0,0,0,8" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="ToolValue" Grid.Column="2" FontSize="14" Margin="0,0,0,8" AutomationProperties.AutomationId="Tool" />
          <TextBlock x:Name="TierLabel" Grid.Row="1" FontSize="12" Margin="0,0,0,8" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="TierValue" Grid.Row="1" Grid.Column="2" FontSize="14" Margin="0,0,0,8" AutomationProperties.AutomationId="Tier" />
          <TextBlock x:Name="ProjectLabel" Grid.Row="2" FontSize="12" Margin="0,0,0,8" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="ProjectValue" Grid.Row="2" Grid.Column="2" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="Project" />
          <TextBlock x:Name="InstanceLabel" Grid.Row="3" FontSize="12" Margin="0,0,0,8" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="InstanceValue" Grid.Row="3" Grid.Column="2" FontSize="14" Margin="0,0,0,8" AutomationProperties.AutomationId="Instance" />
          <TextBlock x:Name="ClientLabel" Grid.Row="4" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="ClientValue" Grid.Row="4" Grid.Column="2" FontSize="14" AutomationProperties.AutomationId="Client" />
        </Grid>

        <Grid Grid.Row="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="ChangesLabel" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="ChangesSource" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Border Grid.Row="2" Padding="16,8" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="ChangesText" FontSize="12" LineHeight="20" AutomationProperties.AutomationId="Changes" />
            </ScrollViewer>
          </Border>
        </Grid>

        <TextBlock x:Name="UndoText" Grid.Row="6" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="8">
          <TextBlock x:Name="CountdownText" FontSize="14" Margin="0,0,0,8" AutomationProperties.AutomationId="Countdown" />
          <ProgressBar x:Name="CountdownBar" Maximum="100" AutomationProperties.AutomationId="CountdownBar" />
        </StackPanel>

        <!-- Same size, same default style, IsDefault and IsCancel false, no access key ("_" not used). -->
        <Grid Grid.Row="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="ApproveButton" HorizontalAlignment="Stretch" IsDefault="False" IsCancel="False" AutomationProperties.AutomationId="Approve" Click="OnAnswer" />
          <Button x:Name="RejectButton" Grid.Column="2" HorizontalAlignment="Stretch" IsDefault="False" IsCancel="False" AutomationProperties.AutomationId="Reject" Click="OnAnswer" />
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <TextBlock x:Name="ResultText" FontSize="12" AutomationProperties.AutomationId="Result" />
      <StackPanel x:Name="FontCheckPanel" Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Window>
