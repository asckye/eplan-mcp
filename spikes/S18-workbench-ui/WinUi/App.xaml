<Application
    x:Class="EplanMcp.Spikes.S18.WinUi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- WinUI's own Fluent 2 control styles and theme resources (Default, Light, HighContrast). -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!--
        Lightweight styling only (owner, 2026-10-20: a calm look on native controls). No control is re-templated.
        The accent colour is kept for selection; the countdown bar is neutral. Every override has a HighContrast entry
        that points back to a system colour; a missing HighContrast entry would fall back to "Default".
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <StaticResource x:Key="ProgressBarForeground" ResourceKey="ControlStrongFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="ProgressBarForeground" ResourceKey="ControlStrongFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <StaticResource x:Key="ProgressBarForeground" ResourceKey="SystemColorHighlightColorBrush" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
