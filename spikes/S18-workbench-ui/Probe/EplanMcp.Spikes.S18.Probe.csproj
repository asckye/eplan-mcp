<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Spike S18 probe: starts a prototype, measures the time to its first visible window, reads its UI Automation tree
    (System.Windows.Automation, part of the WPF framework), switches language and theme through UIA, takes window
    screenshots and checks the tray icon, single instance and the 500 ms guard. Output goes to the given folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EplanMcp.Spikes.S18.Probe</RootNamespace>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>
</Project>
