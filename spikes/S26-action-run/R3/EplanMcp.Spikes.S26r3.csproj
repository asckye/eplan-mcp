<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>EplanMcp.Spikes.S26r3</AssemblyName>
    <RootNamespace>EplanMcp.Spikes.S26</RootNamespace>
    <DefineConstants>$(DefineConstants);S26_R2;S26_R3</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Spike*.cs;..\R2\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
    <Reference Include="Eplan.EplApi.AFu;Eplan.EplApi.Baseu;Eplan.EplApi.DataModelu;Eplan.EplApi.HEServicesu;Eplan.EplApi.MasterDatau;Newtonsoft.Json">
      <HintPath>$(EplanBinPath)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WindowsBase" />
  </ItemGroup>
</Project>
