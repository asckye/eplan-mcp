<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Spike S19, baseline: the smallest stdio MCP server with the Host's packages (ModelContextProtocol,
    Microsoft.Extensions.Hosting) and one tool. Published like the Host (self-contained single file, win-x64) and
    compared with the HTTP prototype in ../Http. See ../README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>S19.Stdio</AssemblyName>
    <RootNamespace>EplanMcp.Spikes.S19.Stdio</RootNamespace>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- Always win-x64, so a plain build restores the same graph (and lock file) as run.ps1's self-contained publish. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
