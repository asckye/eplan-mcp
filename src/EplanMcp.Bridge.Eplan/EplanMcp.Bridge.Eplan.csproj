<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The EPLAN add-in: entry point, main-thread dispatcher and adapter layer (net481, ADR-0004). Builds only where
    EPLAN is installed, because it compiles against the EPLAN API assemblies; CI builds EplanMcp.Ci.slnf without it.
    Only the Adapters namespace may use Eplan.EplApi.* (coding standards 9.1).
  -->
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>EplanMcp.Bridge.Eplan</RootNamespace>
    <Version>0.1.0</Version>
    <!--
      The EPLAN version (year) this add-in is built for, and the Bin folder of an installation of that version.
      ValidateEplanApiReferences below fails the build when the two disagree; there is no fallback to another
      installation. Another installation: -p:EplanBinPath=<its Bin folder>, plus -p:EplanVersion=<year> if not 2026.
    -->
    <EplanVersion Condition="'$(EplanVersion)' == ''">2026</EplanVersion>
    <EplanBinPath Condition="'$(EplanBinPath)' == ''">C:\Program Files\EPLAN\Platform\2026.0.3\Bin</EplanBinPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EplanMcp.Bridge.Core\EplanMcp.Bridge.Core.csproj" />
    <!-- Compile-time only; EPLAN's own Newtonsoft.Json 13 is used at run time (coding standards 9.7). -->
    <PackageReference Include="Newtonsoft.Json" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Rejects EPLAN members that write while looking like reads (BannedSymbols.txt, RS0030 is an error). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
    <!-- The offline host composes the same Bridge through BridgeHost (M5 design 4.9). -->
    <InternalsVisibleTo Include="EplanMcp.Bridge.Offline" />
  </ItemGroup>

  <!-- EPLAN assemblies come from the local installation and are never copied or shipped (Private=false). -->
  <ItemGroup>
    <Reference Include="Eplan.EplApi.AFu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.AFu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Baseu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.Baseu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.DataModelu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.DataModelu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Project messages (check results) for the M2 read tools; their writing members are banned. -->
    <Reference Include="Eplan.EplApi.EServicesu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.EServicesu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.HEServicesu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.HEServicesu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The parts database, read only for eplan_part_search (api-notes A27); its writing members are banned. -->
    <Reference Include="Eplan.EplApi.MasterDatau">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.MasterDatau.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WPF Dispatcher: EPLAN's main-thread dispatcher, the only one with an Invoke timeout (spike S1). -->
    <Reference Include="WindowsBase" />
    <!-- WPF window of the approval dialog (M3 design 4.3); part of .NET Framework, nothing is shipped. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!--
    Reads the file versions of the given files from their version resources. The EPLAN assemblies are never loaded
    into the build process; MSBuild property functions cannot read file versions, hence the inline task.
  -->
  <UsingTask TaskName="GetEplanApiFileVersions" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Result ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        Result = Files.Select(file =>
        {
            var info = System.Diagnostics.FileVersionInfo.GetVersionInfo(file.GetMetadata("FullPath"));
            var item = new TaskItem(file);
            item.SetMetadata("FileMajorPart", info.FileMajorPart.ToString(System.Globalization.CultureInfo.InvariantCulture));
            item.SetMetadata("FileVersion", string.Join(".", info.FileMajorPart, info.FileMinorPart, info.FileBuildPart, info.FilePrivatePart));
            return (ITaskItem)item;
        }).ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Build-time identity check (coding standards 9.1): every Eplan.EplApi.* reference must come from EPLAN
    $(EplanVersion). Their assembly version is always 1.0.0.0 (api-notes B1), so the major part of the file version
    (2026 in 2026.0.3.25421) is compared instead.
  -->
  <Target Name="ValidateEplanApiReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_EplanApiReference Include="@(Reference->'%(HintPath)')" Condition="$([System.String]::Copy('%(Identity)').StartsWith('Eplan.EplApi.'))" />
    </ItemGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(EplanVersion)', '^\d{4}$'))" Text="EplanVersion must be the EPLAN version year, for example 2026, but is '$(EplanVersion)'." />
    <Error Condition="!Exists('$(EplanBinPath)')" Text="EPLAN Bin folder not found: '$(EplanBinPath)'. Install EPLAN $(EplanVersion), or pass -p:EplanBinPath=&lt;Bin folder of an EPLAN $(EplanVersion) installation&gt;." />
    <Error Condition="!Exists('%(_EplanApiReference.FullPath)')" Text="EPLAN API assembly not found: '%(_EplanApiReference.FullPath)'. EplanBinPath must be the Bin folder of an EPLAN $(EplanVersion) installation; it is '$(EplanBinPath)'." />
    <GetEplanApiFileVersions Files="@(_EplanApiReference)" Condition="'@(_EplanApiReference)' != ''">
      <Output TaskParameter="Result" ItemName="_EplanApiFileVersion" />
    </GetEplanApiFileVersions>
    <Error Condition="'%(_EplanApiFileVersion.FileMajorPart)' != '$(EplanVersion)'" Text="'%(_EplanApiFileVersion.FullPath)' has file version %(_EplanApiFileVersion.FileVersion), so it is from EPLAN %(_EplanApiFileVersion.FileMajorPart), but this add-in is built for EPLAN $(EplanVersion) (EplanVersion). Pass -p:EplanBinPath=&lt;Bin folder of an EPLAN $(EplanVersion) installation&gt;, or -p:EplanVersion=%(_EplanApiFileVersion.FileMajorPart) if EPLAN %(_EplanApiFileVersion.FileMajorPart) is the intended target." />
  </Target>
</Project>
