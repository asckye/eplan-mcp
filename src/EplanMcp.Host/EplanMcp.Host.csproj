<Project Sdk="Microsoft.NET.Sdk">
  <!-- eplanmcp.exe: the MCP server the client starts over stdio, plus CLI subcommands (architecture 5.2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>eplanmcp</AssemblyName>
    <RootNamespace>EplanMcp.Host</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EplanMcp.Contracts\EplanMcp.Contracts.csproj" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Detailed usage per tool, served by eplan_tool_usage (mcp-tool-design 10); the file name is the tool name. -->
    <EmbeddedResource Include="Tools\Usage\*.md" LogicalName="EplanMcp.Host.Tools.Usage.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EplanMcp.Host.Tests" />
    <!-- Windows x64 only (architecture section 2); lets the platform analyzer accept registry and Win32 calls. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
