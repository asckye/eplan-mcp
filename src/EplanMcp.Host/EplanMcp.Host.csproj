<Project Sdk="Microsoft.NET.Sdk">
  <!-- eplanmcp.exe: the MCP server the client starts over stdio, plus CLI subcommands (architecture 5.2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>eplanmcp</AssemblyName>
    <RootNamespace>EplanMcp.Host</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EplanMcp.Contracts\EplanMcp.Contracts.csproj" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EplanMcp.Host.Tests" />
  </ItemGroup>
</Project>
