<Project Sdk="Microsoft.NET.Sdk">
  <!-- eplanmcp.exe: the MCP server the client starts over stdio, plus CLI subcommands (architecture 5.2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>eplanmcp</AssemblyName>
    <RootNamespace>EplanMcp.Host</RootNamespace>
    <Version>0.5.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EplanMcp.Contracts\EplanMcp.Contracts.csproj" />
    <ProjectReference Include="..\EplanMcp.Packs\EplanMcp.Packs.csproj" />
    <ProjectReference Include="..\..\eng\plugin-libraries\PluginLibraries.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishProfileFullPath;PublishDir;OutputPath;NuGetLockFilePath" />
    <ProjectReference Include="..\EplanMcp.Workbench.Protocol\EplanMcp.Workbench.Protocol.csproj" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Detailed usage per tool, served by eplan_tool_usage (engineering-handbook.html#pa); the file name is the tool name. -->
    <EmbeddedResource Include="Tools\Usage\*.md" LogicalName="EplanMcp.Host.Tools.Usage.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Tools\PlacementCreate.usage.md" LogicalName="EplanMcp.Host.Tools.Usage.eplan_placement_create.md" />
    <EmbeddedResource Include="Tools\PlacementUpdate.usage.md" LogicalName="EplanMcp.Host.Tools.Usage.eplan_placement_update.md" />
    <EmbeddedResource Include="Tools\ActionRun.output.json" />
    <EmbeddedResource Include="Tools\ApiIndex.g.base64" LogicalName="EplanMcp.ApiIndex" />
    <EmbeddedResource Include="..\..\catalog\eplan-2026.0.3\actions.json" LogicalName="EplanMcp.Actions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EplanMcp.Host.Tests" />
    <InternalsVisibleTo Include="EplanMcp.Coverage.Tests" />
    <!-- Large test Q6 calls the Bridge's plan and execute operations itself, with the Host's BridgeClient. -->
    <InternalsVisibleTo Include="EplanMcp.Large.Tests" />
    <!-- The Workbench's Medium tests run this WorkbenchChannel against the real Workbench pipe server (M5 design 7). -->
    <InternalsVisibleTo Include="EplanMcp.Workbench.Tests" />
    <!-- Windows x64 only (architecture section 2); lets the platform analyzer accept registry and Win32 calls. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="BuildBuiltinPluginLibrary" BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" DependsOnTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)..\..\eng\plugin-libraries\bin\$(Configuration)\net10.0\PluginLibraries.dll&quot; &quot;$(MSBuildThisFileDirectory)..\..\packaging\plugin-libraries\builtin&quot; &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)plugin-libraries\builtin&quot;" />
    <ItemGroup>
      <_BuiltinPluginFiles Include="$(IntermediateOutputPath)plugin-libraries\builtin\*.eplanpack;$(IntermediateOutputPath)plugin-libraries\builtin\library.json" />
      <ContentWithTargetPath Include="@(_BuiltinPluginFiles)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true">
        <TargetPath>plugin-libraries\builtin\%(_BuiltinPluginFiles.Filename)%(_BuiltinPluginFiles.Extension)</TargetPath>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
