<Application
    x:Class="EplanMcp.Workbench.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- TIA's layout: ThemeManager swaps slot 0, the palette, to change the theme without a restart (COL-09). -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Palette.Light.xaml" />
        <ResourceDictionary Source="Themes/Icons.xaml" />
        <ResourceDictionary Source="Themes/Primer.xaml" />
        <ResourceDictionary Source="Shell/Workbench.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
