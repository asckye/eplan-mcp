<UserControl
    x:Class="EplanMcp.Workbench.Settings.SettingsDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes"
    Focusable="False">
  <!--
    The settings drawer (workbench-ui 3.1: 400 epx from the right; DLG-10: a modal pane, Tab stays inside, Esc closes):
    language, theme and start at login, which apply at once (LOC-08, COL-09, CMD-08), and config.json read only, with a
    way to open it in its own program (NAV-10). Nothing here changes approvals (APR-16) or the Host's settings.
  -->
  <Border Width="400" Margin="0,8,8,8" HorizontalAlignment="Right" Style="{StaticResource Primer.Drawer}"
          AutomationProperties.IsDialog="True" AutomationProperties.Name="{l:Tr Settings.Title}"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
    <DockPanel>
      <Border DockPanel.Dock="Top" Padding="24,12,16,12" Style="{StaticResource Primer.Divider}">
        <DockPanel>
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Primer.WindowButton}" Click="OnClose"
                  AutomationProperties.Name="{l:Tr Settings.Close}" ToolTip="{l:Tr Settings.Close}">
            <Path Style="{StaticResource Workbench.CaptionGlyph}" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
          </Button>
          <TextBlock x:Name="Heading" Text="{l:Tr Settings.Title}" Style="{StaticResource Primer.ContainerTitle}" AutomationProperties.HeadingLevel="Level1"
                     Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="24">
        <TextBlock x:Name="LanguageLabel" Text="{l:Tr Settings.Language}" Style="{StaticResource Primer.SectionLabel}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"
                    AutomationProperties.Name="{l:Tr Settings.Language}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
          <RadioButton GroupName="Language" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.Chinese}" AutomationProperties.Name="{l:Tr Settings.Chinese}"
                       IsChecked="{Binding IsChinese, Source={x:Static l:Loc.Current}}" />
          <RadioButton GroupName="Language" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.English}" AutomationProperties.Name="{l:Tr Settings.English}"
                       IsChecked="{Binding IsEnglish, Source={x:Static l:Loc.Current}}" />
        </StackPanel>
        <TextBlock x:Name="ThemeLabel" Text="{l:Tr Settings.Theme}" Style="{StaticResource Primer.SectionLabel}" Margin="0,24,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"
                    AutomationProperties.Name="{l:Tr Settings.Theme}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
          <RadioButton GroupName="Theme" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.ThemeSystem}" AutomationProperties.Name="{l:Tr Settings.ThemeSystem}"
                       IsChecked="{Binding IsAuto, Source={x:Static themes:ThemeManager.Current}}" />
          <RadioButton GroupName="Theme" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.ThemeLight}" AutomationProperties.Name="{l:Tr Settings.ThemeLight}"
                       IsChecked="{Binding IsLight, Source={x:Static themes:ThemeManager.Current}}" />
          <RadioButton GroupName="Theme" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.ThemeDark}" AutomationProperties.Name="{l:Tr Settings.ThemeDark}"
                       IsChecked="{Binding IsDark, Source={x:Static themes:ThemeManager.Current}}" />
        </StackPanel>
        <TextBlock Text="{l:Tr Settings.HighContrast}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" />

        <TextBlock x:Name="LoginLabel" Text="{l:Tr Settings.Login}" Style="{StaticResource Primer.SectionLabel}" Margin="0,24,0,0" />
        <ToggleButton x:Name="LoginSwitch" Style="{StaticResource Primer.Switch}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="{l:Tr Settings.LoginSwitch}"
                      AutomationProperties.Name="{l:Tr Settings.LoginSwitch}" Checked="OnLogin" Unchecked="OnLogin" />
        <TextBlock x:Name="LoginError" Text="{l:Tr Settings.LoginFailed}" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" TextTrimming="None"
                   Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />

        <TextBlock x:Name="ConfigLabel" Text="{l:Tr Settings.Config}" Style="{StaticResource Primer.SectionLabel}" Margin="0,24,0,0" />
        <TextBlock x:Name="ConfigPath" Style="{StaticResource Primer.Mono.textMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" />
        <TextBox x:Name="ConfigText" Style="{StaticResource Workbench.ProjectData}" MaxHeight="240" Margin="0,8,0,0" AutomationProperties.LabeledBy="{Binding ElementName=ConfigLabel}" />
        <Button x:Name="ConfigButton" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Settings.OpenConfig}" Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnOpenConfig" />
        <TextBlock x:Name="ConfigProblem" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
