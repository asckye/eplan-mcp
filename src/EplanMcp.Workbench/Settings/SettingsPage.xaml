<UserControl
    x:Class="EplanMcp.Workbench.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes"
    xmlns:localThemes="clr-namespace:EplanMcp.Workbench.Themes"
    Focusable="False">
  <!-- Dedicated Settings Page (TIA 236px Left Category Nav + 740px Right Column) -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LeftCol" Width="236" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="LeftPane" Style="{StaticResource Workbench.LeftPane}">
      <StackPanel Margin="{StaticResource Ui.Inset.SettingsNav}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
        <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Settings}" Style="{StaticResource Workbench.SiderSection}" Margin="{StaticResource Ui.Gap.SettingsNavLabel}"
                   AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
        <RadioButton x:Name="NavSafety" GroupName="SettingsNav" Style="{StaticResource Workbench.NavItem}" Content="{l:Tr Settings.NavSafety}" IsChecked="True" Checked="OnCategoryChanged" />
        <RadioButton x:Name="NavAppearance" GroupName="SettingsNav" Style="{StaticResource Workbench.NavItem}" Content="{l:Tr Settings.NavAppearance}" Checked="OnCategoryChanged" />
        <RadioButton x:Name="NavStorage" GroupName="SettingsNav" Style="{StaticResource Workbench.NavItem}" Content="{l:Tr Settings.NavStorage}" Checked="OnCategoryChanged" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Ui.Inset.PageWide}" MaxWidth="740">
        <!-- 1. Safety & Approvals -->
        <StackPanel x:Name="SafetySection">
          <TextBlock Text="{l:Tr Settings.NavSafety}" Style="{StaticResource Primer.ContainerTitle}" Margin="{StaticResource Ui.Gap.Bottom.SM}" AutomationProperties.HeadingLevel="Level1" />

          <Border Style="{StaticResource Workbench.Card}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
            <StackPanel>
              <TextBlock Text="{l:Tr Settings.ApprovalTitle}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" />
              <TextBlock Text="{l:Tr Settings.ApprovalDesc}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="{StaticResource Ui.Gap.Top.XXS}" />
              <ToggleButton x:Name="ApprovalSwitch" Style="{StaticResource Primer.Switch}" HorizontalAlignment="Left" Margin="{StaticResource Ui.Gap.Top.SM}"
                            Content="{l:Tr Settings.ApprovalSwitch}" AutomationProperties.Name="{l:Tr Settings.ApprovalSwitch}"
                            Checked="OnApprovalChanged" Unchecked="OnApprovalChanged" />
              <TextBlock x:Name="PolicyError" Text="{l:Tr Settings.SaveFailed}" Style="{StaticResource Primer.Text.warn}" TextWrapping="Wrap"
                         Margin="{StaticResource Ui.Gap.Top.XS}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

              <Border Margin="{StaticResource Ui.Gap.Top.Normal}" Padding="{StaticResource Ui.Inset.SectionTopSM}" BorderBrush="{DynamicResource Border.Layer}" BorderThickness="0,1,0,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="Timeout60" GroupName="ApprovalTimeout" Style="{StaticResource Workbench.IdePill}" Content="{l:Tr Settings.Timeout60}" Tag="60" Checked="OnTimeoutChanged" Margin="{StaticResource Ui.Gap.Right.XXS}" />
                    <RadioButton x:Name="Timeout120" GroupName="ApprovalTimeout" Style="{StaticResource Workbench.IdePill}" Content="{l:Tr Settings.Timeout120}" Tag="120" Checked="OnTimeoutChanged" Margin="{StaticResource Ui.Gap.Right.XXS}" />
                    <RadioButton x:Name="Timeout300" GroupName="ApprovalTimeout" Style="{StaticResource Workbench.IdePill}" Content="{l:Tr Settings.Timeout300}" Tag="300" Checked="OnTimeoutChanged" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{l:Tr Settings.TimeoutLabel}" Style="{StaticResource Ui.Text.BodyStrong}" />
                    <TextBlock Text="{l:Tr Settings.TimeoutHelp}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Workbench.Card}">
            <StackPanel>
              <TextBlock x:Name="LoginLabel" Text="{l:Tr Settings.Login}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" />
              <ToggleButton x:Name="LoginSwitch" Style="{StaticResource Primer.Switch}" Margin="{StaticResource Ui.Gap.Top.XS}" HorizontalAlignment="Left" Content="{l:Tr Settings.LoginSwitch}"
                            AutomationProperties.Name="{l:Tr Settings.LoginSwitch}" Checked="OnLogin" Unchecked="OnLogin" />
              <TextBlock x:Name="LoginError" Text="{l:Tr Settings.LoginFailed}" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" TextTrimming="None"
                         Margin="{StaticResource Ui.Gap.Top.XS}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 2. Appearance & Language (Light / Dark only + Dual Brand Accent Cobalt / Petrol) -->
        <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
          <TextBlock Text="{l:Tr Settings.NavAppearance}" Style="{StaticResource Primer.ContainerTitle}" Margin="{StaticResource Ui.Gap.Bottom.SM}" AutomationProperties.HeadingLevel="Level1" />

          <Border Style="{StaticResource Workbench.Card}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
            <StackPanel>
              <TextBlock x:Name="ThemeLabel" Text="{l:Tr Settings.Theme}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" />
              <StackPanel Orientation="Horizontal" Margin="{StaticResource Ui.Gap.Top.SM}" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"
                          AutomationProperties.Name="{l:Tr Settings.Theme}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="ThemeLightRadio" GroupName="Theme" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.ThemeLight}" AutomationProperties.Name="{l:Tr Settings.ThemeLight}"
                             IsChecked="{Binding IsLight, Source={x:Static themes:ThemeManager.Current}}" />
                <RadioButton x:Name="ThemeDarkRadio" GroupName="Theme" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.ThemeDark}" AutomationProperties.Name="{l:Tr Settings.ThemeDark}"
                             IsChecked="{Binding IsDark, Source={x:Static themes:ThemeManager.Current}}" />
              </StackPanel>
              <TextBlock Text="{l:Tr Settings.HighContrast}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="{StaticResource Ui.Gap.Top.XS}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Workbench.Card}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
            <StackPanel>
              <TextBlock x:Name="AccentLabel" Text="{l:Tr Settings.AccentLabel}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" />
              <StackPanel Orientation="Horizontal" Margin="{StaticResource Ui.Gap.Top.SM}" AutomationProperties.LabeledBy="{Binding ElementName=AccentLabel}"
                          AutomationProperties.Name="{l:Tr Settings.AccentLabel}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="AccentCobaltRadio" GroupName="BrandAccent" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.AccentCobalt}" AutomationProperties.Name="{l:Tr Settings.AccentCobalt}"
                             IsChecked="{Binding IsCobalt, Source={x:Static localThemes:AccentManager.Current}}" />
                <RadioButton x:Name="AccentPetrolRadio" GroupName="BrandAccent" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.AccentPetrol}" AutomationProperties.Name="{l:Tr Settings.AccentPetrol}"
                             IsChecked="{Binding IsPetrol, Source={x:Static localThemes:AccentManager.Current}}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Workbench.Card}">
            <StackPanel>
              <TextBlock x:Name="LanguageLabel" Text="{l:Tr Settings.Language}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" />
              <StackPanel Orientation="Horizontal" Margin="{StaticResource Ui.Gap.Top.SM}" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"
                          AutomationProperties.Name="{l:Tr Settings.Language}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton GroupName="Language" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.Chinese}" AutomationProperties.Name="{l:Tr Settings.Chinese}"
                             IsChecked="{Binding IsChinese, Source={x:Static l:Loc.Current}}" />
                <RadioButton GroupName="Language" Style="{StaticResource Primer.Segment}" Content="{l:Tr Settings.English}" AutomationProperties.Name="{l:Tr Settings.English}"
                             IsChecked="{Binding IsEnglish, Source={x:Static l:Loc.Current}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 3. Storage & About -->
        <StackPanel x:Name="StorageSection" Visibility="Collapsed">
          <TextBlock Text="{l:Tr Settings.NavStorage}" Style="{StaticResource Primer.ContainerTitle}" Margin="{StaticResource Ui.Gap.Bottom.SM}" AutomationProperties.HeadingLevel="Level1" />

          <Border Style="{StaticResource Workbench.Card}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
            <StackPanel>
              <TextBlock Text="{l:Tr Settings.StorageDirs}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
              <DockPanel Margin="{StaticResource Ui.Inset.Vertical.XXS}">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Settings.OpenDir}" Click="OnOpenRoot" />
                <StackPanel>
                  <TextBlock Text="{l:Tr Settings.DirRoot}" Style="{StaticResource Ui.Text.BodyStrong}" />
                  <TextBlock x:Name="DirRootPath" Style="{StaticResource Primer.Mono.textMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="{StaticResource Ui.Inset.Vertical.XXS}">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Settings.OpenDir}" Click="OnOpenAudit" />
                <StackPanel>
                  <TextBlock Text="{l:Tr Settings.DirAudit}" Style="{StaticResource Ui.Text.BodyStrong}" />
                  <TextBlock x:Name="DirAuditPath" Style="{StaticResource Primer.Mono.textMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="{StaticResource Ui.Inset.Vertical.XXS}">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Settings.OpenDir}" Click="OnOpenLogs" />
                <StackPanel>
                  <TextBlock Text="{l:Tr Settings.DirLogs}" Style="{StaticResource Ui.Text.BodyStrong}" />
                  <TextBlock x:Name="DirLogsPath" Style="{StaticResource Primer.Mono.textMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Workbench.Card}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
            <StackPanel>
              <TextBlock x:Name="ConfigLabel" Text="{l:Tr Settings.Config}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" />
              <TextBlock x:Name="ConfigPath" Style="{StaticResource Primer.Mono.textMuted}" TextWrapping="Wrap" Margin="{StaticResource Ui.Gap.Top.XXS}" />
              <TextBox x:Name="ConfigText" Style="{StaticResource Workbench.ProjectData}" MaxHeight="220" Margin="{StaticResource Ui.Gap.Top.XS}" AutomationProperties.LabeledBy="{Binding ElementName=ConfigLabel}" />
              <Button x:Name="ConfigButton" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Settings.OpenConfig}" Margin="{StaticResource Ui.Gap.Top.XS}" HorizontalAlignment="Left" Click="OnOpenConfig" />
              <TextBlock x:Name="ConfigProblem" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" Margin="{StaticResource Ui.Gap.Top.XS}"
                         Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Workbench.Card}">
            <StackPanel>
              <TextBlock Text="{l:Tr Settings.AboutTitle}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" />
              <TextBlock x:Name="VersionLine" Style="{StaticResource Primer.Mono.textMuted}" Margin="{StaticResource Ui.Gap.Top.XXS}" />
              <TextBlock Text="{l:Tr Settings.AboutLicense}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="{StaticResource Ui.Gap.Top.XS}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
