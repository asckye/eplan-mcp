<UserControl
    x:Class="EplanMcp.Workbench.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes"
    xmlns:localThemes="clr-namespace:EplanMcp.Workbench.Themes"
    Focusable="False">
  <!--
    Settings (Workbench 4.0 design): a 228 px pane with the three categories; on the right the category's bar (title and
    what it covers) and one column (max 740) of boxes whose rows carry the title and help on the left, the control on
    the right.
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LeftCol" Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="LeftPane" Style="{StaticResource Workbench.LeftPane}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.PaneHeader}">
          <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Settings}" Style="{StaticResource Workbench.PaneHeaderText}"
                     AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
        </Border>
        <StackPanel Margin="{StaticResource Ui.Inset.SettingsNav}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
          <RadioButton x:Name="NavSafety" GroupName="SettingsNav" Style="{StaticResource Workbench.NavRow}" Content="{l:Tr Settings.NavSafety}" IsChecked="True" Checked="OnCategoryChanged" />
          <RadioButton x:Name="NavAppearance" GroupName="SettingsNav" Style="{StaticResource Workbench.NavRow}" Content="{l:Tr Settings.NavAppearance}" Checked="OnCategoryChanged" />
          <RadioButton x:Name="NavStorage" GroupName="SettingsNav" Style="{StaticResource Workbench.NavRow}" Content="{l:Tr Settings.NavStorage}" Checked="OnCategoryChanged" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="SectionTitle" Style="{StaticResource Workbench.BarTitle}" AutomationProperties.HeadingLevel="Level2" />
          <Border Style="{StaticResource Workbench.BarSeparator}" />
          <TextBlock x:Name="SectionSub" Style="{StaticResource Workbench.CellText}" Foreground="{DynamicResource Text.Tertiary}" />
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="{StaticResource Ui.Inset.DetailPage}" MaxWidth="740">
          <!-- 1. Safety and approvals -->
          <StackPanel x:Name="SafetySection">
            <Border Style="{StaticResource Workbench.Box}" Margin="{StaticResource Ui.Gap.Bottom.Normal}" ClipToBounds="True">
              <StackPanel>
                <Border Style="{StaticResource Workbench.SettingRow}">
                  <DockPanel>
                    <ToggleButton x:Name="ApprovalSwitch" DockPanel.Dock="Right" Style="{StaticResource Primer.Switch}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Normal}"
                                  AutomationProperties.Name="{l:Tr Settings.ApprovalSwitch}" Checked="OnApprovalChanged" Unchecked="OnApprovalChanged" />
                    <StackPanel>
                      <TextBlock Text="{l:Tr Settings.ApprovalTitle}" Style="{StaticResource Workbench.SettingTitle}" />
                      <TextBlock Text="{l:Tr Settings.ApprovalDesc}" Style="{StaticResource Workbench.SettingHelp}" />
                      <TextBlock x:Name="PolicyError" Text="{l:Tr Settings.SaveFailed}" Style="{StaticResource Primer.Text.warn}" TextWrapping="Wrap"
                                 Margin="{StaticResource Ui.Gap.Top.XXS}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Workbench.SettingRow}">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Workbench.Segment}" Margin="{StaticResource Ui.Gap.Left.Normal}">
                      <StackPanel Orientation="Horizontal" AutomationProperties.Name="{l:Tr Settings.TimeoutLabel}">
                        <RadioButton x:Name="Timeout60" GroupName="ApprovalTimeout" Style="{StaticResource Workbench.SegmentItemMono}" Content="{l:Tr Settings.Timeout60}" Tag="60" Checked="OnTimeoutChanged" />
                        <RadioButton x:Name="Timeout120" GroupName="ApprovalTimeout" Style="{StaticResource Workbench.SegmentItemMono}" Content="{l:Tr Settings.Timeout120}" Tag="120" Checked="OnTimeoutChanged" />
                        <RadioButton x:Name="Timeout300" GroupName="ApprovalTimeout" Style="{StaticResource Workbench.SegmentItemMono}" Content="{l:Tr Settings.Timeout300}" Tag="300" Checked="OnTimeoutChanged" />
                      </StackPanel>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="{l:Tr Settings.TimeoutLabel}" Style="{StaticResource Workbench.SettingTitle}" />
                      <TextBlock Text="{l:Tr Settings.TimeoutHelp}" Style="{StaticResource Workbench.SettingHelp}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Workbench.SettingRow}" BorderThickness="0">
                  <DockPanel>
                    <ToggleButton x:Name="LoginSwitch" DockPanel.Dock="Right" Style="{StaticResource Primer.Switch}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Normal}"
                                  AutomationProperties.Name="{l:Tr Settings.LoginSwitch}" Checked="OnLogin" Unchecked="OnLogin" />
                    <StackPanel>
                      <TextBlock x:Name="LoginLabel" Text="{l:Tr Settings.LoginSwitch}" Style="{StaticResource Workbench.SettingTitle}" />
                      <TextBlock Text="{l:Tr Settings.LoginHelp}" Style="{StaticResource Workbench.SettingHelp}" />
                      <TextBlock x:Name="LoginError" Text="{l:Tr Settings.LoginFailed}" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" TextTrimming="None"
                                 Margin="{StaticResource Ui.Gap.Top.XXS}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- The scratch roots as the file names them; changed in config.json, not here. -->
            <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.SettingsBox}">
              <StackPanel>
                <TextBlock x:Name="ScratchLabel" Text="{l:Tr Settings.ScratchRoots}" Style="{StaticResource Workbench.CheckTitle}" />
                <TextBlock Text="{l:Tr Settings.ScratchHelp}" Style="{StaticResource Workbench.SettingHelp}" />
                <ItemsControl x:Name="ScratchRoots" Focusable="False" Margin="{StaticResource Ui.Gap.Top.SM}" AutomationProperties.LabeledBy="{Binding ElementName=ScratchLabel}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Workbench.CcTag}" Margin="{StaticResource Ui.Gap.Wrap.XS}">
                        <TextBlock Text="{Binding}" FontFamily="{DynamicResource Ui.FontMono}" VerticalAlignment="Center" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 2. Appearance and language -->
          <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
            <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.SettingsBox}" Margin="{StaticResource Ui.Gap.Bottom.Normal}">
              <StackPanel>
                <TextBlock x:Name="ThemeLabel" Text="{l:Tr Settings.Theme}" Style="{StaticResource Workbench.CheckTitle}" />
                <UniformGrid Rows="1" Margin="{StaticResource Ui.Gap.Top.SM}" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"
                             AutomationProperties.Name="{l:Tr Settings.Theme}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                  <RadioButton x:Name="ThemeLightRadio" GroupName="Theme" Style="{StaticResource Workbench.CcTile}" AutomationProperties.Name="{l:Tr Settings.ThemeLight}" Margin="{StaticResource Ui.Gap.Right.XS}"
                               IsChecked="{Binding IsLight, Source={x:Static themes:ThemeManager.Current}}">
                    <StackPanel>
                      <TextBlock Text="{l:Tr Settings.ThemeLightName}" Style="{StaticResource Workbench.CheckTitle}" />
                      <TextBlock Text="{l:Tr Settings.ThemeLightHint}" Style="{StaticResource Workbench.SettingHelp}" />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="ThemeDarkRadio" GroupName="Theme" Style="{StaticResource Workbench.CcTile}" AutomationProperties.Name="{l:Tr Settings.ThemeDark}"
                               IsChecked="{Binding IsDark, Source={x:Static themes:ThemeManager.Current}}">
                    <StackPanel>
                      <TextBlock Text="{l:Tr Settings.ThemeDarkName}" Style="{StaticResource Workbench.CheckTitle}" />
                      <TextBlock Text="{l:Tr Settings.ThemeDarkHint}" Style="{StaticResource Workbench.SettingHelp}" />
                    </StackPanel>
                  </RadioButton>
                </UniformGrid>
                <Border BorderBrush="{DynamicResource Border.Layer}" BorderThickness="0,1,0,0" Padding="{StaticResource Ui.Inset.SettingsDivided}" Margin="{StaticResource Ui.Gap.Top.Normal}">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=AccentLabel}"
                                AutomationProperties.Name="{l:Tr Settings.AccentLabel}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                      <RadioButton x:Name="AccentCobaltRadio" GroupName="BrandAccent" Style="{StaticResource Workbench.IdePill}" AutomationProperties.Name="{l:Tr Settings.AccentCobalt}" Margin="{StaticResource Ui.Gap.Right.XS}"
                                   IsChecked="{Binding IsCobalt, Source={x:Static localThemes:AccentManager.Current}}">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Style="{StaticResource Workbench.StatusDot}" Fill="{DynamicResource Workbench.swatchCobalt}" />
                          <TextBlock Text="{l:Tr Settings.AccentCobalt}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Dot}" />
                        </StackPanel>
                      </RadioButton>
                      <RadioButton x:Name="AccentPetrolRadio" GroupName="BrandAccent" Style="{StaticResource Workbench.IdePill}" AutomationProperties.Name="{l:Tr Settings.AccentPetrol}"
                                   IsChecked="{Binding IsPetrol, Source={x:Static localThemes:AccentManager.Current}}">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Style="{StaticResource Workbench.StatusDot}" Fill="{DynamicResource Workbench.swatchPetrol}" />
                          <TextBlock Text="{l:Tr Settings.AccentPetrol}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Dot}" />
                        </StackPanel>
                      </RadioButton>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock x:Name="AccentLabel" Text="{l:Tr Settings.AccentLabel}" Style="{StaticResource Workbench.CheckTitle}" />
                      <TextBlock Text="{l:Tr Settings.AccentHelp}" Style="{StaticResource Workbench.SettingHelp}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.SettingsBoxRow}">
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Workbench.Segment}">
                  <StackPanel Orientation="Horizontal" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" AutomationProperties.Name="{l:Tr Settings.Language}">
                    <RadioButton GroupName="Language" Style="{StaticResource Workbench.SegmentItem}" Content="{l:Tr Settings.Chinese}" AutomationProperties.Name="{l:Tr Settings.Chinese}"
                                 IsChecked="{Binding IsChinese, Source={x:Static l:Loc.Current}}" />
                    <RadioButton GroupName="Language" Style="{StaticResource Workbench.SegmentItem}" Content="{l:Tr Settings.English}" AutomationProperties.Name="{l:Tr Settings.English}"
                                 IsChecked="{Binding IsEnglish, Source={x:Static l:Loc.Current}}" />
                  </StackPanel>
                </Border>
                <StackPanel>
                  <TextBlock x:Name="LanguageLabel" Text="{l:Tr Settings.Language}" Style="{StaticResource Workbench.CheckTitle}" />
                  <TextBlock Text="{l:Tr Settings.LanguageHelp}" Style="{StaticResource Workbench.SettingHelp}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- 3. Storage and about -->
          <StackPanel x:Name="StorageSection" Visibility="Collapsed">
            <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.SettingsBox}" Margin="{StaticResource Ui.Gap.Bottom.Normal}">
              <StackPanel>
              <DockPanel>
                <Button x:Name="ReleasesButton" DockPanel.Dock="Right" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Settings.Releases}" VerticalAlignment="Center" Click="OnReleases" />
                <!-- ADR-0066: the only time the Workbench goes online, and only on this click. -->
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource Primer.Primary}" Content="{l:Tr Settings.CheckUpdate}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Right.XS}"
                        AutomationProperties.HelpText="{l:Tr Settings.CheckUpdateHelp}" ToolTip="{l:Tr Settings.CheckUpdateHelp}" Click="OnCheckUpdate" />
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Accent.Button}" Margin="{StaticResource Ui.Gap.Right.SM}">
                  <Path Width="{StaticResource Ui.IconSize.Brand}" Height="{StaticResource Ui.IconSize.Brand}" Stretch="Uniform" Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M4,6 H20 M4,12 H14 M4,18 H20 M20.2,12 A2.2,2.2 0 1 1 15.8,12 A2.2,2.2 0 1 1 20.2,12" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:Tr Settings.AboutTitle}" Style="{StaticResource Workbench.CheckTitle}" FontSize="14.5" />
                  <TextBlock x:Name="VersionLine" Style="{StaticResource Workbench.CellMono}" Margin="{StaticResource Ui.Gap.Top.Hair}" />
                </StackPanel>
              </DockPanel>
              <Border x:Name="UpdateNewer" Style="{StaticResource Workbench.CodeBox}" Margin="{StaticResource Ui.Gap.Top.XS}" Visibility="Collapsed">
                <DockPanel>
                  <Button x:Name="OpenUpdate" DockPanel.Dock="Right" Style="{StaticResource Primer.Primary}" Content="{l:Tr Settings.OpenRelease}" VerticalAlignment="Center" Click="OnOpenUpdate" />
                  <TextBlock x:Name="UpdateNewerText" Style="{StaticResource Workbench.CellText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
              </Border>
              <TextBlock x:Name="UpdateText" Style="{StaticResource Workbench.SettingHelp}" Margin="{StaticResource Ui.Gap.Top.XS}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Workbench.Box}" Margin="{StaticResource Ui.Gap.Bottom.Normal}" ClipToBounds="True">
              <Border Style="{StaticResource Workbench.SettingRow}" BorderThickness="0">
                <DockPanel>
                  <Button x:Name="DiagButton" DockPanel.Dock="Right" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Settings.Diag}" VerticalAlignment="Center" Click="OnDiag" />
                  <StackPanel>
                    <TextBlock Text="{l:Tr Settings.DiagTitle}" Style="{StaticResource Workbench.SettingTitle}" />
                    <TextBlock Text="{l:Tr Settings.DiagHelp}" Style="{StaticResource Workbench.SettingHelp}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </Border>

            <Border Style="{StaticResource Workbench.Box}" Margin="{StaticResource Ui.Gap.Bottom.Normal}" ClipToBounds="True">
              <StackPanel>
                <Border Style="{StaticResource Workbench.SettingRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Settings.OpenDir}" Click="OnOpenRoot" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="{l:Tr Settings.DirRoot}" Style="{StaticResource Workbench.SettingTitle}" />
                      <TextBlock x:Name="DirRootPath" Style="{StaticResource Workbench.CellMono}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Workbench.SettingRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Settings.OpenDir}" Click="OnOpenAudit" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="{l:Tr Settings.DirAudit}" Style="{StaticResource Workbench.SettingTitle}" />
                      <TextBlock x:Name="DirAuditPath" Style="{StaticResource Workbench.CellMono}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Workbench.SettingRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Settings.OpenDir}" Click="OnOpenLogs" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="{l:Tr Settings.DirLogs}" Style="{StaticResource Workbench.SettingTitle}" />
                      <TextBlock x:Name="DirLogsPath" Style="{StaticResource Workbench.CellMono}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Workbench.SettingRow}" BorderThickness="0">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Settings.OpenDir}" Click="OnOpenBackups" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="{l:Tr Settings.DirBackups}" Style="{StaticResource Workbench.SettingTitle}" />
                      <TextBlock x:Name="DirBackupsPath" Style="{StaticResource Workbench.CellMono}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- config.json as it is: the design has no such box; the engineer still reads the file here. -->
            <Border Style="{StaticResource Workbench.Box}" Margin="{StaticResource Ui.Gap.Bottom.Normal}" ClipToBounds="True">
              <StackPanel>
                <Border Style="{StaticResource Workbench.BoxStrip}" BorderThickness="0,0,0,1">
                  <DockPanel>
                    <Button x:Name="ConfigButton" DockPanel.Dock="Right" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Settings.OpenConfig}" Click="OnOpenConfig" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="ConfigLabel" Text="{l:Tr Settings.Config}" Style="{StaticResource Workbench.SettingTitle}" />
                      <TextBlock x:Name="ConfigPath" Style="{StaticResource Workbench.CellMono}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <TextBox x:Name="ConfigText" Style="{StaticResource Workbench.ProjectData}" MaxHeight="220" Margin="{StaticResource Ui.Inset.BoxStrip}" AutomationProperties.LabeledBy="{Binding ElementName=ConfigLabel}" />
                <TextBlock x:Name="ConfigProblem" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" Margin="{StaticResource Ui.Inset.BoxStrip}"
                           Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.SettingsFooter}">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{l:Tr Settings.HomepageUrl}" Style="{StaticResource Workbench.CellMono}" Foreground="{DynamicResource Accent.Text}" />
                  <TextBlock Text="{l:Tr Settings.Homepage}" Style="{StaticResource Workbench.CellText}" Foreground="{DynamicResource Text.Tertiary}" />
                </DockPanel>
                <Border BorderBrush="{DynamicResource Border.Layer}" BorderThickness="0,1,0,0" Padding="{StaticResource Ui.Inset.FooterNote}" Margin="{StaticResource Ui.Gap.Top.XS}">
                  <TextBlock Text="{l:Tr Settings.AboutLicense}" Style="{StaticResource Workbench.SettingHelp}" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
