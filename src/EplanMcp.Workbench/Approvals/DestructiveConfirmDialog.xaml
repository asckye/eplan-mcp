<Window
    x:Class="EplanMcp.Workbench.Approvals.DestructiveConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    Style="{StaticResource Workbench.Window}">
  <!--
    ADR-0035, second step of approving a Destructive write (Workbench 4.0 design): a red "!", what it changes, that it
    cannot be undone here, the value to type; the two buttons equal, Cancel the default so Enter and Esc go back, the
    action red and disabled until the value matches.
  -->
  <Border Padding="{StaticResource Ui.Padding.Modal}" AutomationProperties.IsDialog="True" AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
    <StackPanel>
      <DockPanel>
        <Border DockPanel.Dock="Left" Style="{StaticResource Workbench.DialogIconDanger}" Margin="{StaticResource Ui.Gap.Right.SM}">
          <TextBlock Text="{l:Tr Confirm.Glyph}" Style="{StaticResource Workbench.DialogIconText}" Foreground="{DynamicResource State.Error.Text}" />
        </Border>
        <TextBlock x:Name="Heading" Style="{StaticResource Workbench.DialogTitle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
      </DockPanel>
      <TextBlock x:Name="Message" Text="{l:Tr Confirm.Message}" Style="{StaticResource Workbench.DialogBody}" />
      <TextBlock x:Name="Backup" Style="{StaticResource Workbench.SettingHelp}" />
      <Border Style="{StaticResource Workbench.CodeBox}" Margin="{StaticResource Ui.Gap.Top.Normal}">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{l:Tr Question.FromProject}" Style="{StaticResource Workbench.CellText}" Foreground="{DynamicResource Text.Tertiary}" />
            <TextBlock x:Name="ChangesLabel" Text="{l:Tr Question.Changes}" Style="{StaticResource Workbench.CellText}" Foreground="{DynamicResource Text.Tertiary}" />
          </DockPanel>
          <TextBox x:Name="Changes" Style="{StaticResource Workbench.ProjectData}" Background="Transparent" BorderThickness="0" MaxHeight="240" AutomationProperties.LabeledBy="{Binding ElementName=ChangesLabel}" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="TypeLabel" Style="{StaticResource Workbench.CellText}" FontWeight="Medium" TextWrapping="Wrap" TextTrimming="None" Margin="{StaticResource Ui.Gap.Top.SM}" />
      <TextBox x:Name="Typed" Style="{StaticResource Primer.Input}" FontFamily="{DynamicResource Ui.FontMono}" Margin="{StaticResource Ui.Gap.Top.XXS}" TextChanged="OnTyped" AutomationProperties.LabeledBy="{Binding ElementName=TypeLabel}" />
      <TextBlock Text="{l:Tr Confirm.EnterNote}" Style="{StaticResource Workbench.SettingHelp}" Margin="{StaticResource Ui.Gap.Top.XS}" />
      <UniformGrid Rows="1" Margin="{StaticResource Ui.Gap.Top.Normal}">
        <Button x:Name="CancelButton" Style="{StaticResource Workbench.ButtonPrimaryLg}" IsDefault="True" IsCancel="True" Margin="{StaticResource Ui.Gap.Right.XXS}" />
        <Button x:Name="ActionButton" Style="{StaticResource Workbench.ButtonDangerSolidLg}" IsEnabled="False" Margin="{StaticResource Ui.Gap.Left.XXS}" Click="OnAction" />
      </UniformGrid>
    </StackPanel>
  </Border>
</Window>
