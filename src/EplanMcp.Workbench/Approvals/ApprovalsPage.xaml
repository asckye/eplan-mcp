<UserControl
    x:Class="EplanMcp.Workbench.Approvals.ApprovalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:shell="clr-namespace:EplanMcp.Workbench.Shell"
    xmlns:approvals="clr-namespace:EplanMcp.Workbench.Approvals"
    Focusable="False">
  <!--
    AI collaboration and approvals (2026-11-20 design): two modes in the bar, the queue pane with both sections, the detail.
    Preserves all ADR-0014 / ADR-0035 / ADR-0010 focus, equal-weight answer buttons, and 500ms guard invariants.
  -->
  <UserControl.Resources>
    <!-- A row of either queue section: kind code and arrival, the tool, the project, then time left or how it ended. -->
    <DataTemplate x:Key="QuestionRowTemplate">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding ArrivedText}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="10.5" />
          <TextBlock x:Name="Code" Text="{Binding KindCode}" Style="{StaticResource Workbench.MonoStrong}" FontSize="10.5" Foreground="{DynamicResource Accent.Text}" />
        </DockPanel>
        <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" FontSize="12.5" FontWeight="Medium" Margin="{StaticResource Ui.Gap.Top.XXS}" TextWrapping="Wrap" TextTrimming="None" />
        <DockPanel Margin="{StaticResource Ui.Gap.Top.XXS}">
          <TextBlock x:Name="Result" DockPanel.Dock="Right" Text="{Binding Result}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="10.5" Foreground="{DynamicResource Text.Secondary}" Margin="{StaticResource Ui.Gap.Left.XS}"
                     Visibility="{Binding IsPending, Converter={StaticResource NotBoolToVisibility}}" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding CountdownText}" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}" FontSize="10.5" Margin="{StaticResource Ui.Gap.Left.XS}"
                     Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Primer.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DockPanel x:Name="OutcomeRow" Margin="{StaticResource Ui.Gap.Top.XXS}" Visibility="{Binding IsPending, Converter={StaticResource NotBoolToVisibility}}">
          <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}" VerticalAlignment="Top"
                Visibility="{Binding OutcomeIsWarning, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Outcome}" Style="{StaticResource Primer.ToneText}" Tag="{Binding OutcomeTone}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" />
        </DockPanel>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Outcome}" Value="">
          <Setter TargetName="OutcomeRow" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Question.End}" Value="{x:Static approvals:QuestionEnd.Approved}">
          <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource State.Success.Text}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Question.End}" Value="{x:Static approvals:QuestionEnd.Rejected}">
          <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource State.Error.Text}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
          <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource State.Error.Text}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRelease}" Value="True">
          <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource State.Warning.Text}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
      <DockPanel>
        <StackPanel x:Name="ApprovalPolicyBar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Height="26" Padding="{StaticResource Ui.Inset.Horizontal.XS}" CornerRadius="6" Background="{DynamicResource Surface.Subtle}" Margin="{StaticResource Ui.Gap.Right.XS}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="PolicyDot" Style="{StaticResource Workbench.StatusDot}" />
              <TextBlock x:Name="PolicyBadgeText" Style="{StaticResource Primer.Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.XS}" />
            </StackPanel>
          </Border>
          <Button x:Name="PolicyToggleButton" Style="{StaticResource Primer.Secondary}" MinHeight="28" Click="OnPolicyToggle" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- The page's heading for screen readers and focus (NAV-07); the design shows the two modes in its place. -->
          <Canvas Width="0">
            <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Approvals}" Opacity="0" AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" />
          </Canvas>
          <RadioButton x:Name="ApprovalsTab" GroupName="CollabMode" Style="{StaticResource Workbench.IdePill}" AutomationProperties.Name="{l:Tr Approvals.TabApprovals}" IsChecked="True" Checked="OnModeChanged" Margin="{StaticResource Ui.Gap.Right.XXS}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Primer.Icon}" Width="{StaticResource Ui.IconSize.Caption}" Height="{StaticResource Ui.IconSize.Caption}" Data="{StaticResource Workbench.Icon.Approvals}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="2" VerticalAlignment="Center" />
              <TextBlock Text="{l:Tr Approvals.TabApprovals}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Dot}" />
              <Border x:Name="PendingCountPill" Style="{StaticResource Workbench.PillCount}" Margin="{StaticResource Ui.Gap.Left.Dot}">
                <TextBlock x:Name="PendingCountText" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="CallsTab" GroupName="CollabMode" Style="{StaticResource Workbench.IdePill}" AutomationProperties.Name="{l:Tr Approvals.TabCalls}" Checked="OnModeChanged">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Primer.Icon}" Width="{StaticResource Ui.IconSize.Caption}" Height="{StaticResource Ui.IconSize.Caption}" Data="{StaticResource Workbench.Icon.Pulse}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="2" VerticalAlignment="Center" />
              <TextBlock Text="{l:Tr Approvals.TabCalls}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Dot}" />
              <Border Style="{StaticResource Workbench.PillCount}" Margin="{StaticResource Ui.Gap.Left.Dot}">
                <TextBlock x:Name="CallsCountText" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </RadioButton>
        </StackPanel>      </DockPanel>
    </Border>

    <Grid>
      <!-- SUB-TAB 1: APPROVALS QUEUE (ADR-0014 / ADR-0035 / ADR-0010) -->
      <Grid x:Name="Layout">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition x:Name="NarrowDetailRow" Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="274" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The queue pane (274 px): the waiting questions, then the answered ones, as the design lists them. -->
        <Border x:Name="QueuePane" Grid.RowSpan="2" Style="{StaticResource Workbench.LeftPane}" />
        <ScrollViewer x:Name="QueueScroll" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="{StaticResource Ui.Inset.QueuePane}">
            <DockPanel Margin="{StaticResource Ui.Gap.QueueSection}">
              <TextBlock x:Name="WaitingCount" DockPanel.Dock="Right" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11" />
              <TextBlock x:Name="WaitingHeader" Text="{l:Tr Approvals.PendingQueue}" Style="{StaticResource Workbench.SectionCaption}" />
            </DockPanel>
            <Border x:Name="NoPending" CornerRadius="8" Background="{DynamicResource Surface.Subtle}" Padding="{StaticResource Ui.Inset.QueueRow}" Margin="{StaticResource Ui.Gap.QueueRow}">
              <TextBlock Text="{l:Tr Approvals.NoPending}" Style="{StaticResource Primer.Muted}" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <ListBox x:Name="Questions" Style="{StaticResource Primer.List}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource Workbench.QuestionRow}" ItemTemplate="{StaticResource QuestionRowTemplate}"
                     ItemsSource="{Binding Pending}" AutomationProperties.Name="{l:Tr Approvals.List}"
                     SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" MouseDoubleClick="OnListOpen" />
            <DockPanel Margin="{StaticResource Ui.Gap.QueueSectionNext}">
              <TextBlock x:Name="AnsweredCount" DockPanel.Dock="Right" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11" />
              <TextBlock x:Name="AnsweredHeader" Text="{l:Tr Approvals.Resolved}" Style="{StaticResource Workbench.SectionCaption}" />
            </DockPanel>
            <ListBox x:Name="AnsweredList" Style="{StaticResource Primer.List}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource Workbench.QuestionRow}" ItemTemplate="{StaticResource QuestionRowTemplate}"
                     ItemsSource="{Binding Answered}" AutomationProperties.Name="{l:Tr Approvals.AnsweredList}"
                     SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" MouseDoubleClick="OnListOpen" />
          </StackPanel>
        </ScrollViewer>

        <shell:EmptyState x:Name="Empty" Grid.Row="1" Grid.Column="1" Title="{l:Tr Approvals.Empty}" Text="{l:Tr Approvals.EmptyText}" />

        <ScrollViewer x:Name="DetailArea" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" AutomationProperties.Name="{l:Tr Approvals.Detail}" DataContext="{Binding Shown}" KeyDown="OnDetailKeyDown">
          <StackPanel x:Name="Detail" Margin="{StaticResource Ui.Inset.DetailPage}" MaxWidth="820" HorizontalAlignment="Left">
            <!-- Kind, status, and the request with its arrival time. -->
            <StackPanel Orientation="Horizontal">
              <Border x:Name="KindTag" Style="{StaticResource Workbench.Tag.Accent}" Margin="{StaticResource Ui.Gap.Tag}">
                <TextBlock Text="{Binding KindCode}" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="StatusTag" Style="{StaticResource Workbench.Tag}" Margin="{StaticResource Ui.Gap.Tag}">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding IdLine}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="QuestionTitle" Text="{Binding Title}" Style="{StaticResource Primer.ContainerTitle}" FontSize="16" Margin="{StaticResource Ui.Gap.Top.SM}" TextWrapping="Wrap" TextTrimming="None"
                       Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />

            <Border Margin="{StaticResource Ui.Gap.Top.SM}" Style="{StaticResource Primer.Alert.Error}" Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisibility}}">
              <DockPanel>
                <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Error}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBlock x:Name="DestructiveTitle" Text="{l:Tr Question.DestructiveBanner}" Style="{StaticResource Ui.Text.BodyStrong}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBox x:Name="BackupFolder" Text="{Binding Backup, Mode=OneWay}" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.Name="{Binding Backup}"
                           AutomationProperties.LabeledBy="{Binding ElementName=DestructiveTitle}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- The facts as cards: a caption over a value. -->
            <UniformGrid Rows="1" Margin="{StaticResource Ui.Gap.Top.Normal}">
              <Border Style="{StaticResource Workbench.FactCard}">
                <StackPanel>
                  <TextBlock Text="{l:Tr Question.Tool}" Style="{StaticResource Workbench.FactCaption}" />
                  <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{Binding Tier}" Style="{StaticResource Primer.Muted}" Margin="{StaticResource Ui.Gap.Top.XXS}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Workbench.FactCard}">
                <StackPanel>
                  <TextBlock Text="{l:Tr Question.Project}" Style="{StaticResource Workbench.FactCaption}" />
                  <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{Binding ProjectPath}" Style="{StaticResource Primer.Mono.textMuted}" Margin="{StaticResource Ui.Gap.Top.XXS}" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Workbench.FactCard}">
                <StackPanel>
                  <TextBlock Text="{l:Tr Question.Client}" Style="{StaticResource Workbench.FactCaption}" />
                  <TextBlock Text="{Binding Client}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{Binding Eplan}" Style="{StaticResource Primer.Muted}" Margin="{StaticResource Ui.Gap.Top.XXS}" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Workbench.FactCard}" Visibility="{Binding IsRelease, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="{l:Tr Question.Suspended}" Style="{StaticResource Workbench.FactCaption}" />
                  <TextBlock Text="{Binding Suspension}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- The change list: a card with a header strip; the text is project data, plain and read only (APR-08). -->
            <Border Style="{StaticResource Workbench.Card}" Padding="0" Margin="{StaticResource Ui.Gap.Top.XXS}">
              <StackPanel>
                <Border Style="{StaticResource Workbench.CardHeader}">
                  <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Text="{l:Tr Question.FromProject}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="ChangesLabel" Text="{l:Tr Question.Changes}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="12.5" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                  </DockPanel>
                </Border>
                <TextBox x:Name="Changes" Text="{Binding Changes, Mode=OneWay}" Style="{StaticResource Workbench.ProjectData}" BorderThickness="0" Background="Transparent" MaxHeight="280"
                         AutomationProperties.LabeledBy="{Binding ElementName=ChangesLabel}" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding Note}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="{StaticResource Ui.Gap.Top.XS}" />

            <Border Style="{StaticResource Workbench.Card}" Margin="{StaticResource Ui.Gap.Top.Normal}" Visibility="{Binding IsPending, Converter={StaticResource NotBoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="{Binding Result}" Style="{StaticResource Ui.Text.BodyStrong}" TextWrapping="Wrap" TextTrimming="None" />
                <DockPanel Margin="{StaticResource Ui.Gap.Top.XXS}">
                  <Path x:Name="OutcomeWarning" DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}"
                        VerticalAlignment="Top" Visibility="{Binding OutcomeIsWarning, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock x:Name="OutcomeText" Text="{Binding Outcome}" Style="{StaticResource Primer.ToneText}" Tag="{Binding OutcomeTone}" TextWrapping="Wrap"
                             TextTrimming="None" />
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- The action card: time left, which answer is the safe one, then the two answers. -->
            <Border x:Name="Waiting" Style="{StaticResource Workbench.Card}" Margin="{StaticResource Ui.Gap.Top.Normal}" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
              <!-- The design's action row: what the answers do on the left, the two answers on the right; time left below. -->
              <StackPanel>
              <DockPanel>
                <UniformGrid x:Name="Answers" DockPanel.Dock="Right" Rows="1" Columns="2" VerticalAlignment="Center">
                  <Button x:Name="RejectButton" Style="{StaticResource Workbench.Answer}" Content="{Binding RejectLabel}" AutomationProperties.Name="{Binding RejectLabel}"
                          IsDefault="False" IsCancel="False" Margin="{StaticResource Ui.Gap.Right.XXS}" Click="OnReject" />
                  <Button x:Name="ApproveButton" Style="{StaticResource Workbench.Answer}" Content="{Binding ApproveLabel}" AutomationProperties.Name="{Binding ApproveLabel}"
                          IsDefault="False" IsCancel="False" Margin="{StaticResource Ui.Gap.Left.XXS}" Click="OnApprove" />
                </UniformGrid>
                <TextBlock x:Name="AnswerHint" Text="{Binding AnswerHint}" Style="{StaticResource Primer.Muted}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Right.SM}" />
              </DockPanel>
              <DockPanel Margin="{StaticResource Ui.Gap.Top.SM}">
                <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="{StaticResource Ui.IconSize.Caption}" Height="{StaticResource Ui.IconSize.Caption}" Margin="{StaticResource Ui.Gap.Right.XXS}" VerticalAlignment="Center"
                      Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Name="CountdownText" DockPanel.Dock="Left" Text="{Binding CountdownText}" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}" FontSize="11.5" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Right.SM}" />
                <ProgressBar x:Name="CountdownBar" Style="{StaticResource Primer.Progress}" Height="4" Tag="{Binding Tone}" Value="{Binding Remaining, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"
                             AutomationProperties.Name="{l:Tr Question.TimeLeft}" />
              </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="Announcer" Grid.Row="3" Height="1" Opacity="0" AutomationProperties.LiveSetting="Assertive" />
      </Grid>
      <!-- SUB-TAB 2: ALL AI CALLS HISTORY (TIA 1:1 Pattern) -->
      <DockPanel x:Name="CallsPanel" Visibility="Collapsed">
        <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeSubBar}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="CallsSearch" Width="210" Style="{StaticResource Primer.Input}" Margin="{StaticResource Ui.Gap.Right.XS}" TextChanged="OnCallsFilterChanged" />
              <Button x:Name="CallsReload" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Approvals.CallsRefresh}" Margin="{StaticResource Ui.Gap.Right.XS}" Click="OnCallsReload" />
              <ToggleButton x:Name="InspectorToggle" Style="{StaticResource Workbench.IdePill.Toggle}" Content="{l:Tr Approvals.Inspector}" IsChecked="True" Click="OnInspectorToggle" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="CallsAll" GroupName="CallsFilter" Style="{StaticResource Workbench.IdePill.Compact}" Content="{l:Tr Approvals.CallsAll}" IsChecked="True" Checked="OnCallsFilterChanged" Margin="{StaticResource Ui.Gap.Right.XXS}" />
              <RadioButton x:Name="CallsWrite" GroupName="CallsFilter" Style="{StaticResource Workbench.IdePill.Compact}" Content="{l:Tr Approvals.CallsWrite}" Checked="OnCallsFilterChanged" Margin="{StaticResource Ui.Gap.Right.XXS}" />
              <RadioButton x:Name="CallsFailed" GroupName="CallsFilter" Style="{StaticResource Workbench.IdePill.Compact}" Content="{l:Tr Approvals.CallsFailed}" Checked="OnCallsFilterChanged" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="344" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <ListView x:Name="CallsList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="OnCallSelected">
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="CallTimeCol" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="CallToolCol" Width="230">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" FontSize="12.5" FontWeight="Medium" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="CallKindCol" Width="140">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Border x:Name="KindTag" Style="{StaticResource Workbench.Tag}" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" />
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsWrite}" Value="True">
                            <Setter TargetName="KindTag" Property="Style" Value="{StaticResource Workbench.Tag.Accent}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="CallProjectCol" Width="200">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Project}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="12" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="CallResultCol" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Border x:Name="ResultTag" Style="{StaticResource Workbench.Tag.Success}" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Result}" VerticalAlignment="Center" />
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsFailed}" Value="True">
                            <Setter TargetName="ResultTag" Property="Style" Value="{StaticResource Workbench.Tag.Error}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <shell:EmptyState x:Name="CallsEmpty" Title="{l:Tr Approvals.CallsEmpty}" Text="{l:Tr Approvals.CallsEmptyText}" Visibility="Collapsed" />
          </Grid>

          <!-- The inspector (344 px): the chosen record as a summary card, then as the log wrote it. -->
          <Border x:Name="CallInspector" Grid.Column="1" Style="{StaticResource Workbench.RightPane}" Padding="{StaticResource Ui.Inset.CardBody}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.Card}" Padding="{StaticResource Ui.Inset.CardBody}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
                <StackPanel x:Name="CallSummary">
                  <TextBlock Text="{l:Tr Audit.Tool}" Style="{StaticResource Workbench.FactCaption}" />
                  <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{l:Tr Audit.Project}" Style="{StaticResource Workbench.FactCaption}" Margin="{StaticResource Ui.Gap.ChangesLabel}" />
                  <TextBlock Text="{Binding Project}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{l:Tr Audit.Result}" Style="{StaticResource Workbench.FactCaption}" Margin="{StaticResource Ui.Gap.ChangesLabel}" />
                  <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{l:Tr Audit.Time}" Style="{StaticResource Workbench.FactCaption}" Margin="{StaticResource Ui.Gap.ChangesLabel}" />
                  <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.text}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Workbench.Card}" Padding="0">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.CardHeader}">
                    <TextBlock x:Name="CallRecordLabel" Text="{l:Tr Approvals.Inspector}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="12.5" VerticalAlignment="Center" />
                  </Border>
                  <TextBox x:Name="CallInspectorText" Style="{StaticResource Workbench.ProjectData}" BorderThickness="0" Background="Transparent" AutomationProperties.LabeledBy="{Binding ElementName=CallRecordLabel}" />
                </DockPanel>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </DockPanel>    </Grid>
  </DockPanel>
</UserControl>
