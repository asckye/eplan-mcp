<UserControl
    x:Class="EplanMcp.Workbench.Approvals.ApprovalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:shell="clr-namespace:EplanMcp.Workbench.Shell"
    Focusable="False">
  <!--
    AI collaboration and approvals (Workbench 4.0 design): the two modes and the pending/history switch in the bar; the
    pending queue (260 px) beside the question; the answered questions as a table. Preserves ADR-0014 / ADR-0035 /
    ADR-0010 focus, equal-weight answer buttons and the 500 ms guard.
  -->
  <UserControl.Resources>
    <!-- A waiting row: the badge in its tone and the time left; the tool; the project and how many changes. -->
    <DataTemplate x:Key="QuestionRowTemplate">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Timer}" Style="{StaticResource Workbench.RowTimer}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding BadgeGlyph}" Style="{StaticResource Workbench.ToneBadge}" Tag="{Binding BadgeTone}" />
            <TextBlock Text="{Binding Badge}" Style="{StaticResource Workbench.ToneBadge}" Tag="{Binding BadgeTone}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Ui.Gap.Left.Dot}" />
          </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding Tool}" Style="{StaticResource Workbench.QueueTitle}" Margin="{StaticResource Ui.Gap.Top.XXS}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Workbench.QueueSub}" />
      </StackPanel>
    </DataTemplate>

    <!-- A history row as a table row: time, tool over project, client, decision and outcome, audit, note. -->
    <DataTemplate x:Key="HistoryRowTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1.3*" />
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ArrivedText}" Style="{StaticResource Workbench.CellMono}" />
        <StackPanel Grid.Column="1" Margin="{StaticResource Ui.Gap.Right.SM}">
          <TextBlock Text="{Binding Tool}" Style="{StaticResource Workbench.CellMonoStrong}" />
          <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Workbench.QueueSub}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Client}" Style="{StaticResource Workbench.CellText}" />
        <Border Grid.Column="3" Style="{StaticResource Workbench.CcTag}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding BadgeGlyph}" Style="{StaticResource Workbench.ToneGlyph}" Tag="{Binding BadgeTone}" />
            <TextBlock Text="{Binding Result}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Dot}" />
          </StackPanel>
        </Border>
        <Button Grid.Column="4" Content="{l:Tr Approvals.OpenAudit}" Style="{StaticResource Workbench.LinkButton}" HorizontalAlignment="Left" Click="OnHistoryAudit" />
        <DockPanel Grid.Column="5">
          <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}" VerticalAlignment="Top"
                Visibility="{Binding OutcomeIsWarning, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Outcome}" Style="{StaticResource Workbench.CellText}" TextWrapping="Wrap" />
        </DockPanel>
      </Grid>
    </DataTemplate>

    <!-- A diff row behind the change list: the number, the sign, the background of an added or removed line. -->
    <DataTemplate x:Key="DiffRowTemplate">
      <Border x:Name="Row" Style="{StaticResource Workbench.DiffRow}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Number}" Style="{StaticResource Workbench.DiffNumber}" />
          <TextBlock x:Name="Sign" Text="{Binding Sign}" Style="{StaticResource Workbench.DiffSign}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsAdded}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Workbench.DiffAddBg}" />
          <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource State.Success.Text}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Workbench.DiffDelBg}" />
          <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource State.Error.Text}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
      <DockPanel>
        <!-- The pending/history switch (cc-seg), shown in the approvals mode. -->
        <Border x:Name="ViewSwitch" DockPanel.Dock="Right" Style="{StaticResource Workbench.Segment}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PendingView" GroupName="ApprovalView" Style="{StaticResource Workbench.SegmentItem}" IsChecked="True" Checked="OnViewSwitched">
              <TextBlock><Run Text="{l:Tr Approvals.SegPending}" /><Run x:Name="PendingViewCount" /></TextBlock>
            </RadioButton>
            <RadioButton x:Name="HistoryView" GroupName="ApprovalView" Style="{StaticResource Workbench.SegmentItem}" Checked="OnViewSwitched">
              <TextBlock><Run Text="{l:Tr Approvals.SegHistory}" /><Run x:Name="HistoryViewCount" /></TextBlock>
            </RadioButton>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- The page's heading for screen readers and focus (NAV-07); the design shows the two modes in its place. -->
          <Canvas Width="0">
            <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Approvals}" Opacity="0" AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" />
          </Canvas>
          <RadioButton x:Name="ApprovalsTab" GroupName="CollabMode" Style="{StaticResource Workbench.IdePill}" AutomationProperties.Name="{l:Tr Approvals.TabApprovals}" IsChecked="True" Checked="OnModeChanged" Margin="{StaticResource Ui.Gap.Right.XXS}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Tr Approvals.TabApprovals}" VerticalAlignment="Center" />
              <Border x:Name="PendingCountPill" Style="{StaticResource Workbench.PillCount}" Margin="{StaticResource Ui.Gap.Left.Dot}">
                <TextBlock x:Name="PendingCountText" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="CallsTab" GroupName="CollabMode" Style="{StaticResource Workbench.IdePill}" AutomationProperties.Name="{l:Tr Approvals.TabCalls}" Checked="OnModeChanged">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Tr Approvals.TabCalls}" VerticalAlignment="Center" />
              <Border Style="{StaticResource Workbench.PillCount}" Margin="{StaticResource Ui.Gap.Left.Dot}">
                <TextBlock x:Name="CallsCountText" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <!-- MODE 1, PENDING: the queue (260 px) and the question shown (ADR-0014 / ADR-0035 / ADR-0010). -->
      <Grid x:Name="Layout">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition x:Name="NarrowDetailRow" Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="QueueColumn" Width="260" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="QueuePane" Grid.RowSpan="2" Style="{StaticResource Workbench.LeftPane}" />
        <ScrollViewer x:Name="QueueScroll" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="{StaticResource Ui.Inset.QueuePane}">
            <DockPanel Margin="{StaticResource Ui.Gap.QueueSection}">
              <TextBlock x:Name="WaitingCount" DockPanel.Dock="Right" Style="{StaticResource Workbench.PaneCaptionCount}" />
              <TextBlock x:Name="WaitingHeader" Text="{l:Tr Approvals.PendingQueue}" Style="{StaticResource Workbench.PaneCaption}" />
            </DockPanel>
            <ListBox x:Name="Questions" Style="{StaticResource Primer.List}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource Workbench.QuestionRow}" ItemTemplate="{StaticResource QuestionRowTemplate}"
                     ItemsSource="{Binding Pending}" AutomationProperties.Name="{l:Tr Approvals.List}"
                     SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" MouseDoubleClick="OnListOpen" />
          </StackPanel>
        </ScrollViewer>

        <!-- Nothing waits: the whole page says so, with the way to the history (the design's empty state). -->
        <shell:EmptyState x:Name="Empty" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Title="{l:Tr Approvals.Empty}" />
        <Button x:Name="NoPending" Grid.RowSpan="2" Grid.ColumnSpan="2" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Approvals.ToHistory}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.EmptyCta}" Click="OnToHistory" />

        <ScrollViewer x:Name="DetailArea" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" AutomationProperties.Name="{l:Tr Approvals.Detail}" DataContext="{Binding Shown}" KeyDown="OnDetailKeyDown">
          <StackPanel x:Name="Detail" Margin="{StaticResource Ui.Inset.DetailPage}" MaxWidth="780">
            <!-- Who asks, the request and the tool; the title; the time left or the result. -->
            <DockPanel>
              <Border x:Name="StateTag" DockPanel.Dock="Right" Style="{StaticResource Workbench.CcTag}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding BadgeGlyph}" Style="{StaticResource Workbench.ToneGlyph}" Tag="{Binding BadgeTone}" />
                  <TextBlock x:Name="CountdownText" Text="{Binding StateText}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Dot}" />
                </StackPanel>
              </Border>
              <StackPanel Margin="{StaticResource Ui.Gap.Right.SM}">
                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Workbench.MetaLine}" />
                <TextBlock x:Name="QuestionTitle" Text="{Binding Title}" Style="{StaticResource Workbench.DetailTitle}" Margin="{StaticResource Ui.Gap.Top.XXS}" AutomationProperties.HeadingLevel="Level2"
                           Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
              </StackPanel>
            </DockPanel>

            <!-- A Destructive write: the project, where it is backed up first, and the tier, in one box. -->
            <Border Style="{StaticResource Workbench.Box}" Margin="{StaticResource Ui.Gap.Top.Normal}" Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisibility}}">
              <UniformGrid Rows="1">
                <StackPanel Margin="{StaticResource Ui.Inset.BoxCell}">
                  <TextBlock Text="{l:Tr Question.TargetProject}" Style="{StaticResource Workbench.BoxCaption}" />
                  <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Workbench.CellMonoStrong}" TextWrapping="Wrap" />
                </StackPanel>
                <Border BorderBrush="{DynamicResource Border.Layer}" BorderThickness="1,0">
                  <StackPanel Margin="{StaticResource Ui.Inset.BoxCell}">
                    <TextBlock x:Name="DestructiveTitle" Text="{l:Tr Question.BackupCaption}" Style="{StaticResource Workbench.BoxCaption}" />
                    <TextBox x:Name="BackupFolder" Text="{Binding Backup, Mode=OneWay}" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.Name="{Binding Backup}"
                             AutomationProperties.LabeledBy="{Binding ElementName=DestructiveTitle}" />
                  </StackPanel>
                </Border>
                <StackPanel Margin="{StaticResource Ui.Inset.BoxCell}">
                  <TextBlock Text="{l:Tr Question.SafetyTier}" Style="{StaticResource Workbench.BoxCaption}" />
                  <TextBlock Text="{l:Tr Question.DestructiveTier}" Style="{StaticResource Workbench.CellMonoStrong}" />
                </StackPanel>
              </UniformGrid>
            </Border>

            <!-- A release: what was suspended, and what to check first. -->
            <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.BoxBody}" Margin="{StaticResource Ui.Gap.Top.Normal}" Visibility="{Binding IsRelease, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="{l:Tr Question.SuspendedBecause}" Style="{StaticResource Workbench.BoxCaption}" />
                <TextBlock Text="{Binding Suspension}" Style="{StaticResource Workbench.CellMonoStrong}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- The change list as a diff: header with the project and the counts, numbered rows, the answers below. -->
            <Border Style="{StaticResource Workbench.Box}" Margin="{StaticResource Ui.Gap.Top.Normal}" ClipToBounds="True">
              <StackPanel>
                <Border Style="{StaticResource Workbench.BoxStrip}" BorderThickness="0,0,0,1">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{l:Tr Question.FromProject}" Style="{StaticResource Workbench.BoxHint}" />
                      <TextBlock Text="{Binding DiffCounts}" Style="{StaticResource Workbench.DiffCounts}" Margin="{StaticResource Ui.Gap.Left.XS}" />
                    </StackPanel>
                    <TextBlock x:Name="ChangesLabel" Text="{Binding ProjectName}" Style="{StaticResource Workbench.CellMonoStrong}" AutomationProperties.HeadingLevel="Level2"
                               AutomationProperties.Name="{l:Tr Question.Changes}" />
                  </DockPanel>
                </Border>
                <Grid Margin="{StaticResource Ui.Gap.DiffBody}">
                  <ItemsControl ItemsSource="{Binding DiffLines}" ItemTemplate="{StaticResource DiffRowTemplate}" Focusable="False" IsTabStop="False" />
                  <!-- The text itself, plain and selectable, over the rows (APR-08). -->
                  <TextBox x:Name="Changes" Text="{Binding Changes, Mode=OneWay}" Style="{StaticResource Workbench.DiffText}" MaxHeight="320"
                           AutomationProperties.LabeledBy="{Binding ElementName=ChangesLabel}" />
                </Grid>
                <!-- The action row: what the answers do on the left, the two answers on the right. -->
                <Border x:Name="Waiting" Style="{StaticResource Workbench.BoxStrip}" BorderThickness="0,1,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                  <DockPanel>
                    <UniformGrid x:Name="Answers" DockPanel.Dock="Right" Rows="1" Columns="2" VerticalAlignment="Center">
                      <Button x:Name="RejectButton" Style="{StaticResource Workbench.Answer}" Content="{Binding RejectLabel}" AutomationProperties.Name="{Binding RejectLabel}"
                              IsDefault="False" IsCancel="False" Margin="{StaticResource Ui.Gap.Right.XXS}" Click="OnReject" />
                      <Button x:Name="ApproveButton" Style="{StaticResource Workbench.Answer}" Content="{Binding ApproveLabel}" AutomationProperties.Name="{Binding ApproveLabel}"
                              IsDefault="False" IsCancel="False" Margin="{StaticResource Ui.Gap.Left.XXS}" Click="OnApprove" />
                    </UniformGrid>
                    <TextBlock x:Name="AnswerHint" Text="{Binding AnswerHint}" Style="{StaticResource Workbench.BoxHint}" Margin="{StaticResource Ui.Gap.Right.SM}" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding Note}" Style="{StaticResource Workbench.BoxHint}" Margin="{StaticResource Ui.Gap.Top.XS}" />

            <!-- An answered question: how it ended and what became of the write. -->
            <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.BoxBody}" Margin="{StaticResource Ui.Gap.Top.Normal}" Visibility="{Binding IsPending, Converter={StaticResource NotBoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="{Binding Result}" Style="{StaticResource Ui.Text.BodyStrong}" TextWrapping="Wrap" TextTrimming="None" />
                <DockPanel Margin="{StaticResource Ui.Gap.Top.XXS}">
                  <Path x:Name="OutcomeWarning" DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}"
                        VerticalAlignment="Top" Visibility="{Binding OutcomeIsWarning, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock x:Name="OutcomeText" Text="{Binding Outcome}" Style="{StaticResource Primer.ToneText}" Tag="{Binding OutcomeTone}" TextWrapping="Wrap" TextTrimming="None" />
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="Announcer" Grid.Row="3" Height="1" Opacity="0" AutomationProperties.LiveSetting="Assertive" />
      </Grid>

      <!-- MODE 1, HISTORY: the answered questions as a table; a row opens its question. -->
      <ScrollViewer x:Name="HistoryPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="{StaticResource Ui.Inset.DetailPage}">
          <Border x:Name="HistoryBox" Style="{StaticResource Workbench.Box}" MaxWidth="960" VerticalAlignment="Top" ClipToBounds="True">
            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.TableHead}">
                <Grid x:Name="HistoryHead">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="2*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{l:Tr Approvals.ColTime}" Style="{StaticResource Workbench.TableHeadText}" />
                  <TextBlock Grid.Column="1" Text="{l:Tr Approvals.ColTool}" Style="{StaticResource Workbench.TableHeadText}" />
                  <TextBlock Grid.Column="2" Text="{l:Tr Approvals.ColClient}" Style="{StaticResource Workbench.TableHeadText}" />
                  <TextBlock Grid.Column="3" Text="{l:Tr Approvals.ColResult}" Style="{StaticResource Workbench.TableHeadText}" />
                  <TextBlock Grid.Column="4" Text="{l:Tr Approvals.ColAudit}" Style="{StaticResource Workbench.TableHeadText}" />
                  <TextBlock Grid.Column="5" Text="{l:Tr Approvals.ColNote}" Style="{StaticResource Workbench.TableHeadText}" />
                </Grid>
              </Border>
              <ListBox x:Name="AnsweredList" Style="{StaticResource Primer.List}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource Workbench.TableRow}" ItemTemplate="{StaticResource HistoryRowTemplate}"
                       ItemsSource="{Binding Answered}" AutomationProperties.Name="{l:Tr Approvals.AnsweredList}"
                       SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" MouseDoubleClick="OnListOpen" />
            </DockPanel>
          </Border>
          <shell:EmptyState x:Name="HistoryEmpty" Title="{l:Tr Approvals.HistoryEmpty}" Text="{l:Tr Approvals.HistoryEmptyText}" />
        </Grid>
      </ScrollViewer>
      <!-- SUB-TAB 2: ALL AI CALLS HISTORY (TIA 1:1 Pattern) -->
      <DockPanel x:Name="CallsPanel" Visibility="Collapsed">
        <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeSubBar}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="CallsSearch" Width="210" Style="{StaticResource Primer.Input}" Margin="{StaticResource Ui.Gap.Right.XS}" TextChanged="OnCallsFilterChanged" />
              <Button x:Name="CallsReload" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Approvals.CallsRefresh}" Margin="{StaticResource Ui.Gap.Right.XS}" Click="OnCallsReload" />
              <ToggleButton x:Name="InspectorToggle" Style="{StaticResource Workbench.IdePill.Toggle}" Content="{l:Tr Approvals.Inspector}" IsChecked="True" Click="OnInspectorToggle" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="CallsAll" GroupName="CallsFilter" Style="{StaticResource Workbench.IdePill.Compact}" Content="{l:Tr Approvals.CallsAll}" IsChecked="True" Checked="OnCallsFilterChanged" Margin="{StaticResource Ui.Gap.Right.XXS}" />
              <RadioButton x:Name="CallsWrite" GroupName="CallsFilter" Style="{StaticResource Workbench.IdePill.Compact}" Content="{l:Tr Approvals.CallsWrite}" Checked="OnCallsFilterChanged" Margin="{StaticResource Ui.Gap.Right.XXS}" />
              <RadioButton x:Name="CallsFailed" GroupName="CallsFilter" Style="{StaticResource Workbench.IdePill.Compact}" Content="{l:Tr Approvals.CallsFailed}" Checked="OnCallsFilterChanged" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="344" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <ListView x:Name="CallsList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="OnCallSelected">
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="CallTimeCol" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="CallToolCol" Width="230">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" FontSize="12.5" FontWeight="Medium" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="CallKindCol" Width="140">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Border x:Name="KindTag" Style="{StaticResource Workbench.Tag}" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" />
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsWrite}" Value="True">
                            <Setter TargetName="KindTag" Property="Style" Value="{StaticResource Workbench.Tag.Accent}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="CallProjectCol" Width="200">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Project}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="12" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="CallResultCol" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Border x:Name="ResultTag" Style="{StaticResource Workbench.Tag.Success}" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Result}" VerticalAlignment="Center" />
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsFailed}" Value="True">
                            <Setter TargetName="ResultTag" Property="Style" Value="{StaticResource Workbench.Tag.Error}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <shell:EmptyState x:Name="CallsEmpty" Title="{l:Tr Approvals.CallsEmpty}" Text="{l:Tr Approvals.CallsEmptyText}" Visibility="Collapsed" />
          </Grid>

          <!-- The inspector (344 px): the chosen record as a summary card, then as the log wrote it. -->
          <Border x:Name="CallInspector" Grid.Column="1" Style="{StaticResource Workbench.RightPane}" Padding="{StaticResource Ui.Inset.CardBody}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.Card}" Padding="{StaticResource Ui.Inset.CardBody}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
                <StackPanel x:Name="CallSummary">
                  <TextBlock Text="{l:Tr Audit.Tool}" Style="{StaticResource Workbench.FactCaption}" />
                  <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{l:Tr Audit.Project}" Style="{StaticResource Workbench.FactCaption}" Margin="{StaticResource Ui.Gap.ChangesLabel}" />
                  <TextBlock Text="{Binding Project}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{l:Tr Audit.Result}" Style="{StaticResource Workbench.FactCaption}" Margin="{StaticResource Ui.Gap.ChangesLabel}" />
                  <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
                  <TextBlock Text="{l:Tr Audit.Time}" Style="{StaticResource Workbench.FactCaption}" Margin="{StaticResource Ui.Gap.ChangesLabel}" />
                  <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.text}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Workbench.Card}" Padding="0">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.CardHeader}">
                    <TextBlock x:Name="CallRecordLabel" Text="{l:Tr Approvals.Inspector}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="12.5" VerticalAlignment="Center" />
                  </Border>
                  <TextBox x:Name="CallInspectorText" Style="{StaticResource Workbench.ProjectData}" BorderThickness="0" Background="Transparent" AutomationProperties.LabeledBy="{Binding ElementName=CallRecordLabel}" />
                </DockPanel>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
