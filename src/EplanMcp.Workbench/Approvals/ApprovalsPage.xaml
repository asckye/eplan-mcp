<UserControl
    x:Class="EplanMcp.Workbench.Approvals.ApprovalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:shell="clr-namespace:EplanMcp.Workbench.Shell"
    Focusable="False">
  <!--
    The approval queue (workbench-ui section 11, M5 design 4.6): the waiting or the answered questions on the left, the
    shown one on the right, or below them in a narrow window (APR-06, LAY-03). Answering has one path, the two buttons of
    the shown question (APR-01, APR-02).
  -->
  <DockPanel>
    <!-- The page head of 3.4, as PageView draws it: the title is level 1, focusable, not a Tab stop. -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.PageHead}">
      <StackPanel>
        <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Approvals}" Style="{StaticResource Primer.PageTitle}" TextWrapping="Wrap" TextTrimming="None"
                   Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
        <TextBlock Text="{l:Tr Page.Approvals.Caption}" Style="{StaticResource Primer.PageSubtitle}" TextWrapping="Wrap" TextTrimming="None" />
      </StackPanel>
    </Border>
    <Grid x:Name="Layout">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition x:Name="NarrowDetailRow" Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Waiting and answered: one group, one Tab stop, arrows inside (Ant Segmented, KEY-10). -->
      <Border Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,0,0,12" Style="{StaticResource Primer.SegmentGroup}">
        <StackPanel x:Name="Groups" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"
                    AutomationProperties.Name="{l:Tr Approvals.Groups}">
          <RadioButton x:Name="WaitingGroup" GroupName="QuestionGroup" Style="{StaticResource Primer.Segment}" IsChecked="True" Checked="OnGroup" />
          <RadioButton x:Name="AnsweredGroup" GroupName="QuestionGroup" Style="{StaticResource Primer.Segment}" Checked="OnGroup" />
        </StackPanel>
      </Border>

      <ListBox x:Name="Questions" Grid.Row="1" Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Workbench.QuestionRow}"
               ItemsSource="{Binding Pending}" AutomationProperties.Name="{l:Tr Approvals.List}"
               SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" MouseDoubleClick="OnListOpen">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,8">
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.Tag}" Margin="8,0,0,0" Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding Tier}" Style="{StaticResource Primer.Text.diffRed}" />
                </Border>
                <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" />
              </DockPanel>
              <!-- One line each, wrapping: the 320 epx column must not cut a project name or a countdown (TYP-10). -->
              <TextBlock Text="{Binding Kind}" Style="{StaticResource Primer.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
              <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Primer.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
              <TextBlock Text="{Binding CountdownText}" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                         Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                         Visibility="{Binding IsPending, Converter={StaticResource NotBoolToVisibility}}" />
              <TextBlock Text="{Binding Outcome}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                         Visibility="{Binding IsPending, Converter={StaticResource NotBoolToVisibility}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <shell:EmptyState x:Name="Empty" Grid.Row="1" Grid.ColumnSpan="2" Title="{l:Tr Approvals.Empty}" Text="{l:Tr Approvals.EmptyText}" />

      <!-- The shown question (APR-07). Focus goes to its title, never to a button (APR-03). -->
      <ScrollViewer x:Name="DetailArea" Grid.Row="1" Grid.Column="1" Margin="24,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="False" AutomationProperties.Name="{l:Tr Approvals.Detail}" DataContext="{Binding Shown}">
        <StackPanel x:Name="Detail" Margin="0,0,8,0">
          <TextBlock x:Name="QuestionTitle" Text="{Binding Title}" Style="{StaticResource Primer.ContainerTitle}" TextWrapping="Wrap" TextTrimming="None"
                     Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />

          <!-- APR-09: a Destructive write, in words and with its icon, and where the project is backed up first. -->
          <Border Margin="0,12,0,0" Style="{StaticResource Primer.Alert.Error}" Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Error}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
              <StackPanel>
                <TextBlock x:Name="DestructiveTitle" Text="{l:Tr Question.DestructiveBanner}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" />
                <TextBox x:Name="BackupFolder" Text="{Binding Backup, Mode=OneWay}" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.Name="{Binding Backup}"
                         AutomationProperties.LabeledBy="{Binding ElementName=DestructiveTitle}" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="24" />
              <RowDefinition Height="Auto" MinHeight="24" />
              <RowDefinition Height="Auto" MinHeight="24" />
              <RowDefinition Height="Auto" MinHeight="24" />
              <RowDefinition Height="Auto" MinHeight="24" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr Question.Tool}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock Grid.Row="1" Text="{l:Tr Question.Tier}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tier}" Style="{StaticResource Primer.Text}" />
            <TextBlock Grid.Row="2" Text="{l:Tr Question.Project}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0" VerticalAlignment="Top" />
            <StackPanel Grid.Row="2" Grid.Column="1">
              <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
              <TextBlock Text="{Binding ProjectPath}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{l:Tr Question.Eplan}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Eplan}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock Grid.Row="4" Text="{l:Tr Question.Client}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Client}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock Grid.Row="5" Text="{l:Tr Question.Suspended}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0"
                       Visibility="{Binding IsRelease, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Suspension}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None"
                       Visibility="{Binding IsRelease, Converter={StaticResource BoolToVisibility}}" />
          </Grid>

          <!-- APR-08: the change list is project data, said so, plain, read only and selectable. -->
          <DockPanel Margin="0,12,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{l:Tr Question.FromProject}" Style="{StaticResource Primer.Muted}" />
            <TextBlock x:Name="ChangesLabel" Text="{l:Tr Question.Changes}" Style="{StaticResource Primer.SectionLabel}" />
          </DockPanel>
          <TextBox x:Name="Changes" Text="{Binding Changes, Mode=OneWay}" Style="{StaticResource Workbench.ProjectData}" MaxHeight="280"
                   AutomationProperties.LabeledBy="{Binding ElementName=ChangesLabel}" />
          <TextBlock Text="{Binding Note}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" />

          <!-- APR-11, APR-12: how the question ended, and what became of the write. -->
          <StackPanel Margin="0,12,0,0" Visibility="{Binding IsPending, Converter={StaticResource NotBoolToVisibility}}">
            <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock Text="{Binding Outcome}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
          </StackPanel>

          <!-- APR-10: the countdown in words and as a bar; the last 20 seconds in the warning colour, with the icon. -->
          <StackPanel x:Name="Waiting" Margin="0,16,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="14" Height="14" Margin="0,0,8,0"
                    Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock x:Name="CountdownText" Text="{Binding CountdownText}" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}" TextWrapping="Wrap" TextTrimming="None" />
            </DockPanel>
            <ProgressBar x:Name="CountdownBar" Style="{StaticResource Primer.Progress}" Tag="{Binding Tone}" Value="{Binding Remaining, Mode=OneWay}" Maximum="100" Margin="0,8,0,16"
                         AutomationProperties.Name="{l:Tr Question.TimeLeft}" />
            <!-- Reject on the left, Approve on the right, as in the EPLAN dialog; same style, neither default nor cancel. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="RejectButton" Style="{StaticResource Workbench.Answer}" Content="{Binding RejectLabel}" AutomationProperties.Name="{Binding RejectLabel}"
                      IsDefault="False" IsCancel="False" Click="OnReject" />
              <Button x:Name="ApproveButton" Style="{StaticResource Workbench.Answer}" Content="{Binding ApproveLabel}" AutomationProperties.Name="{Binding ApproveLabel}"
                      IsDefault="False" IsCancel="False" Margin="8,0,0,0" Click="OnApprove" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- STS-02, A11Y-08: what screen readers are told; it takes no room. -->
      <TextBlock x:Name="Announcer" Grid.Row="3" Height="1" Opacity="0" AutomationProperties.LiveSetting="Assertive" />
    </Grid>
  </DockPanel>
</UserControl>
