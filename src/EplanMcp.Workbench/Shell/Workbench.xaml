  </Style>  <!-- A toast (the 2026-11-20 design, section 5.3): elevated, rounded, with the pop-up shadow; a dot and the message. -->
  <Style x:Key="Workbench.Toast" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.Toast}" />
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.Toast}" />
    <Setter Property="CornerRadius" Value="9" />
    <!-- Every toast has the same size (owner, 2026-11-20): one width, a longer message wraps; one minimum height. -->
    <Setter Property="Width" Value="360" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Surface.Elevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
