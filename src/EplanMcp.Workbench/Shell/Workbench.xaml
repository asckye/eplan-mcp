<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls">
  <!--
    The Workbench's own styles on top of the vendored theme (Primer.xaml): only what the theme lacks, from its tokens.
  -->

  <!--
    TYP-11: ligatures off for the whole window (the Typography properties are inherited), so that project data such as
    "->" or "!=" shows the characters it holds (SEC-23), whichever font the system substitutes.
  -->
  <Style x:Key="Workbench.Window" TargetType="Window" BasedOn="{StaticResource Ui.Window}">
    <Setter Property="Background" Value="{DynamicResource Surface.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Typography.StandardLigatures" Value="False" />
    <Setter Property="Typography.ContextualLigatures" Value="False" />
    <Setter Property="Typography.ContextualAlternates" Value="False" />
  </Style>

  <Style x:Key="Ui.Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style x:Key="Workbench.EmptyTitle" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.BodyStrong}">
    <Setter Property="LineHeight" Value="{StaticResource Ui.LineHeight}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <!--
    The v2 sidebar (ADR-0034, design "01-Main"): 232 px on its own colour with a separator on the right; the brand, a
    section label, the pages, then the connection status and settings at the bottom.
  -->
  <Style x:Key="Workbench.Sider" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Workbench.sidebarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.Sider}" />
  </Style>
  <Style x:Key="Workbench.BrandTile" TargetType="Border">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource Accent.Button}" />
  </Style>
  <Style x:Key="Workbench.SiderSection" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="Margin" Value="{StaticResource Ui.Inset.SiderSection}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <Style x:Key="Workbench.NavCount" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    NAV-03: a page of the sidebar. The current page has the selected fill and, beyond colour, SemiBold; the icon keeps the
    accent. Tag, when set, is a count shown as a pill at the end (the waiting approvals). Compact: the icon only.
  -->
  <Style x:Key="Workbench.NavItem" TargetType="RadioButton">
    <Setter Property="GroupName" Value="Pages" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.NavItem}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Path x:Name="Glyph" Style="{StaticResource Primer.Icon}" Width="{StaticResource Ui.IconSize.Large}" Height="{StaticResource Ui.IconSize.Large}" Data="{TemplateBinding ux:Ux.Icon}"
                    Stroke="{DynamicResource Accent.Text}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Right.XS}" />
              <ContentPresenter x:Name="Label" Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="False" />
              <Border x:Name="Count" Grid.Column="2" MinWidth="20" Height="20" Padding="{StaticResource Ui.Inset.NavCount}" CornerRadius="10" VerticalAlignment="Center"
                      Background="{DynamicResource Accent.Button}">
                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Workbench.NavCount}" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Workbench.navSelected}" />
              <Setter Property="Foreground" Value="{DynamicResource Workbench.navSelectedText}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
            </Trigger>
            <Trigger Property="ux:Ux.Compact" Value="True">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Glyph" Property="Margin" Value="0" />
              <Setter TargetName="Glyph" Property="HorizontalAlignment" Value="Center" />
              <Setter Property="Padding" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- v2 grouped list (ADR-0034 decision 2): rows on a rounded card over the grouped background. -->
  <Style x:Key="Workbench.GroupCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Surface.Layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.GroupCard}" />
  </Style>

  <!-- The page's large title in the header (ADR-0034 decision 2: 28 px bold, no breadcrumb). -->
  <Style x:Key="Workbench.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
  </Style>

  <!--
    APR-02: Reject and Approve are the same default button, never primary or danger; their text is plain, so a label
    can never carry an access key; neither is IsDefault or IsCancel (set where they are used). They fill the equal cells
    they are put in, so a label that wraps makes both taller.
  -->
  <Style x:Key="Workbench.Answer" TargetType="Button" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ADR-0035 and ADR-0010: where one answer is the safe one, it is the primary button (Reject for a Destructive write,
    Keep suspended for a release); the Destructive action is the danger button and only opens the typed confirmation.
  -->
  <Style x:Key="Workbench.AnswerPrimary" TargetType="Button" BasedOn="{StaticResource Primer.Primary}">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Workbench.AnswerDanger" TargetType="Button" BasedOn="{StaticResource Primer.Danger}">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- APR-08: project data, read only, selectable, focusable, in the mono font, never markup. -->
  <Style x:Key="Workbench.ProjectData" TargetType="TextBox" BasedOn="{StaticResource Primer.Input}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.Code}" />
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Code}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Code}" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- A technical value that can be selected and copied (CTL-13), such as a backup folder. -->
  <Style x:Key="Workbench.CodeValue" TargetType="TextBox" BasedOn="{StaticResource Workbench.ProjectData}">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.CodeValue}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <!-- Native password editing and UIA masking, with the same theme tokens as other inputs. -->
  <Style x:Key="Workbench.Password" TargetType="PasswordBox">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.Input}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Ui.Radius}"><ScrollViewer x:Name="PART_ContentHost" /></Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /></Trigger></Style.Triggers>
  </Style>

  <!-- The window buttons' glyphs, drawn in the button's text colour (ICO-05). -->
  <Style x:Key="Workbench.CaptionGlyph" TargetType="Path">
    <Setter Property="Width" Value="{StaticResource Ui.IconSize.Caption}" />
    <Setter Property="Height" Value="{StaticResource Ui.IconSize.Caption}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
  </Style>

  <!-- ===== Automation Studio 4.0 Native Desktop IDE Styles (TIA 1:1) ===== -->
  <Style x:Key="Workbench.MonoStrong" TargetType="TextBlock" BasedOn="{StaticResource Primer.Mono.text}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Workbench.TitleBar" TargetType="Border">
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="{DynamicResource Workbench.sidebarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.TitleBar}" />
  </Style>

  <Style x:Key="Workbench.Rail" TargetType="Border">
    <Setter Property="Width" Value="60" />
    <Setter Property="Background" Value="{DynamicResource Workbench.sidebarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.Rail}" />
  </Style>

  <!-- The rail's icons in the 2026-11-20 design, on a 24 x 24 box, drawn as strokes. -->
  <Geometry x:Key="Workbench.Icon.Project">M22,19 A2,2 0 0 1 20,21 H4 A2,2 0 0 1 2,19 V5 A2,2 0 0 1 4,3 H9 L11,6 H20 A2,2 0 0 1 22,8 Z</Geometry>
  <Geometry x:Key="Workbench.Icon.Approvals">M12,22 C12,22 20,18 20,12 V5 L12,2 L4,5 V12 C4,18 12,22 12,22 Z M9,12 L11,14 L15,10</Geometry>
  <Geometry x:Key="Workbench.Icon.Mcp">M4,2 H20 A2,2 0 0 1 22,4 V8 A2,2 0 0 1 20,10 H4 A2,2 0 0 1 2,8 V4 A2,2 0 0 1 4,2 Z M4,14 H20 A2,2 0 0 1 22,16 V20 A2,2 0 0 1 20,22 H4 A2,2 0 0 1 2,20 V16 A2,2 0 0 1 4,14 Z M6,6 H6.01 M6,18 H6.01</Geometry>
  <Geometry x:Key="Workbench.Icon.Clients">M4,3 H20 A2,2 0 0 1 22,5 V15 A2,2 0 0 1 20,17 H4 A2,2 0 0 1 2,15 V5 A2,2 0 0 1 4,3 Z M8,21 H16 M12,17 V21</Geometry>
  <Geometry x:Key="Workbench.Icon.Checks">M22,12 L18,12 L15,21 L9,3 L6,12 L2,12</Geometry>
  <Geometry x:Key="Workbench.Icon.Audit">M14,2 H6 A2,2 0 0 0 4,4 V20 A2,2 0 0 0 6,22 H18 A2,2 0 0 0 20,20 V8 Z M14,2 V8 H20 M9,15 L11,17 L15,13</Geometry>
  <Geometry x:Key="Workbench.Icon.Logs">M4,6 H20 M4,12 H20 M4,18 H14</Geometry>
  <Geometry x:Key="Workbench.Icon.Settings">M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 M19.4,15 A1.65,1.65 0 0 0 19.73,16.82 L19.79,16.88 A2,2 0 1 1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0 0 15.08,19.32 A1.65,1.65 0 0 0 14.08,20.83 V21 A2,2 0 0 1 10.08,21 V20.91 A1.65,1.65 0 0 0 9,19.4 A1.65,1.65 0 0 0 7.18,19.73 L7.12,19.79 A2,2 0 1 1 4.29,16.96 L4.35,16.9 A1.65,1.65 0 0 0 4.68,15.08 A1.65,1.65 0 0 0 3.17,14.08 H3 A2,2 0 0 1 3,10.08 H3.09 A1.65,1.65 0 0 0 4.6,9 A1.65,1.65 0 0 0 4.27,7.18 L4.21,7.12 A2,2 0 1 1 7.04,4.29 L7.1,4.35 A1.65,1.65 0 0 0 8.92,4.68 H9 A1.65,1.65 0 0 0 10,3.17 V3 A2,2 0 0 1 14,3 V3.09 A1.65,1.65 0 0 0 15,4.6 A1.65,1.65 0 0 0 16.82,4.27 L16.88,4.21 A2,2 0 1 1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0 0 19.32,8.92 V9 A1.65,1.65 0 0 0 20.83,10 H21 A2,2 0 0 1 21,14 H20.91 A1.65,1.65 0 0 0 19.4,15 Z</Geometry>
  <!-- Settings (2026-11-20 design): the navigation row, the heading and intro of a category, a row's title and help. -->
  <Geometry x:Key="Workbench.Icon.Sun">M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 M12,2 V4 M12,20 V22 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M2,12 H4 M20,12 H22 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93</Geometry>
  <Geometry x:Key="Workbench.Icon.Database">M21,5 A9,3 0 1 1 3,5 A9,3 0 1 1 21,5 M3,5 V19 A9,3 0 0 0 21,19 V5 M3,12 A9,3 0 0 0 21,12</Geometry>
  <Style x:Key="Workbench.SettingsNavItem" TargetType="RadioButton">
    <Setter Property="GroupName" Value="SettingsNav" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.NavRow}" />
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.QueueRow}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="Glyph" Style="{StaticResource Primer.Icon}" Width="{StaticResource Ui.IconSize.Pane}" Height="{StaticResource Ui.IconSize.Pane}" Data="{TemplateBinding ux:Ux.Icon}" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.9" VerticalAlignment="Center" />
                <ContentPresenter Margin="{StaticResource Ui.Gap.Left.XS}" VerticalAlignment="Center" RecognizesAccessKey="False" />
              </StackPanel>
            </Border>
            <Border x:Name="SelectionBar" Width="2.5" HorizontalAlignment="Left" Margin="{StaticResource Ui.Gap.SelectionBar}" CornerRadius="0,3,3,0" Background="{DynamicResource Accent.Button}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Surface.Layer}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
              <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Accent.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Workbench.PageHeading" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.BodyStrong}">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style x:Key="Workbench.PageIntro" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.PageIntro}" />
  </Style>
  <Style x:Key="Workbench.RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.BodyStrong}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Workbench.RowHelp" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.Top.XXS}" />
  </Style>
  <Style x:Key="Workbench.RowDivider" TargetType="Border">
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.Top.Normal}" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.SettingsRow}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <!-- ver-tile: a choice drawn as a card; the chosen one has the accent outline on the accent tint. -->
  <Style x:Key="Workbench.Tile" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.Tile}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="{DynamicResource Surface.Layer}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource State.Info.Background}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Button}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Workbench.FolderTile" TargetType="Border">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource Surface.Subtle}" />
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.Right.SM}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Workbench.FolderGlyph" TargetType="Path" BasedOn="{StaticResource Primer.Icon}">
    <Setter Property="Width" Value="{StaticResource Ui.IconSize.Pane}" />
    <Setter Property="Height" Value="{StaticResource Ui.IconSize.Pane}" />
    <Setter Property="Data" Value="{StaticResource Workbench.Icon.Project}" />
    <Setter Property="Stroke" Value="{DynamicResource Accent.Text}" />
    <Setter Property="StrokeThickness" Value="1.9" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Workbench.RailItem" TargetType="RadioButton">
    <Setter Property="GroupName" Value="Pages" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.RailItem}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Indicator" Width="3" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.RailIndicator}" CornerRadius="0,3,3,0"
                    Background="{DynamicResource Accent.Button}" Visibility="Collapsed" />
            <Border x:Name="Hover" Background="{DynamicResource Surface.Hover}" CornerRadius="8" Opacity="0" />
            <Border x:Name="Surface" Background="Transparent" CornerRadius="8">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path x:Name="Glyph" Style="{StaticResource Primer.Icon}" Width="{StaticResource Ui.IconSize.Rail}" Height="{StaticResource Ui.IconSize.Rail}" Data="{TemplateBinding ux:Ux.Icon}"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.85" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" />
                <ContentPresenter x:Name="Label" Margin="{StaticResource Ui.Gap.RailLabel}" HorizontalAlignment="Center" RecognizesAccessKey="False">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontSize" Value="10" />
                      <Setter Property="FontWeight" Value="Medium" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </StackPanel>
            </Border>
            <Border x:Name="Count" MinWidth="15" Height="15" Padding="{StaticResource Ui.Inset.RailBadge}" CornerRadius="7.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{StaticResource Ui.Gap.RailBadge}"
                    Background="{DynamicResource Accent.Button}">
              <TextBlock Text="{TemplateBinding Tag}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Text.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
