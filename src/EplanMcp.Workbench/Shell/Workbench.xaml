  <Style x:Key="Workbench.ResultStrip.Success" TargetType="Border" BasedOn="{StaticResource Workbench.ResultStrip}">
    <Setter Property="Background" Value="{DynamicResource State.Success.Background}" />
  </Style>
  <Style x:Key="Workbench.ResultStrip.Error" TargetType="Border" BasedOn="{StaticResource Workbench.ResultStrip}">
    <Setter Property="Background" Value="{DynamicResource State.Error.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource State.Error.Border}" />
  </Style>

  <!-- ===== Workbench 4.0 environment checks: bar title, section labels, failed and passed rows ===== -->
  <Style x:Key="Workbench.BarTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Workbench.BarSeparator" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.Horizontal.XS}" />
    <Setter Property="Background" Value="{DynamicResource Border.Strong}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style x:Key="Workbench.SectionLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
    <Setter Property="Margin" Value="{StaticResource Ui.Gap.SectionLabel}" />
  </Style>
  <Style x:Key="Workbench.CheckTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Workbench.FailRow" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.BoxBody}" />
    <Setter Property="Background" Value="{DynamicResource State.Error.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style x:Key="Workbench.FailIcon" TargetType="Border">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource State.Error.Solid}" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="Warning"><Setter Property="Background" Value="{DynamicResource State.Warning.Solid}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Workbench.FailIconText" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnHighlight}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Workbench.PassRow" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource Ui.Inset.PassRow}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style></ResourceDictionary>
