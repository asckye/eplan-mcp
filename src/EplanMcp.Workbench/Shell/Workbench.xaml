                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
              <Setter Property="Background" Value="{DynamicResource Surface.Layer}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Border.Layer}" />
