<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The Workbench's own styles on top of the vendored theme (Primer.xaml): only what the theme lacks, from its tokens.
  -->

  <!--
    TYP-11: Maple Mono's ligatures off for the whole window (the Typography properties are inherited), so that project
    data such as "->" or "!=" shows the characters it holds (SEC-23).
  -->
  <Style x:Key="Workbench.Window" TargetType="Window" BasedOn="{StaticResource Ui.Window}">
    <Setter Property="Typography.StandardLigatures" Value="False" />
    <Setter Property="Typography.ContextualLigatures" Value="False" />
    <Setter Property="Typography.ContextualAlternates" Value="False" />
  </Style>

  <!-- NAV-03: the selected menu item has the theme's bar and, beyond colour, SemiBold. -->
  <Style x:Key="Workbench.NavItem" TargetType="RadioButton" BasedOn="{StaticResource Primer.NavItem}">
    <Setter Property="GroupName" Value="Pages" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The window buttons' glyphs, drawn in the button's text colour (ICO-05). -->
  <Style x:Key="Workbench.CaptionGlyph" TargetType="Path">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
  </Style>
</ResourceDictionary>
