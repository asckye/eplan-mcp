<Window
    x:Class="EplanMcp.Workbench.Shell.WorkbenchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    Style="{StaticResource Workbench.Window}">
  <!--
    The one modal message (DLG-01), as the Workbench 4.0 ordinary confirmation: an "i" in the accent tint, the question,
    what happens, what it would change in a code box, then the safe button (default and Esc) and the action on the
    right (DLG-03 to DLG-05).
  -->
  <Border Padding="{StaticResource Ui.Padding.Modal}" AutomationProperties.IsDialog="True" AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
    <StackPanel>
      <DockPanel>
        <Border DockPanel.Dock="Left" Style="{StaticResource Workbench.DialogIcon}" Margin="{StaticResource Ui.Gap.Right.SM}">
          <TextBlock Text="{l:Tr Dialog.Glyph}" Style="{StaticResource Workbench.DialogIconText}" />
        </Border>
        <StackPanel>
          <TextBlock x:Name="Heading" Style="{StaticResource Workbench.DialogTitle}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Name="Message" Style="{StaticResource Workbench.DialogBody}" />
        </StackPanel>
      </DockPanel>
      <!-- What the action would change, as plain text to read and select (DLG-12), when there is any. -->
      <Border x:Name="DetailsBox" Style="{StaticResource Workbench.CodeBox}" Margin="{StaticResource Ui.Gap.Top.Normal}" Visibility="{Binding Visibility, ElementName=Details}">
        <TextBox x:Name="Details" Style="{StaticResource Workbench.ProjectData}" Background="Transparent" BorderThickness="0" MaxHeight="320" Visibility="Collapsed"
                 AutomationProperties.LabeledBy="{Binding ElementName=Message}" />
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Ui.Gap.Top.Normal}">
        <Button x:Name="SafeButton" Style="{StaticResource Workbench.ButtonMd}" MinWidth="88" IsDefault="True" IsCancel="True" />
        <Button x:Name="ActionButton" Style="{StaticResource Workbench.ButtonPrimaryMd}" MinWidth="88" Margin="{StaticResource Ui.Gap.Left.XS}" Click="OnAction" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
