<Window
    x:Class="EplanMcp.Workbench.Shell.WorkbenchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    Style="{StaticResource Workbench.Window}">
  <!--
    The one modal message (DLG-01): owned by the main window, its title is the dialog's title. A warning icon with
    the question (DLG-07), the consequences below it, then the safe button, default and Esc, and the action on the
    right (DLG-03 to DLG-05).
  -->
  <Border Padding="{StaticResource Ui.Padding.Modal}" AutomationProperties.IsDialog="True" AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
    <StackPanel>
      <DockPanel>
        <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="{StaticResource Ui.IconSize.Large}" Height="{StaticResource Ui.IconSize.Large}" Margin="{StaticResource Ui.Gap.DialogIcon}" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock x:Name="Heading" Style="{StaticResource Primer.ContainerTitle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" TextTrimming="None" />
          <TextBlock x:Name="Message" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" Margin="{StaticResource Ui.Gap.Top.XS}" />
          <!-- What the action would change, as plain text to read and select (DLG-12), when there is any. -->
          <TextBox x:Name="Details" Style="{StaticResource Workbench.ProjectData}" MaxHeight="320" Margin="{StaticResource Ui.Gap.Top.SM}" Visibility="Collapsed"
                   AutomationProperties.LabeledBy="{Binding ElementName=Message}" />
        </StackPanel>
      </DockPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Ui.Gap.Top.LG}">
        <Button x:Name="SafeButton" Style="{StaticResource Primer.Secondary}" MinWidth="88" IsDefault="True" IsCancel="True" />
        <Button x:Name="ActionButton" Style="{StaticResource Primer.WarningAction}" MinWidth="88" Margin="{StaticResource Ui.Gap.Left.XS}" Click="OnAction" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
