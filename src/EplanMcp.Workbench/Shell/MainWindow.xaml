<Window
    x:Class="EplanMcp.Workbench.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls"
    xmlns:shell="clr-namespace:EplanMcp.Workbench.Shell"
    xmlns:project="clr-namespace:EplanMcp.Workbench.Project"
    xmlns:approvals="clr-namespace:EplanMcp.Workbench.Approvals"
    xmlns:mcp="clr-namespace:EplanMcp.Workbench.Mcp"
    xmlns:clients="clr-namespace:EplanMcp.Workbench.Clients"
    xmlns:status="clr-namespace:EplanMcp.Workbench.Status"
    xmlns:audit="clr-namespace:EplanMcp.Workbench.Audit"
    xmlns:logs="clr-namespace:EplanMcp.Workbench.Logs"
    xmlns:settings="clr-namespace:EplanMcp.Workbench.Settings"
    Width="1240" Height="800" MinWidth="800" MinHeight="640" WindowStartupLocation="CenterScreen"
    WindowStyle="None" ResizeMode="CanResize" Style="{StaticResource Workbench.Window}">
  <chrome:WindowChrome.WindowChrome>
    <chrome:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="8" UseAeroCaptionButtons="False" />
  </chrome:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static shell:MainWindow.NavigateCommand}" CommandParameter="{x:Static shell:WorkbenchPage.Project}" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static shell:MainWindow.NavigateCommand}" CommandParameter="{x:Static shell:WorkbenchPage.Approvals}" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static shell:MainWindow.NavigateCommand}" CommandParameter="{x:Static shell:WorkbenchPage.Mcp}" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static shell:MainWindow.NavigateCommand}" CommandParameter="{x:Static shell:WorkbenchPage.Clients}" />
    <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static shell:MainWindow.NavigateCommand}" CommandParameter="{x:Static shell:WorkbenchPage.Status}" />
    <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static shell:MainWindow.NavigateCommand}" CommandParameter="{x:Static shell:WorkbenchPage.Audit}" />
    <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static shell:MainWindow.NavigateCommand}" CommandParameter="{x:Static shell:WorkbenchPage.Logs}" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static shell:MainWindow.NavigateCommand}" CommandParameter="{x:Static shell:WorkbenchPage.Settings}" />
    <KeyBinding Key="K" Modifiers="Control" Command="{x:Static shell:MainWindow.CommandPaletteCommand}" />
    <KeyBinding Key="B" Modifiers="Control" Command="{x:Static shell:MainWindow.TogglePaneCommand}" />
    <KeyBinding Key="Tab" Modifiers="Control" Command="{x:Static shell:MainWindow.CycleCommand}" CommandParameter="1" />
    <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{x:Static shell:MainWindow.CycleCommand}" CommandParameter="-1" />
    <KeyBinding Key="F5" Command="{x:Static shell:MainWindow.RefreshCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{x:Static shell:MainWindow.FindCommand}" />
    <KeyBinding Key="F6" Command="{x:Static shell:MainWindow.RegionCommand}" CommandParameter="1" />
    <KeyBinding Key="F6" Modifiers="Shift" Command="{x:Static shell:MainWindow.RegionCommand}" CommandParameter="-1" />
  </Window.InputBindings>

  <Grid x:Name="Root" Background="{DynamicResource Surface.Window}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============ TOP 38px NATIVE DESKTOP TITLEBAR (Workbench 4.0 design) ============ -->
    <Border x:Name="Header" Grid.Row="0" Style="{StaticResource Workbench.TitleBar}" AutomationProperties.Name="{l:Tr Shell.Header}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="12" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Workbench.BrandMark}">
            <Path Width="{StaticResource Ui.IconSize.Emblem}" Height="{StaticResource Ui.IconSize.Emblem}" Stretch="Uniform" Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M4,6 H20 M4,12 H14 M4,18 H20 M20.2,12 A2.2,2.2 0 1 1 15.8,12 A2.2,2.2 0 1 1 20.2,12" />
          </Border>
          <TextBlock x:Name="Brand" Text="{l:Tr App.Name}" Style="{StaticResource Workbench.TitleBrand}" />
          <TextBlock Text="{l:Tr Shell.CrumbSeparator}" Style="{StaticResource Workbench.TitleSlash}" />
          <TextBlock x:Name="CurrentPageText" Style="{StaticResource Workbench.TitleCrumb}" />
        </StackPanel>

        <Button x:Name="CommandPaletteButton" Grid.Column="2" Style="{StaticResource Workbench.CommandButton}" chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                AutomationProperties.Name="{l:Tr Shell.CommandPalette}" AutomationProperties.AcceleratorKey="Ctrl+K" ToolTip="{l:Tr Shell.CommandPaletteHint}" Click="OnOpenCommandPalette">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Workbench.Kbd}">
              <TextBlock x:Name="CommandKeyText" Style="{StaticResource Workbench.KbdText}" />
            </Border>
            <StackPanel Orientation="Horizontal">
              <Path Width="{StaticResource Ui.IconSize.Caption}" Height="{StaticResource Ui.IconSize.Caption}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                    Data="M11.5,7 A4.5,4.5 0 1 1 2.5,7 A4.5,4.5 0 1 1 11.5,7 M10.5,10.5 L14,14" />
              <TextBlock Text="{l:Tr Shell.QuickJump}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{StaticResource Ui.Gap.Left.Dot}" />
            </StackPanel>
          </DockPanel>
        </Button>

        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" chrome:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="PaneToggleButton" Style="{StaticResource Workbench.TitleButton}" Click="OnTogglePane" ToolTip="{l:Tr Shell.Collapse}" AutomationProperties.Name="{l:Tr Shell.Collapse}" AutomationProperties.AcceleratorKey="Ctrl+B">
            <Path Width="{StaticResource Ui.IconSize.Pane}" Height="{StaticResource Ui.IconSize.Pane}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeLineJoin="Round" Data="M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M9,3 V21" />
          </Button>
          <Button x:Name="ThemeToggleButton" Style="{StaticResource Workbench.TitleButton}" Margin="{StaticResource Ui.Gap.Left.XXS}" Click="OnQuickTheme" ToolTip="{l:Tr Shell.ThemeToggle}" AutomationProperties.Name="{l:Tr Shell.ThemeToggle}">
            <Path x:Name="ThemeGlyph" Width="{StaticResource Ui.IconSize.Theme}" Height="{StaticResource Ui.IconSize.Theme}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
          <Button x:Name="LangToggleButton" Style="{StaticResource Workbench.TitleTextButton}" Margin="{StaticResource Ui.Gap.Left.XXS}" Click="OnQuickLang" ToolTip="{l:Tr Shell.LangToggle}" AutomationProperties.Name="{l:Tr Shell.LangToggle}" />
          <Border Style="{StaticResource Workbench.TitleDivider}">
            <StackPanel x:Name="WindowButtons" Orientation="Horizontal">
              <Button x:Name="MinimizeButton" Style="{StaticResource Workbench.WindowButton}" Click="OnMinimize">
                <Path Style="{StaticResource Workbench.CaptionGlyph}" Data="M0,5 L10,5" />
              </Button>
              <Button x:Name="MaximizeButton" Style="{StaticResource Workbench.WindowButton}" Click="OnMaximize">
                <Path x:Name="MaximizeGlyph" Style="{StaticResource Workbench.CaptionGlyph}" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
              </Button>
              <Button x:Name="CloseButton" Style="{StaticResource Workbench.CloseButton}" Click="OnClose">
                <Path Style="{StaticResource Workbench.CaptionGlyph}" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <!-- ============ MAIN BODY: 60px FAR-LEFT ACTIVITY RAIL + 8-PAGE CANVAS ============ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="Sider" Grid.Column="0" Style="{StaticResource Workbench.Rail}" AutomationProperties.Name="{l:Tr Shell.Menu}">
        <Grid x:Name="Menu" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <RadioButton x:Name="ProjectItem" Style="{StaticResource Workbench.RailItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Project}" Content="{l:Tr Rail.Project}"
                         AutomationProperties.Name="{l:Tr Page.Project}" AutomationProperties.AcceleratorKey="Ctrl+1"
                         AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="8" Click="OnMenuClick" />
            <RadioButton x:Name="ApprovalsItem" Style="{StaticResource Workbench.RailItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Approvals}" Content="{l:Tr Rail.Approvals}"
                         AutomationProperties.Name="{l:Tr Page.Approvals}" AutomationProperties.AcceleratorKey="Ctrl+2"
                         AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="8" Click="OnMenuClick" />

            <Border Width="26" Height="1" Background="{DynamicResource Border.Layer}" Margin="{StaticResource Ui.Gap.RailDivider}" />

            <RadioButton x:Name="McpItem" Style="{StaticResource Workbench.RailItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Mcp}" Content="{l:Tr Rail.Mcp}"
                         AutomationProperties.Name="{l:Tr Page.Mcp}" AutomationProperties.AcceleratorKey="Ctrl+3"
                         AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="8" Click="OnMenuClick" />
            <RadioButton x:Name="ClientsItem" Style="{StaticResource Workbench.RailItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Clients}" Content="{l:Tr Rail.Clients}"
                         AutomationProperties.Name="{l:Tr Page.Clients}" AutomationProperties.AcceleratorKey="Ctrl+4"
                         AutomationProperties.PositionInSet="4" AutomationProperties.SizeOfSet="8" Click="OnMenuClick" />

            <Border Width="26" Height="1" Background="{DynamicResource Border.Layer}" Margin="{StaticResource Ui.Gap.RailDivider}" />

            <RadioButton x:Name="StatusItem" Style="{StaticResource Workbench.RailItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Checks}" Content="{l:Tr Rail.Status}"
                         AutomationProperties.Name="{l:Tr Page.Status}" AutomationProperties.AcceleratorKey="Ctrl+5"
                         AutomationProperties.PositionInSet="5" AutomationProperties.SizeOfSet="8" Click="OnMenuClick" />
            <RadioButton x:Name="AuditItem" Style="{StaticResource Workbench.RailItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Audit}" Content="{l:Tr Rail.Audit}"
                         AutomationProperties.Name="{l:Tr Page.Audit}" AutomationProperties.AcceleratorKey="Ctrl+6"
                         AutomationProperties.PositionInSet="6" AutomationProperties.SizeOfSet="8" Click="OnMenuClick" />
            <RadioButton x:Name="LogsItem" Style="{StaticResource Workbench.RailItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Logs}" Content="{l:Tr Rail.Logs}"
                         AutomationProperties.Name="{l:Tr Page.Logs}" AutomationProperties.AcceleratorKey="Ctrl+7"
                         AutomationProperties.PositionInSet="7" AutomationProperties.SizeOfSet="8" Click="OnMenuClick" />
          </StackPanel>

          <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Layer}" BorderThickness="0,1,0,0" Padding="{StaticResource Ui.Inset.RailBottom}">
          <StackPanel HorizontalAlignment="Center">
            <RadioButton x:Name="SettingsItem" Style="{StaticResource Workbench.RailItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Settings}" Content="{l:Tr Rail.Settings}"
                         AutomationProperties.Name="{l:Tr Page.Settings}" AutomationProperties.AcceleratorKey="Ctrl+,"
                         AutomationProperties.PositionInSet="8" AutomationProperties.SizeOfSet="8" Click="OnMenuClick" />
          </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid x:Name="Body" Grid.Column="1" AutomationProperties.Name="{l:Tr Shell.Content}">
        <project:ProjectPage x:Name="ProjectPage" />
        <approvals:ApprovalsPage x:Name="ApprovalsPage" />
        <mcp:McpPage x:Name="McpPage" />
        <clients:ClientsPage x:Name="ClientsPage" />
        <status:StatusPage x:Name="StatusPage" />
        <audit:AuditPage x:Name="AuditPage" />
        <logs:LogsPage x:Name="LogsPage" />
        <settings:SettingsPage x:Name="SettingsPage" />
      </Grid>
    </Grid>

    <!-- ============ BOTTOM 26px STATUS BAR (Workbench 4.0 design) ============ -->
    <Border Grid.Row="2" Style="{StaticResource Workbench.StatusBar}" AutomationProperties.Name="{l:Tr Shell.StatusBar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ApprovalStatusButton" Style="{StaticResource Workbench.StatusPill}" ToolTip="{l:Tr Shell.StatusApprovalHint}" Click="OnStatusApprovalToggle">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ApprovalStatusDot" Style="{StaticResource Workbench.StatusDot}" />
              <TextBlock x:Name="ApprovalStatusText" VerticalAlignment="Center" FontWeight="Medium" Margin="{StaticResource Ui.Gap.Left.Dot}" />
            </StackPanel>
          </Button>
          <Button x:Name="AuditStatusButton" Style="{StaticResource Workbench.StatusPill}" FontFamily="{DynamicResource Ui.FontMono}" AutomationProperties.Name="{l:Tr Page.Audit}" Margin="{StaticResource Ui.Gap.Left.XXS}" Click="OnStatusAuditClick">
            <TextBlock x:Name="AuditStatusText" />
          </Button>
          <TextBlock x:Name="VersionStatusText" Style="{StaticResource Workbench.StatusMono}" Margin="{StaticResource Ui.Gap.Left.XS}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SessionButton" Style="{StaticResource Workbench.StatusPill}" Click="OnSessionButton" ToolTip="{l:Tr Shell.SessionHint}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SessionGlyph" Style="{StaticResource Workbench.StatusGlyph}" />
              <TextBlock x:Name="EnvStatusText" Style="{StaticResource Workbench.StatusEnv}" Margin="{StaticResource Ui.Gap.Left.Dot}" />
              <TextBlock x:Name="ProjectStatusText" Style="{StaticResource Workbench.StatusProject}" Margin="{StaticResource Ui.Gap.Left.Dot}" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="ClientSeparator" Text="{l:Tr Shell.StatusSeparator}" Style="{StaticResource Workbench.StatusMuted}" Margin="{StaticResource Ui.Gap.Horizontal.XS}" />
          <TextBlock x:Name="ClientStatusText" Style="{StaticResource Workbench.StatusMuted}" TextTrimming="CharacterEllipsis" />
          <!-- Shown only while questions are not taken: where they go instead, in words (STS-11). -->
          <Path x:Name="PipeIcon" Width="{StaticResource Ui.IconSize.Status}" Height="{StaticResource Ui.IconSize.Status}" Margin="{StaticResource Ui.Gap.Horizontal.XS}" VerticalAlignment="Center" />
          <TextBlock x:Name="PipeText" Style="{StaticResource Workbench.StatusMuted}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ SESSION POPOVER: the EPLAN and the approval pipe, above the status bar ============ -->
    <Grid x:Name="SessionLayer" Grid.RowSpan="3" Visibility="Collapsed">
      <Border Background="Transparent" MouseLeftButtonUp="OnSessionScrim" />
      <shell:SessionPopover x:Name="SessionPane" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{StaticResource Ui.Gap.SessionPopover}"
                            CloseRequested="OnSessionClosed" ChecksRequested="OnSessionChecks" />
    </Grid>
    <!-- ============ TOASTS: bottom centre, above the status bar; they take no input ============ -->
    <StackPanel x:Name="ToastLayer" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="{StaticResource Ui.Gap.ToastLayer}" IsHitTestVisible="False" />
    <TextBlock x:Name="ToastAnnouncer" Grid.Row="1" Height="1" Opacity="0" Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite" />

    <!-- ============ COMMAND PALETTE OVERLAY (Ctrl+K) ============ -->
    <Grid x:Name="CommandLayer" Grid.RowSpan="3" Visibility="Collapsed">
      <Border Style="{StaticResource Primer.Overlay}" MouseLeftButtonUp="OnCommandScrim" />
      <Border Width="490" MaxHeight="360" VerticalAlignment="Top" Margin="{StaticResource Ui.Gap.CommandPalette}" Style="{StaticResource Workbench.Popover}" Padding="0"
              AutomationProperties.IsDialog="True" AutomationProperties.Name="{l:Tr Shell.CommandPalette}"
              PreviewKeyDown="OnCommandPreviewKeyDown">
        <DockPanel>
          <!-- The Workbench 4.0 palette's search row: a glass, the field without a box, the Esc key. -->
          <Border DockPanel.Dock="Top" Height="44" Padding="{StaticResource Ui.Inset.CommandSearch}" BorderBrush="{DynamicResource Border.Layer}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Path DockPanel.Dock="Left" Width="{StaticResource Ui.IconSize.Theme}" Height="{StaticResource Ui.IconSize.Theme}" Stretch="Uniform" Stroke="{DynamicResource Text.Tertiary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                    Data="M11.5,7 A4.5,4.5 0 1 1 2.5,7 A4.5,4.5 0 1 1 11.5,7 M10.5,10.5 L14,14" />
              <Border DockPanel.Dock="Right" Style="{StaticResource Workbench.Kbd}">
                <TextBlock Text="{l:Tr Shell.EscKey}" Style="{StaticResource Workbench.KbdText}" />
              </Border>
              <TextBox x:Name="CommandSearch" Style="{StaticResource Workbench.BareInput}" Margin="{StaticResource Ui.Gap.Horizontal.SM}" TextChanged="OnCommandSearchChanged" />
            </DockPanel>
          </Border>
          <ListBox x:Name="CommandList" Style="{StaticResource Primer.List}" Padding="{StaticResource Ui.Inset.CommandList}" MouseDoubleClick="OnCommandPick" KeyDown="OnCommandListKeyDown" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============ AUDIT RECORD DETAIL OVERLAY ============ -->
    <Grid x:Name="RecordLayer" Grid.RowSpan="3" Visibility="Collapsed">
      <Border Style="{StaticResource Primer.Overlay}" MouseLeftButtonUp="OnRecordScrim" />
      <audit:AuditRecordDrawer x:Name="RecordPane" CloseRequested="OnRecordClosed" FolderRequested="OnRecordFolder" />
    </Grid>
  </Grid>
</Window>
