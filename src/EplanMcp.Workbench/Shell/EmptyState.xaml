<UserControl
    x:Class="EplanMcp.Workbench.Shell.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center">
  <!-- ERR-05: what is missing, then one sentence on why and what comes next; centred in the page body. -->
  <StackPanel MaxWidth="480">
    <Path Style="{StaticResource Primer.EmptyImage}" Margin="0,0,0,12" />
    <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Primer.EmptyText}" FontWeight="SemiBold"
               Foreground="{DynamicResource Primer.text}" />
    <TextBlock Text="{Binding Text, ElementName=Root}" Style="{StaticResource Primer.EmptyText}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
