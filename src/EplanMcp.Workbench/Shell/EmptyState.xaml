<UserControl
    x:Class="EplanMcp.Workbench.Shell.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center">
  <!-- ERR-05: what is missing, then one sentence on why and what comes next; centred in the page body. -->
  <StackPanel MaxWidth="480">
    <Path Style="{StaticResource Primer.EmptyImage}" Margin="{StaticResource Ui.Gap.Bottom.SM}" />
    <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Workbench.EmptyTitle}"
               Foreground="{DynamicResource Text.Primary}" />
    <TextBlock Text="{Binding Text, ElementName=Root}" Style="{StaticResource Primer.EmptyText}" Margin="{StaticResource Ui.Gap.Top.XS}" />
  </StackPanel>
</UserControl>
