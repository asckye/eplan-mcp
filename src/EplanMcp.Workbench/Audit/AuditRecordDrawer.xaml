<UserControl
    x:Class="EplanMcp.Workbench.Audit.AuditRecordDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Focusable="False">
  <!--
    One audit record (docs/design/2026-10-20-m5-operability.md#workbench-implementation, M5 design 4.4 item 2): a 520 epx modal pane from the right,
    with Tab contained and Esc closing it. Field names are technical identifiers; values are selectable plain text.
    Nothing here changes the record.
  -->
  <Border Width="520" Margin="{StaticResource Ui.Gap.Drawer}" HorizontalAlignment="Right" Style="{StaticResource Primer.Drawer}"
          AutomationProperties.IsDialog="True" AutomationProperties.Name="{l:Tr Audit.Record}"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
    <DockPanel>
      <Border DockPanel.Dock="Top" Padding="{StaticResource Ui.Inset.DrawerHeader}" Style="{StaticResource Primer.Divider}">
        <DockPanel>
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Primer.WindowButton}" Click="OnClose"
                  AutomationProperties.Name="{l:Tr Audit.CloseRecord}" ToolTip="{l:Tr Audit.CloseRecord}">
            <Path Style="{StaticResource Workbench.CaptionGlyph}" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
          </Button>
          <StackPanel>
            <TextBlock x:Name="Heading" Text="{l:Tr Audit.Record}" Style="{StaticResource Primer.ContainerTitle}" AutomationProperties.HeadingLevel="Level1"
                       Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
            <TextBlock x:Name="Place" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="{StaticResource Ui.Gap.Top.XXS}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Button x:Name="FolderButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="{StaticResource Ui.Inset.DrawerFooter}" Style="{StaticResource Primer.Secondary}"
              Content="{l:Tr Audit.OpenFolder}" Click="OnFolder" />
      <TextBlock x:Name="FolderProblem" DockPanel.Dock="Bottom" Margin="{StaticResource Ui.Inset.DrawerMessage}" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" TextTrimming="None"
                 Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl x:Name="Fields" Margin="{StaticResource Ui.Inset.DrawerFields}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="{StaticResource Ui.Gap.Bottom.SM}">
                <TextBlock x:Name="Name" Text="{Binding Key}" Style="{StaticResource Primer.Mono.textMuted}" />
                <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Workbench.CodeValue}" TextWrapping="Wrap"
                         AutomationProperties.LabeledBy="{Binding ElementName=Name}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
