<UserControl
    x:Class="EplanMcp.Workbench.Audit.AuditRecordDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Focusable="False">
  <!--
    One audit record (M5 design 4.4 item 2; workbench-ui 3.1: 520 epx from the right; DLG-10: a modal pane, Tab stays
    inside, Esc closes). Every field as the file has it: the name as a technical identifier (TYP-08), the value as plain
    text that can be selected and copied (CTL-12, CTL-13). Nothing here changes the record (NAV-10).
  -->
  <Border Width="520" Margin="0,8,8,8" HorizontalAlignment="Right" Style="{StaticResource Primer.Drawer}"
          AutomationProperties.IsDialog="True" AutomationProperties.Name="{l:Tr Audit.Record}"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
    <DockPanel>
      <Border DockPanel.Dock="Top" Padding="24,12,16,12" Style="{StaticResource Primer.Divider}">
        <DockPanel>
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Primer.WindowButton}" Click="OnClose"
                  AutomationProperties.Name="{l:Tr Audit.CloseRecord}" ToolTip="{l:Tr Audit.CloseRecord}">
            <Path Style="{StaticResource Workbench.CaptionGlyph}" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
          </Button>
          <StackPanel>
            <TextBlock x:Name="Heading" Text="{l:Tr Audit.Record}" Style="{StaticResource Primer.ContainerTitle}" AutomationProperties.HeadingLevel="Level1"
                       Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
            <TextBlock x:Name="Place" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Button x:Name="FolderButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="24,12,24,24" Style="{StaticResource Primer.Secondary}"
              Content="{l:Tr Audit.OpenFolder}" Click="OnFolder" />
      <TextBlock x:Name="FolderProblem" DockPanel.Dock="Bottom" Margin="24,12,24,0" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" TextTrimming="None"
                 Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl x:Name="Fields" Margin="24,16,24,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,12">
                <TextBlock x:Name="Name" Text="{Binding Key}" Style="{StaticResource Primer.Mono.textMuted}" />
                <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Workbench.CodeValue}" TextWrapping="Wrap"
                         AutomationProperties.LabeledBy="{Binding ElementName=Name}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
