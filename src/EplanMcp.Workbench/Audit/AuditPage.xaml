<UserControl
    x:Class="EplanMcp.Workbench.Audit.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:shell="clr-namespace:EplanMcp.Workbench.Shell"
    Focusable="False">
  <!--
    Audit (2026-11-20 design): the bar, the filters, the table with mono cells and the record kind as a tag.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ReloadButton" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Audit.Reload}" AutomationProperties.AcceleratorKey="F5" Click="OnReload" />
          <Button x:Name="FolderButton" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Audit.OpenFolder}" Margin="{StaticResource Ui.Gap.Left.XS}" Click="OnFolder" />
          <Button x:Name="VerifyButton" Style="{StaticResource Primer.Primary}" Content="{l:Tr Audit.Verify}" Margin="{StaticResource Ui.Gap.Left.XS}" Click="OnVerify" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Audit}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Right.SM}"
                     AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
          <TextBlock x:Name="Caption" Style="{StaticResource Primer.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock x:Name="Notice" DockPanel.Dock="Top" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" TextTrimming="None" Margin="{StaticResource Ui.Gap.Banner}"
               Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />

    <StackPanel x:Name="Working" DockPanel.Dock="Top" Margin="{StaticResource Ui.Gap.Banner}" Visibility="Collapsed">
      <TextBlock x:Name="WorkingText" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.LiveSetting="Polite" />
      <ProgressBar x:Name="WorkingBar" Style="{StaticResource Primer.Progress}" Maximum="1" Margin="{StaticResource Ui.Gap.Top.XS}" AutomationProperties.Name="{Binding Text, ElementName=WorkingText}" />
    </StackPanel>
    <Border x:Name="Banner" DockPanel.Dock="Top" Margin="{StaticResource Ui.Gap.Banner}" Visibility="Collapsed">
      <DockPanel>
        <Path x:Name="BannerIcon" DockPanel.Dock="Left" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock x:Name="BannerText" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.LiveSetting="Polite" />
          <TextBox x:Name="BannerDetails" Style="{StaticResource Workbench.CodeValue}" Visibility="Collapsed" AutomationProperties.LabeledBy="{Binding ElementName=BannerText}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="NotRecordsBanner" DockPanel.Dock="Top" Margin="{StaticResource Ui.Gap.Banner}" Style="{StaticResource Primer.Alert.Warning}" Visibility="Collapsed">
      <DockPanel>
        <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}" VerticalAlignment="Top" />
        <TextBlock x:Name="NotRecordsText" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeSubBar}">
      <WrapPanel x:Name="Filters" AutomationProperties.Name="{l:Tr Audit.Filters}">
        <StackPanel Margin="{StaticResource Ui.Inset.FilterField}" Width="140">
          <TextBlock x:Name="DayLabel" Text="{l:Tr Audit.Day}" Style="{StaticResource Primer.InputLabel}" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
          <ComboBox x:Name="DayFilter" Style="{StaticResource Primer.Select}" DisplayMemberPath="Text" AutomationProperties.LabeledBy="{Binding ElementName=DayLabel}" SelectionChanged="OnFilter" />
        </StackPanel>
        <StackPanel Margin="{StaticResource Ui.Inset.FilterField}" Width="180">
          <TextBlock x:Name="ToolLabel" Text="{l:Tr Audit.Tool}" Style="{StaticResource Primer.InputLabel}" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
          <ComboBox x:Name="ToolFilter" Style="{StaticResource Primer.Select}" DisplayMemberPath="Text" AutomationProperties.LabeledBy="{Binding ElementName=ToolLabel}" SelectionChanged="OnFilter" />
        </StackPanel>
        <StackPanel Margin="{StaticResource Ui.Inset.FilterField}" Width="210">
          <TextBlock x:Name="ProjectLabel" Text="{l:Tr Audit.Project}" Style="{StaticResource Primer.InputLabel}" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
          <ComboBox x:Name="ProjectFilter" Style="{StaticResource Primer.Select}" DisplayMemberPath="Text" AutomationProperties.LabeledBy="{Binding ElementName=ProjectLabel}" SelectionChanged="OnFilter" />
        </StackPanel>
        <StackPanel Margin="{StaticResource Ui.Inset.FilterField}" Width="140">
          <TextBlock x:Name="DecisionLabel" Text="{l:Tr Audit.Decision}" Style="{StaticResource Primer.InputLabel}" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
          <ComboBox x:Name="DecisionFilter" Style="{StaticResource Primer.Select}" DisplayMemberPath="Text" AutomationProperties.LabeledBy="{Binding ElementName=DecisionLabel}" SelectionChanged="OnFilter" />
        </StackPanel>
        <StackPanel Margin="{StaticResource Ui.Inset.FilterFieldEnd}" Width="140">
          <TextBlock x:Name="ExecutionLabel" Text="{l:Tr Audit.Execution}" Style="{StaticResource Primer.InputLabel}" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
          <ComboBox x:Name="ExecutionFilter" Style="{StaticResource Primer.Select}" DisplayMemberPath="Text" AutomationProperties.LabeledBy="{Binding ElementName=ExecutionLabel}" SelectionChanged="OnFilter" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <Grid>
      <ListView x:Name="Records" BorderThickness="0" AutomationProperties.Name="{l:Tr Audit.List}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" KeyDown="OnListKeyDown" MouseDoubleClick="OnListOpen">
        <ListView.View>
          <GridView>
            <GridViewColumn x:Name="TimeColumn" Width="160">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="KindColumn" Width="140">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Workbench.Tag}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="ToolColumn" Width="200">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" FontSize="12" FontWeight="Medium" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="ProjectColumn" Width="260">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Project}" Style="{StaticResource Primer.Mono.text}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="ResultColumn" Width="160">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <shell:EmptyState x:Name="Empty" Title="{l:Tr Audit.Empty}" Text="{l:Tr Audit.EmptyText}" Visibility="Collapsed" />
      <shell:EmptyState x:Name="NoMatch" Title="{l:Tr Audit.NoMatch}" Text="{l:Tr Audit.NoMatchText}" Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</UserControl>
