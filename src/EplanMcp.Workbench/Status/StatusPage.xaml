<UserControl
    x:Class="EplanMcp.Workbench.Status.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:commands="clr-namespace:EplanMcp.Workbench.Commands"
    Focusable="False">
  <!--
    The status page (M5 design 4.4 item 4, workbench-ui section 7): the checks of doctor in groups, each line with its
    severity in an icon and in words (ERR-07), the Host's text as plain text (CTL-12); write suspensions also in a Banner
    (STS-06); doctor runs when the page opens and on Refresh (F5), never on its own.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.PageHead}">
      <DockPanel>
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0" Style="{StaticResource Primer.Secondary}"
                Content="{l:Tr Status.Refresh}" AutomationProperties.AcceleratorKey="F5" Click="OnRefresh" />
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Status}" Style="{StaticResource Primer.PageTitle}" TextWrapping="Wrap" TextTrimming="None"
                     Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
          <TextBlock x:Name="Caption" Style="{StaticResource Primer.PageSubtitle}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ProgressBar x:Name="Working" DockPanel.Dock="Top" Style="{StaticResource Primer.Progress}" IsIndeterminate="True" Margin="0,0,0,12"
                 AutomationProperties.Name="{l:Tr Status.Running}" Visibility="Collapsed" />
    <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Primer.Alert.Error}" Visibility="Collapsed">
      <DockPanel>
        <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Error}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock x:Name="ErrorText" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
          <TextBox x:Name="ErrorDetails" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=ErrorText}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border x:Name="SuspensionBanner" DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Primer.Alert.Warning}" Visibility="Collapsed">
      <DockPanel>
        <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock x:Name="SuspensionTitle" Text="{l:Tr Status.Suspended}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" />
          <ItemsControl x:Name="Suspensions" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel>
        <GroupBox Margin="0,0,0,12" AutomationProperties.Name="{l:Tr Addin.Title}">
          <GroupBox.Header>
            <TextBlock Text="{l:Tr Addin.Title}" AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
          </GroupBox.Header>
          <StackPanel>
            <TextBlock Text="{l:Tr Addin.Help}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" />
            <TextBlock x:Name="VariantHint" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ItemsControl x:Name="Variants" Focusable="False" AutomationProperties.Name="{l:Tr Addin.Title}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Text}"
                            Style="{StaticResource Primer.Checkbox}" Checked="OnVariantChanged" Unchecked="OnVariantChanged" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="RegisterButton" Content="{l:Tr Addin.Register}" Style="{StaticResource Primer.Run}" Click="OnRegister" Margin="0,0,8,8" />
              <Button x:Name="UnregisterButton" Content="{l:Tr Addin.Unregister}" Style="{StaticResource Primer.Secondary}" Click="OnUnregister" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>
      <ItemsControl x:Name="Groups" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <GroupBox Margin="0,0,0,12" AutomationProperties.Name="{Binding Title}">
              <GroupBox.Header>
                <TextBlock Text="{Binding Title}" AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" TextTrimming="None" />
              </GroupBox.Header>
              <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <Path x:Name="Icon" DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Success}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Severity}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Top" />
                      <TextBlock Text="{Binding Text}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Top"
                                 AutomationProperties.Name="{Binding AccessibleName}" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="{x:Static commands:CheckStatus.Info}">
                        <Setter TargetName="Icon" Property="Style" Value="{StaticResource Primer.AlertIcon.Info}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="{x:Static commands:CheckStatus.Warning}">
                        <Setter TargetName="Icon" Property="Style" Value="{StaticResource Primer.AlertIcon.Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="{x:Static commands:CheckStatus.Failure}">
                        <Setter TargetName="Icon" Property="Style" Value="{StaticResource Primer.AlertIcon.Error}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </GroupBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
