<UserControl
    x:Class="EplanMcp.Workbench.Status.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Focusable="False">
  <!--
    Environment checks (Workbench 4.0 design): the title with the overall tag, the all/failed switch and "Check again";
    what needs handling first (red), the add-in variants, then what passed; each check with its group as a tag.
  -->
  <UserControl.Resources>
    <DataTemplate x:Key="FailRowTemplate">
      <Border Style="{StaticResource Workbench.FailRow}">
        <DockPanel>
          <Border DockPanel.Dock="Left" Style="{StaticResource Workbench.FailIcon}" Tag="{Binding Tone}">
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Workbench.FailIconText}" />
          </Border>
          <Button DockPanel.Dock="Right" Style="{StaticResource Workbench.ButtonSmPrimary}" Content="{l:Tr Status.FixAddin}" VerticalAlignment="Top"
                  Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" Click="OnFix" />
          <StackPanel Margin="{StaticResource Ui.Gap.Horizontal.SM}">
            <WrapPanel>
              <TextBlock Text="{Binding Text}" Style="{StaticResource Workbench.CheckTitle}" AutomationProperties.Name="{Binding AccessibleName}" />
              <Border Style="{StaticResource Workbench.CcTag}" Margin="{StaticResource Ui.Gap.Left.XS}">
                <TextBlock Text="{Binding Category}" VerticalAlignment="Center" />
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding Severity}" Style="{StaticResource Workbench.CellText}" Margin="{StaticResource Ui.Gap.Top.XXS}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="PassRowTemplate">
      <Border Style="{StaticResource Workbench.PassRow}">
        <DockPanel>
          <Border DockPanel.Dock="Right" Style="{StaticResource Workbench.CcTag}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Glyph}" Style="{StaticResource Workbench.ToneGlyph}" Tag="{Binding Tone}" />
              <TextBlock Text="{Binding Severity}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Dot}" />
            </StackPanel>
          </Border>
          <WrapPanel VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Right.SM}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Workbench.CheckTitle}" AutomationProperties.Name="{Binding AccessibleName}" />
            <Border Style="{StaticResource Workbench.CcTag}" Margin="{StaticResource Ui.Gap.Left.XS}">
              <TextBlock Text="{Binding Category}" VerticalAlignment="Center" />
            </Border>
          </WrapPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Workbench.Segment}" Margin="{StaticResource Ui.Gap.Right.XS}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ShowAll" GroupName="CheckView" Style="{StaticResource Workbench.SegmentItem}" Content="{l:Tr Status.ShowAll}" IsChecked="True" Checked="OnViewChanged" />
              <RadioButton x:Name="ShowFailed" GroupName="CheckView" Style="{StaticResource Workbench.SegmentItem}" Content="{l:Tr Status.ShowFailed}" Checked="OnViewChanged" />
            </StackPanel>
          </Border>
          <Button x:Name="RefreshButton" Style="{StaticResource Workbench.ButtonSmPrimary}" Content="{l:Tr Status.Refresh}" AutomationProperties.AcceleratorKey="F5" Click="OnRefresh" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="{l:Tr Status.Title}" Style="{StaticResource Workbench.BarTitle}"
                     AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
          <Border Style="{StaticResource Workbench.BarSeparator}" />
          <Border x:Name="SummaryTag" Style="{StaticResource Workbench.CcTag}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SummaryGlyph" Style="{StaticResource Workbench.ToneGlyph}" />
              <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.Dot}" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="Caption" Style="{StaticResource Workbench.CellText}" Foreground="{DynamicResource Text.Tertiary}" Margin="{StaticResource Ui.Gap.Left.XS}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ProgressBar x:Name="Working" DockPanel.Dock="Top" Style="{StaticResource Primer.Progress}" IsIndeterminate="True" Height="2"
                 AutomationProperties.Name="{l:Tr Status.Running}" Visibility="Collapsed" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Ui.Inset.DetailPage}" MaxWidth="860">
        <Border x:Name="ErrorBanner" Margin="{StaticResource Ui.Gap.Bottom.SM}" Style="{StaticResource Primer.Alert.Error}" Visibility="Collapsed">
          <DockPanel>
            <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Error}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}" VerticalAlignment="Top" />
            <StackPanel>
              <TextBlock x:Name="ErrorText" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
              <TextBox x:Name="ErrorDetails" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=ErrorText}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border x:Name="SuspensionBanner" Margin="{StaticResource Ui.Gap.Bottom.SM}" Style="{StaticResource Primer.Alert.Warning}" Visibility="Collapsed">
          <DockPanel>
            <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}" VerticalAlignment="Top" />
            <StackPanel>
              <TextBlock x:Name="SuspensionTitle" Text="{l:Tr Status.Suspended}" Style="{StaticResource Ui.Text.BodyStrong}" TextWrapping="Wrap" TextTrimming="None" />
              <ItemsControl x:Name="Suspensions" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" Margin="{StaticResource Ui.Gap.Top.XXS}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- What needs handling: a red caption and a red box, a fix where the Workbench can make one. -->
        <StackPanel x:Name="FailSection" Margin="{StaticResource Ui.Gap.Bottom.Normal}" Visibility="Collapsed">
          <TextBlock x:Name="FailCaption" Style="{StaticResource Workbench.SectionLabel}" Foreground="{DynamicResource State.Error.Text}" AutomationProperties.HeadingLevel="Level2" />
          <Border Style="{StaticResource Workbench.Box}" BorderBrush="{DynamicResource State.Error.Border}" ClipToBounds="True">
            <ItemsControl x:Name="FailRows" Focusable="False" ItemTemplate="{StaticResource FailRowTemplate}" />
          </Border>
        </StackPanel>

        <!-- The add-in's variants: choose, then register or unregister. -->
        <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.BoxBody}" Margin="{StaticResource Ui.Gap.Bottom.Normal}" AutomationProperties.Name="{l:Tr Addin.Title}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="RegisterButton" Content="{l:Tr Addin.Register}" Style="{StaticResource Workbench.ButtonSmPrimary}" Click="OnRegister" Margin="{StaticResource Ui.Gap.Right.XS}" />
              <Button x:Name="UnregisterButton" Content="{l:Tr Addin.Unregister}" Style="{StaticResource Workbench.ButtonSm}" Click="OnUnregister" />
            </StackPanel>
            <StackPanel Margin="{StaticResource Ui.Gap.Right.SM}">
              <TextBlock Text="{l:Tr Addin.Title}" Style="{StaticResource Workbench.CheckTitle}" AutomationProperties.HeadingLevel="Level2" />
              <ItemsControl x:Name="Variants" Focusable="False" AutomationProperties.Name="{l:Tr Addin.Title}" Margin="{StaticResource Ui.Gap.Top.XXS}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Text}"
                              Style="{StaticResource Primer.Checkbox}" Margin="{StaticResource Ui.Gap.Right.SM}" Checked="OnVariantChanged" Unchecked="OnVariantChanged" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="VariantHint" Style="{StaticResource Workbench.CellText}" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="{StaticResource Ui.Gap.Top.XXS}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- What passed. -->
        <StackPanel x:Name="PassSection">
          <TextBlock x:Name="PassCaption" Style="{StaticResource Workbench.SectionLabel}" AutomationProperties.HeadingLevel="Level2" />
          <Border Style="{StaticResource Workbench.Box}" ClipToBounds="True">
            <ItemsControl x:Name="PassRows" Focusable="False" ItemTemplate="{StaticResource PassRowTemplate}" />
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
