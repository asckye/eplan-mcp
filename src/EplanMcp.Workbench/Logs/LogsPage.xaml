<UserControl
    x:Class="EplanMcp.Workbench.Logs.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:shell="clr-namespace:EplanMcp.Workbench.Shell"
    Focusable="False">
  <!-- Runtime logs (Workbench 4.0 design): the level pills and three actions in the bar; one mono row per entry, full width. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="DiagButton" Style="{StaticResource Workbench.ButtonSmPrimary}" Content="{l:Tr Logs.ExportDiag}" Margin="{StaticResource Ui.Gap.Right.XXS}" Click="OnExportDiag" />
          <Button x:Name="ClearButton" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Logs.Clear}" Margin="{StaticResource Ui.Gap.Right.XXS}" Click="OnClear" />
          <Button x:Name="StorageLink" Style="{StaticResource Workbench.ToolButton}" Content="{l:Tr Logs.StorageLink}" Click="OnGoStorage" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- The page's heading for screen readers and focus (NAV-07); the design shows the filters in its place. -->
          <Canvas Width="0">
            <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Logs}" Opacity="0" AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" />
          </Canvas>
          <RadioButton x:Name="FilterAll" GroupName="LogLevel" Style="{StaticResource Workbench.IdePill}" Content="{l:Tr Logs.All}" IsChecked="True" Checked="OnFilterChanged" Margin="{StaticResource Ui.Gap.Right.XXS}" />
          <RadioButton x:Name="FilterWarn" GroupName="LogLevel" Style="{StaticResource Workbench.IdePill}" Content="{l:Tr Logs.Warn}" Checked="OnFilterChanged" Margin="{StaticResource Ui.Gap.Right.XXS}" />
          <RadioButton x:Name="FilterError" GroupName="LogLevel" Style="{StaticResource Workbench.IdePill}" Content="{l:Tr Logs.Error}" Checked="OnFilterChanged" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Background="{DynamicResource Surface.Elevated}">
      <ListBox x:Name="LogList" Style="{StaticResource Primer.List}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Workbench.LogRow}"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{l:Tr Page.Logs}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource Workbench.LogTime}" />
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource Workbench.LogLevel}" Tag="{Binding Tone}" Text="{Binding LevelText}" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding Source}" Style="{StaticResource Workbench.LogSource}" />
              <TextBlock Text="{Binding Message}" Style="{StaticResource Workbench.LogMessage}" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="Empty" VerticalAlignment="Center" Visibility="Collapsed">
        <shell:EmptyState Title="{l:Tr Logs.Empty}" Text="{l:Tr Logs.EmptyText}" />
        <Button Style="{StaticResource Primer.Secondary}" Content="{l:Tr Logs.EmptyCta}" HorizontalAlignment="Center" Margin="{StaticResource Ui.Gap.Top.Normal}" Click="OnGoStorage" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
