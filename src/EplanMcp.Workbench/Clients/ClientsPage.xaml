<UserControl
    x:Class="EplanMcp.Workbench.Clients.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Focusable="False">
  <!--
    The client configuration wizard (M5 design 4.4 item 3, workbench-ui section 7, DLG-12): the clients as cards that are
    check boxes (CTL-07), each saying whether this computer has it; the chosen ones are previewed, then written or
    removed after the engineer confirms (PRI-01). Claude Code is recommended the plugin, with its two commands (CTL-13).
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.PageHead}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
          <Button x:Name="RefreshButton" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Clients.Refresh}" AutomationProperties.AcceleratorKey="F5" Click="OnRefresh" />
          <Button x:Name="RemoveButton" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Clients.Remove}" Margin="8,0,0,0" Click="OnRemove" />
          <Button x:Name="WriteButton" Style="{StaticResource Primer.Run}" Content="{l:Tr Clients.Write}" Margin="8,0,0,0" Click="OnWrite" />
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Clients}" Style="{StaticResource Primer.PageTitle}" TextWrapping="Wrap" TextTrimming="None"
                     Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
          <TextBlock Text="{l:Tr Clients.Caption}" Style="{StaticResource Primer.PageSubtitle}" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- STS-02, STS-03, STS-05: what runs, what came of it, and why a command did nothing. -->
    <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8"
               AutomationProperties.LiveSetting="Polite" />
    <ProgressBar x:Name="Working" DockPanel.Dock="Top" Style="{StaticResource Primer.Progress}" IsIndeterminate="True" Margin="0,0,0,12"
                 AutomationProperties.Name="{Binding Text, ElementName=StatusText}" Visibility="Collapsed" />
    <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Primer.Alert.Error}" Visibility="Collapsed">
      <DockPanel>
        <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Error}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock x:Name="ErrorText" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
          <TextBox x:Name="ErrorDetails" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=ErrorText}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Primer.Alert.Info}" Margin="0,0,0,12">
          <DockPanel>
            <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Info}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
            <StackPanel>
              <TextBlock x:Name="PluginText" Text="{l:Tr Clients.Plugin}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
              <TextBox x:Name="MarketplaceCommand" Style="{StaticResource Workbench.CodeValue}" Margin="0,8,0,0" AutomationProperties.LabeledBy="{Binding ElementName=PluginText}" />
              <TextBox x:Name="InstallCommand" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=PluginText}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <ItemsControl x:Name="Cards" Focusable="False" AutomationProperties.Name="{l:Tr Clients.List}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="300" Margin="0,0,12,12" Padding="16,12" Style="{StaticResource Primer.Container}">
                <CheckBox Style="{StaticResource Primer.Checkbox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanChoose}"
                          AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Problem}" VerticalAlignment="Top">
                  <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{Binding Problem}" Style="{StaticResource Primer.Text.warn}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
