<UserControl
    x:Class="EplanMcp.Workbench.Clients.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Focusable="False">
  <!--
    AI clients (Workbench 4.0 design): the title, the transport and "Edit" in the bar, the local/VM switch and selection
    tools on the right; the client tiles three to a row; the write box; the Claude Code marketplace box.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Workbench.Segment}" Margin="{StaticResource Ui.Gap.Right.XS}">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once">
              <RadioButton x:Name="LocalChoice" GroupName="ClientConnection" Content="{l:Tr VmHost.Local}" Style="{StaticResource Workbench.SegmentItem}" IsChecked="True" Checked="OnMode" />
              <RadioButton x:Name="VmChoice" GroupName="ClientConnection" Content="{l:Tr VmHost.Remote}" Style="{StaticResource Workbench.SegmentItem}" Checked="OnMode" />
            </StackPanel>
          </Border>
          <Button x:Name="SelectDetectedButton" Style="{StaticResource Workbench.ToolButton}" Content="{l:Tr Clients.SelectDetected}" Click="OnSelectDetected" />
          <Button x:Name="ClearSelectionButton" Style="{StaticResource Workbench.ToolButton}" Content="{l:Tr Clients.ClearSelection}" Click="OnClearSelection" />
          <Button x:Name="RefreshButton" Style="{StaticResource Workbench.ToolButton}" Content="{l:Tr Clients.Refresh}" AutomationProperties.AcceleratorKey="F5" Click="OnRefresh" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="{l:Tr Clients.Title}" Style="{StaticResource Workbench.BarTitle}"
                     AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
          <TextBlock x:Name="TransportBadge" Style="{StaticResource Workbench.CellMono}" Margin="{StaticResource Ui.Gap.Left.XS}" />
          <Button x:Name="EditMcpButton" Style="{StaticResource Workbench.LinkButton}" Content="{l:Tr Clients.Edit}" Margin="{StaticResource Ui.Gap.Left.XS}" Click="OnEditMcp" ToolTip="{l:Tr Clients.EditMcp}" AutomationProperties.Name="{l:Tr Clients.EditMcp}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ProgressBar x:Name="Working" DockPanel.Dock="Top" Style="{StaticResource Primer.Progress}" IsIndeterminate="True" Height="2"
                 AutomationProperties.Name="{Binding Text, ElementName=StatusText}" Visibility="Collapsed" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Ui.Inset.DetailPage}" MaxWidth="880">
        <Border x:Name="ErrorBanner" Margin="{StaticResource Ui.Gap.Bottom.SM}" Style="{StaticResource Primer.Alert.Error}" Visibility="Collapsed">
          <DockPanel>
            <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Error}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Icon}" VerticalAlignment="Top" />
            <StackPanel>
              <TextBlock x:Name="ErrorText" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None" />
              <TextBox x:Name="ErrorDetails" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=ErrorText}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- For a VM: where the clients on this host reach it. -->
        <Border x:Name="VmHost" Visibility="Collapsed" Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.SettingsBox}" Margin="{StaticResource Ui.Gap.Bottom.Normal}">
          <StackPanel>
            <TextBlock Text="{l:Tr VmHost.Caption}" Style="{StaticResource Workbench.SettingHelp}" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
            <WrapPanel>
              <StackPanel Margin="{StaticResource Ui.Gap.Wrap.XS}">
                <Label x:Name="VmAddressLabel" Content="{l:Tr VmHost.Address}" Target="{Binding ElementName=VmAddress}" Style="{StaticResource Workbench.FieldLabel}" />
                <TextBox x:Name="VmAddress" Width="150" Style="{StaticResource Primer.Input}" FontFamily="{DynamicResource Ui.FontMono}" AutomationProperties.LabeledBy="{Binding ElementName=VmAddressLabel}" TextChanged="OnVmInput" />
                <TextBlock x:Name="VmAddressError" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" MaxWidth="150" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <StackPanel Margin="{StaticResource Ui.Gap.Wrap.XS}">
                <Label x:Name="VmPortLabel" Content="{l:Tr VmHost.Port}" Target="{Binding ElementName=VmPort}" Style="{StaticResource Workbench.FieldLabel}" />
                <TextBox x:Name="VmPort" Width="72" Style="{StaticResource Primer.Input}" FontFamily="{DynamicResource Ui.FontMono}" AutomationProperties.LabeledBy="{Binding ElementName=VmPortLabel}" TextChanged="OnVmInput" />
                <TextBlock x:Name="VmPortError" Style="{StaticResource Primer.Text.diffRed}" TextWrapping="Wrap" MaxWidth="72" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <Button x:Name="TestVm" VerticalAlignment="Top" Content="{l:Tr VmHost.Test}" Style="{StaticResource Workbench.ButtonMd}" Margin="{StaticResource Ui.Gap.VmButton}" Click="OnTestVm" />
            </WrapPanel>
            <TextBlock x:Name="VmTestStatus" Visibility="Collapsed" Style="{StaticResource Workbench.CellText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{l:Tr VmHost.Plaintext}" Style="{StaticResource Workbench.SettingHelp}" />
          </StackPanel>
        </Border>

        <!-- The client tiles, three to a row; a chosen one has the accent outline and the check. -->
        <ItemsControl x:Name="Cards" Focusable="False" AutomationProperties.Name="{l:Tr Clients.List}" Margin="{StaticResource Ui.Gap.ClientGrid}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox x:Name="Tile" Style="{StaticResource Workbench.ClientTile}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="{StaticResource Ui.Gap.ClientTile}"
                        AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Problem}">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Style="{StaticResource Workbench.ClientCode}">
                    <TextBlock Text="{Binding Code}" Style="{StaticResource Workbench.ClientCodeText}" />
                  </Border>
                  <TextBlock x:Name="Check" DockPanel.Dock="Right" Style="{StaticResource Workbench.ClientCheck}" />
                  <StackPanel Margin="{StaticResource Ui.Gap.Horizontal.XS}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Workbench.CheckTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      <Ellipse x:Name="Found" Style="{StaticResource Workbench.StatusDot}" Margin="{StaticResource Ui.Gap.Left.Dot}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PathLine}" Style="{StaticResource Workbench.CellMono}" FontSize="11" />
                    <TextBlock x:Name="ProblemLine" Text="{Binding Problem}" Style="{StaticResource Primer.Text.warn}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock x:Name="ResultLine" Text="{Binding ResultText}" Style="{StaticResource Workbench.CellText}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" />
                  </StackPanel>
                </DockPanel>
              </CheckBox>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                  <Setter TargetName="ProblemLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="{x:Null}">
                  <Setter TargetName="ResultLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Detected}" Value="False">
                  <Setter TargetName="Found" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Tile" Property="Opacity" Value="0.62" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="Tile" Property="Opacity" Value="1" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- What the write does, and the two actions. -->
        <Border Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.SettingsBoxRow}" Margin="{StaticResource Ui.Gap.Bottom.Normal}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="RemoveButton" Style="{StaticResource Workbench.ButtonSm}" Content="{l:Tr Clients.Remove}" Margin="{StaticResource Ui.Gap.Right.XS}" Click="OnRemove" />
              <Button x:Name="WriteButton" Style="{StaticResource Workbench.ButtonSmPrimary}" Content="{l:Tr Clients.Write}" Click="OnWrite" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SelectedSummary" Style="{StaticResource Workbench.CellText}" Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" />
              <TextBlock x:Name="StatusText" Visibility="Collapsed" Style="{StaticResource Workbench.CellText}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Claude Code's local marketplace. -->
        <Border x:Name="LocalPlugin" Style="{StaticResource Workbench.Box}" Padding="{StaticResource Ui.Inset.SettingsBoxRow}">
          <DockPanel>
            <Button x:Name="GeneratePluginButton" DockPanel.Dock="Right" VerticalAlignment="Top" Content="{l:Tr Clients.GeneratePlugin}" Style="{StaticResource Workbench.ButtonSm}" Margin="{StaticResource Ui.Gap.Left.Normal}" Click="OnGeneratePlugin" />
            <StackPanel>
              <TextBlock Text="{l:Tr Clients.PluginTitle}" Style="{StaticResource Workbench.CheckTitle}" />
              <TextBlock x:Name="PluginText" Text="{l:Tr Clients.Plugin}" Style="{StaticResource Workbench.SettingHelp}" />
              <TextBox x:Name="MarketplaceCommand" Style="{StaticResource Workbench.CodeValue}" Margin="{StaticResource Ui.Gap.Top.XS}" AutomationProperties.LabeledBy="{Binding ElementName=PluginText}" />
              <TextBox x:Name="InstallCommand" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=PluginText}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
