<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EplanMcp.Workbench.exe (ADR-0014, ADR-0017, M5 design 4.4): the engineer's desktop app, which answers the Host's
    approval questions over a named pipe. WPF on .NET 10 with the TIA Workbench theme (Tia\, vendored: see
    THIRD-PARTY-NOTICES.md and Tia\.editorconfig). It never references the Host (M5 design 4.4); the pipe protocol is
    EplanMcp.Workbench.Protocol.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>EplanMcp.Workbench</AssemblyName>
    <RootNamespace>EplanMcp.Workbench</RootNamespace>
    <Version>0.3.0</Version>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.NotifyIcon, the tray icon (ADR-0017 decision 1). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LAY-04: Per-Monitor V2 needs the manifest (spike S18). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFO0003 tells WinForms apps to set DPI awareness in code; this is a WPF app (WinForms only draws the tray icon),
      and WPF reads it from the manifest only.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, Button, FontFamily...: keep WinForms out of the implicit usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EplanMcp.Workbench.Protocol\EplanMcp.Workbench.Protocol.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- TIA's ThemeManager loads the palettes from .../component/Themes/: the vendored dictionaries keep that path. -->
    <Page Remove="Tia\Themes\*.xaml" />
    <Page Include="Tia\Themes\*.xaml" Link="Themes\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Maple Mono CN (SIL OFL 1.1, workbench-ui TYP-01) is never committed: eng\scripts\get-fonts.ps1 downloads it on
    request into the git-ignored .local\fonts. When the two weights of the type ramp are there (or in WorkbenchFontDir),
    they and the licence are copied to Fonts\ next to the exe; without them the Workbench uses the system fallbacks.
  -->
  <PropertyGroup>
    <WorkbenchFontDir Condition="'$(WorkbenchFontDir)' == ''">$(MSBuildThisFileDirectory)..\..\.local\fonts\maple-mono-cn-v7.9\fonts</WorkbenchFontDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(WorkbenchFontDir)\MapleMono-CN-Regular.ttf') And Exists('$(WorkbenchFontDir)\MapleMono-CN-SemiBold.ttf')">
    <Content Include="$(WorkbenchFontDir)\MapleMono-CN-Regular.ttf;$(WorkbenchFontDir)\MapleMono-CN-SemiBold.ttf"
             Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(WorkbenchFontDir)\LICENSE.txt" Condition="Exists('$(WorkbenchFontDir)\LICENSE.txt')"
             Link="Fonts\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EplanMcp.Workbench.Tests" />
  </ItemGroup>
</Project>
