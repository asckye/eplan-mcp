<UserControl
    x:Class="EplanMcp.Workbench.Mcp.McpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:vm="clr-namespace:EplanMcp.Workbench.Vm"
    Focusable="False">
  <!-- MCP server (2026-11-20 design): the bar with the transport tag, the transport card with two tiles, the Host card. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
      <DockPanel>
        <Button x:Name="GoClientsButton" DockPanel.Dock="Right" Style="{StaticResource Primer.Secondary}" MinHeight="28" Content="{l:Tr Mcp.GoClients}" Click="OnGoClients" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="{l:Tr Mcp.Title}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="13" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Right.SM}"
                     AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
          <Border x:Name="TransportTag" Style="{StaticResource Workbench.Tag.Success}">
            <TextBlock x:Name="TransportTagText" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Ui.Inset.DetailPage}" MaxWidth="820">
        <!-- Card 1: transport and endpoint, the two choices as tiles. -->
        <Border Style="{StaticResource Workbench.Card}" Padding="{StaticResource Ui.Inset.SettingsCard}" Margin="{StaticResource Ui.Gap.Bottom.Card}">
          <StackPanel>
            <DockPanel>
              <Border x:Name="ExposureTag" DockPanel.Dock="Right" Style="{StaticResource Workbench.Tag.Success}" VerticalAlignment="Top">
                <TextBlock x:Name="ExposureTagText" VerticalAlignment="Center" />
              </Border>
              <StackPanel>
                <TextBlock Text="{l:Tr Mcp.TransportCard}" Style="{StaticResource Workbench.RowTitle}" FontSize="14" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{l:Tr Mcp.TransportHelp}" Style="{StaticResource Workbench.RowHelp}" FontSize="12" />
              </StackPanel>
            </DockPanel>

            <UniformGrid Rows="1" Margin="{StaticResource Ui.Gap.Top.Normal}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
              <RadioButton x:Name="StdioChoice" GroupName="McpTransport" Style="{StaticResource Workbench.Tile}" Padding="{StaticResource Ui.Inset.CheckRow}" Margin="{StaticResource Ui.Gap.Right.SM}"
                           AutomationProperties.Name="{l:Tr Mcp.LocalStdio}" IsChecked="True" Checked="OnTransportChanged">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Workbench.Tag.Accent}">
                      <TextBlock Text="{l:Tr Mcp.StdioTag}" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{l:Tr Mcp.LocalStdio}" Style="{StaticResource Workbench.RowTitle}" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="{l:Tr Mcp.LocalStdioDesc}" Style="{StaticResource Workbench.RowHelp}" FontSize="12" Margin="{StaticResource Ui.Gap.Top.XS}" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="HttpChoice" GroupName="McpTransport" Style="{StaticResource Workbench.Tile}" Padding="{StaticResource Ui.Inset.CheckRow}"
                           AutomationProperties.Name="{l:Tr Mcp.RemoteHttp}" Checked="OnTransportChanged">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Workbench.Tag}">
                      <TextBlock Text="{l:Tr Mcp.HttpTag}" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{l:Tr Mcp.RemoteHttp}" Style="{StaticResource Workbench.RowTitle}" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="{l:Tr Mcp.RemoteHttpDesc}" Style="{StaticResource Workbench.RowHelp}" FontSize="12" Margin="{StaticResource Ui.Gap.Top.XS}" />
                </StackPanel>
              </RadioButton>
            </UniformGrid>

            <!-- The key-free VM HTTP service, shown only for the HTTP choice. -->
            <Border x:Name="HttpSection" Visibility="Collapsed" Style="{StaticResource Workbench.RowDivider}">
              <StackPanel>
                <Border Style="{StaticResource Primer.Alert.Info}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
                  <TextBlock Text="{l:Tr Mcp.KeyFreeNote}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" />
                </Border>
                <vm:VmPanel x:Name="VmConnection" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Card 2: the Host program that the client configurations start. -->
        <Border Style="{StaticResource Workbench.Card}" Padding="{StaticResource Ui.Inset.SettingsCard}">
          <StackPanel>
            <TextBlock Text="{l:Tr Mcp.PlatformCard}" Style="{StaticResource Workbench.RowTitle}" FontSize="14" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{l:Tr Mcp.PlatformHelp}" Style="{StaticResource Workbench.RowHelp}" FontSize="12" />
            <Border CornerRadius="8" Background="{DynamicResource Surface.Code}" BorderBrush="{DynamicResource Border.Layer}" BorderThickness="1" Padding="{StaticResource Ui.Inset.CheckRow}" Margin="{StaticResource Ui.Gap.Top.Normal}">
              <DockPanel>
                <TextBlock x:Name="HostPathLabel" DockPanel.Dock="Right" Text="{l:Tr Mcp.HostPathLabel}" Style="{StaticResource Primer.Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.XS}" />
                <TextBox x:Name="HostPathBox" Style="{StaticResource Workbench.CodeValue}" Padding="0" AutomationProperties.LabeledBy="{Binding ElementName=HostPathLabel}" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
