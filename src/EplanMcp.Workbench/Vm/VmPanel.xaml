<UserControl x:Class="EplanMcp.Workbench.Vm.VmPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" Focusable="False">
  <!--
    The VM's key-free HTTP service (Workbench 4.0 design): the addresses in one row with their actions, the start or stop
    on the right; the endpoint and the service's state in a code line; the firewall rule below.
  -->
  <StackPanel>
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="{StaticResource Ui.Gap.Left.SM}">
        <Button x:Name="Start" Tag="start" Content="{l:Tr Vm.Start}" Style="{StaticResource Workbench.ButtonPrimaryMd}" Click="OnAction" />
        <Button x:Name="Stop" Tag="stop" Content="{l:Tr Vm.Stop}" Style="{StaticResource Workbench.ButtonDangerMd}" Click="OnAction" />
      </StackPanel>
      <WrapPanel>
        <StackPanel Margin="{StaticResource Ui.Gap.Wrap.XS}">
          <Label x:Name="AddressLabel" Content="{l:Tr Vm.Address}" Target="{Binding ElementName=Address}" Style="{StaticResource Workbench.FieldLabel}" />
          <ComboBox x:Name="Address" Width="140" Style="{StaticResource Primer.Select}" FontFamily="{DynamicResource Ui.FontMono}" FocusVisualStyle="{StaticResource Primer.Focus}" AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}" SelectionChanged="OnInput" />
          <TextBlock x:Name="AddressError" Style="{StaticResource Primer.Text.warn}" TextWrapping="Wrap" MaxWidth="140" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel Margin="{StaticResource Ui.Gap.Wrap.XS}">
          <Label x:Name="PortLabel" Content="{l:Tr Vm.Port}" Target="{Binding ElementName=Port}" Style="{StaticResource Workbench.FieldLabel}" />
          <TextBox x:Name="Port" Width="72" Style="{StaticResource Primer.Input}" FontFamily="{DynamicResource Ui.FontMono}" AutomationProperties.LabeledBy="{Binding ElementName=PortLabel}" TextChanged="OnInput" />
          <TextBlock x:Name="PortError" Style="{StaticResource Primer.Text.warn}" TextWrapping="Wrap" MaxWidth="72" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button x:Name="Allow" Tag="allow" Content="{l:Tr Vm.Allow}" Style="{StaticResource Workbench.ButtonMd}" Click="OnAction" VerticalAlignment="Top" Margin="{StaticResource Ui.Gap.VmButton}" />
      </WrapPanel>
    </DockPanel>

    <!-- The endpoint and the service's state, as a code line. -->
    <Border Style="{StaticResource Workbench.CodeBox}" Padding="{StaticResource Ui.Inset.CodeLine}" Margin="{StaticResource Ui.Gap.Top.XS}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.SM}">
          <Path x:Name="ServiceIcon" Style="{StaticResource Primer.AlertIcon.Info}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Right.XXS}" />
          <TextBlock x:Name="ServiceStatus" Style="{StaticResource Workbench.CellMono}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" MaxWidth="360" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button x:Name="Copy" DockPanel.Dock="Left" Tag="copy" Content="{l:Tr Vm.Copy}" Style="{StaticResource Workbench.ButtonSm}" Click="OnAction" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Right.XS}" />
        <!-- ADR-0067: the MCP address is all a client needs; selectable, and the button copies it. -->
        <TextBox x:Name="Endpoint" Style="{StaticResource Workbench.CodeValue}" IsReadOnly="True" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Vm.McpAddress}" />
      </DockPanel>
    </Border>

    <!-- The firewall rule that lets the local subnet in (ADR-0067). -->
    <DockPanel Margin="{StaticResource Ui.Gap.Top.SM}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="{StaticResource Ui.Gap.Left.SM}">
        <Button x:Name="Remove" Tag="remove" Content="{l:Tr Vm.Remove}" Style="{StaticResource Workbench.ButtonSm}" Click="OnAction" Margin="{StaticResource Ui.Gap.Right.XXS}" />
        <Button x:Name="Refresh" Tag="refresh" Content="{l:Tr Vm.Refresh}" Style="{StaticResource Workbench.ToolButton}" Click="OnAction" />
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="FirewallLabel" Text="{l:Tr Vm.Network}" Style="{StaticResource Workbench.BoxCaption}" />
        <TextBox x:Name="FirewallValue" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=FirewallLabel}" />
      </StackPanel>
    </DockPanel>
    <TextBlock Text="{l:Tr Vm.Uac}" Style="{StaticResource Workbench.SettingHelp}" />

    <ProgressBar x:Name="Working" Style="{StaticResource Primer.Progress}" IsIndeterminate="True" Height="2" AutomationProperties.Name="{l:Tr Vm.Working}" Visibility="Collapsed" Margin="{StaticResource Ui.Gap.Top.XS}" />
    <DockPanel Margin="{StaticResource Ui.Gap.Top.XS}">
      <Path x:Name="StatusIcon" DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Info}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Right.XS}" VerticalAlignment="Top" />
      <TextBlock x:Name="Status" Style="{StaticResource Workbench.CellText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </StackPanel>
</UserControl>
