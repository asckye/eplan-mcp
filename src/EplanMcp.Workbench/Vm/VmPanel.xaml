<UserControl x:Class="EplanMcp.Workbench.Vm.VmPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" Focusable="False">
  <Border Style="{StaticResource Primer.Container}" Padding="{StaticResource Ui.Padding.Card}" Margin="{StaticResource Ui.Gap.Bottom.SM}">
    <StackPanel>
      <TextBlock Text="{l:Tr Vm.Title}" Style="{StaticResource Ui.Text.Section}" AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
      <TextBlock Text="{l:Tr Vm.Help}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" />
      <Label x:Name="InstanceLabel" Content="{l:Tr Vm.Instance}" Target="{Binding ElementName=Instance}" Margin="{StaticResource Ui.Inset.Vertical.XS}" />
      <ComboBox x:Name="Instance" Style="{StaticResource Primer.Select}" FocusVisualStyle="{StaticResource Primer.Focus}" AutomationProperties.LabeledBy="{Binding ElementName=InstanceLabel}" SelectionChanged="OnInstance" />
      <WrapPanel Margin="{StaticResource Ui.Inset.Vertical.XS}">
        <Button x:Name="Instances" Tag="instances" Content="{l:Tr Vm.CheckInstances}" Style="{StaticResource Primer.Secondary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
        <Button x:Name="Start" Tag="start" Content="{l:Tr Vm.Start}" Style="{StaticResource Primer.Primary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
        <Button x:Name="Stop" Tag="stop" Content="{l:Tr Vm.Stop}" Style="{StaticResource Primer.Secondary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
      </WrapPanel>
      <Border Style="{StaticResource Primer.Alert.Info}">
        <DockPanel>
          <Path x:Name="ServiceIcon" DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Info}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Right.XS}" />
          <TextBlock x:Name="ServiceStatus" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Border>
      <Label x:Name="AddressLabel" Content="{l:Tr Vm.Address}" Target="{Binding ElementName=Address}" Margin="{StaticResource Ui.Inset.Vertical.XS}" />
      <ComboBox x:Name="Address" Style="{StaticResource Primer.Select}" FocusVisualStyle="{StaticResource Primer.Focus}" AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}" SelectionChanged="OnInput" />
      <TextBlock x:Name="AddressError" Style="{StaticResource Primer.Text.warn}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <Label x:Name="PortLabel" Content="{l:Tr Vm.Port}" Target="{Binding ElementName=Port}" Margin="{StaticResource Ui.Inset.Vertical.XS}" />
      <TextBox x:Name="Port" Style="{StaticResource Primer.Input}" AutomationProperties.LabeledBy="{Binding ElementName=PortLabel}" TextChanged="OnInput" />
      <TextBlock x:Name="PortError" Style="{StaticResource Primer.Text.warn}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <Label x:Name="HostLabel" Content="{l:Tr Vm.Host}" Target="{Binding ElementName=HostAddress}" Margin="{StaticResource Ui.Inset.Vertical.XS}" />
      <TextBox x:Name="HostAddress" Style="{StaticResource Primer.Input}" AutomationProperties.LabeledBy="{Binding ElementName=HostLabel}" TextChanged="OnInput" />
      <TextBlock x:Name="HostError" Style="{StaticResource Primer.Text.warn}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="KeyLabel" Text="{l:Tr Vm.Key}" Style="{StaticResource Primer.Text}" Margin="{StaticResource Ui.Inset.Vertical.XS}" />
      <TextBox x:Name="KeyValue" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=KeyLabel}" />
      <WrapPanel Margin="{StaticResource Ui.Inset.Vertical.XS}">
        <Button x:Name="Generate" Tag="create" Style="{StaticResource Primer.Secondary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
        <ToggleButton x:Name="Reveal" Tag="show" Content="{l:Tr Vm.Show}" Style="{StaticResource Primer.Filter}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
        <Button x:Name="Copy" Tag="copy" Content="{l:Tr Vm.Copy}" Style="{StaticResource Primer.Secondary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
        <Button x:Name="Delete" Tag="delete" Content="{l:Tr Vm.Delete}" Style="{StaticResource Primer.Secondary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
      </WrapPanel>
      <TextBlock x:Name="FirewallLabel" Text="{l:Tr Vm.Network}" Style="{StaticResource Primer.Text}" />
      <TextBox x:Name="FirewallValue" Style="{StaticResource Workbench.CodeValue}" AutomationProperties.LabeledBy="{Binding ElementName=FirewallLabel}" />
      <WrapPanel Margin="{StaticResource Ui.Inset.Vertical.XS}">
        <Button x:Name="Allow" Tag="allow" Content="{l:Tr Vm.Allow}" Style="{StaticResource Primer.Secondary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
        <Button x:Name="Remove" Tag="remove" Content="{l:Tr Vm.Remove}" Style="{StaticResource Primer.Secondary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
        <Button x:Name="Refresh" Tag="refresh" Content="{l:Tr Vm.Refresh}" Style="{StaticResource Primer.Secondary}" Click="OnAction" Margin="{StaticResource Ui.Gap.Wrap.XS}" />
      </WrapPanel>
      <TextBlock Text="{l:Tr Vm.Uac}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" />
      <ProgressBar x:Name="Working" Style="{StaticResource Primer.Progress}" IsIndeterminate="True" AutomationProperties.Name="{l:Tr Vm.Working}" Visibility="Collapsed" />
      <Border Style="{StaticResource Primer.Alert.Info}" Margin="{StaticResource Ui.Gap.Top.XS}">
        <DockPanel>
          <Path x:Name="StatusIcon" DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Info}" Width="{StaticResource Ui.IconSize.Small}" Height="{StaticResource Ui.IconSize.Small}" Margin="{StaticResource Ui.Gap.Right.XS}" />
          <TextBlock x:Name="Status" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
