<UserControl
    x:Class="EplanMcp.Workbench.Project.ProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls"
    Focusable="False">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LeftCol" Width="262" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Project workspace (2026-11-20 design, without the project tree, which needs a channel from EPLAN): navigation on the left, cards on the right. -->
    <Border x:Name="LeftPane" Style="{StaticResource Workbench.LeftPane}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="{StaticResource Ui.Inset.QueuePane}" BorderBrush="{DynamicResource Border.Layer}" BorderThickness="0,0,0,1">
          <TextBlock Text="{l:Tr Project.Tree}" Style="{StaticResource Workbench.SectionCaption}" Margin="{StaticResource Ui.Gap.QueueSection}" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="{StaticResource Ui.Inset.QueuePane}">
            <TextBlock Text="{l:Tr Project.ToolsGroup}" Style="{StaticResource Workbench.SectionCaption}" Margin="{StaticResource Ui.Gap.QueueSection}" />
            <RadioButton x:Name="NodeOverview" GroupName="ProjectTree" Style="{StaticResource Workbench.SettingsNavItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Project}" Content="{l:Tr Project.Overview}" IsChecked="True" Checked="OnNodeChanged" />
            <RadioButton x:Name="NodeEnv" GroupName="ProjectTree" Style="{StaticResource Workbench.SettingsNavItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Checks}" Content="{l:Tr Project.Diagnostics}" Checked="OnNodeChanged" />
            <RadioButton x:Name="NodeActivity" GroupName="ProjectTree" Style="{StaticResource Workbench.SettingsNavItem}" ux:Ux.Icon="{StaticResource Workbench.Icon.Pulse}" Content="{l:Tr Project.RecentActivity}" Checked="OnNodeChanged" />

            <TextBlock Text="{l:Tr Project.SessionGroup}" Style="{StaticResource Workbench.SectionCaption}" Margin="{StaticResource Ui.Gap.QueueSectionNext}" />
            <ItemsControl x:Name="SessionTree" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="{StaticResource Ui.Gap.QueueRow}" Padding="{StaticResource Ui.Inset.QueueRow}" CornerRadius="8" Background="{DynamicResource Surface.Layer}" BorderBrush="{DynamicResource Border.Layer}" BorderThickness="1">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Primer.Mono.text}" FontSize="11.5" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Primer.Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="{StaticResource Ui.Gap.Top.XXS}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Right IDE Workspace Canvas -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="JumpApprovalsButton" Style="{StaticResource Primer.Secondary}" MinHeight="28" Content="{l:Tr Project.JumpApprovals}" Margin="{StaticResource Ui.Gap.Right.XS}" Click="OnJumpApprovals" />
            <Button x:Name="JumpMcpButton" Style="{StaticResource Primer.Secondary}" MinHeight="28" Content="{l:Tr Project.JumpMcp}" Margin="{StaticResource Ui.Gap.Right.XS}" Click="OnJumpMcp" />
            <Button x:Name="RefreshButton" Style="{StaticResource Primer.Primary}" MinHeight="28" Content="{l:Tr Project.Refresh}" AutomationProperties.AcceleratorKey="F5" Click="OnRefresh" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="{l:Tr Page.Project}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="13" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <ProgressBar x:Name="Working" DockPanel.Dock="Top" Style="{StaticResource Primer.Progress}" IsIndeterminate="True" Visibility="Collapsed" />

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="{StaticResource Ui.Inset.DetailPage}" MaxWidth="920">
          <!-- Overview Panel -->
          <StackPanel x:Name="OverviewPanel">
            <Border Style="{StaticResource Workbench.Card}" Padding="0" Margin="{StaticResource Ui.Gap.Bottom.Normal}">
              <StackPanel>
                <Border Style="{StaticResource Workbench.CardHeader}">
                  <TextBlock Text="{l:Tr Project.SessionGroup}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="12.5" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                </Border>
                <StackPanel Margin="{StaticResource Ui.Inset.CardBody}">
                  <TextBlock x:Name="SessionSummaryText" Style="{StaticResource Primer.Text}" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock x:Name="NoSessionHelp" Text="{l:Tr Project.NoSessionHelp}" Style="{StaticResource Workbench.RowHelp}" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Workbench.Card}" Padding="0">
              <StackPanel>
                <Border Style="{StaticResource Workbench.CardHeader}">
                  <TextBlock x:Name="RecentHeading" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="12.5" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                </Border>
                <ListView x:Name="OverviewActivityList" BorderThickness="0" MaxHeight="340" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn x:Name="ColTime" Width="130"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                      <GridViewColumn x:Name="ColTool" Width="220"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" FontSize="12" FontWeight="Medium" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                      <GridViewColumn x:Name="ColProject" Width="260"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Project}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                      <GridViewColumn x:Name="ColResult" Width="130"><GridViewColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Workbench.Tag}" HorizontalAlignment="Left"><TextBlock Text="{Binding Result}" VerticalAlignment="Center" /></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    </GridView>
                  </ListView.View>
                </ListView>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Environment Panel -->
          <StackPanel x:Name="EnvPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Workbench.Card}" Padding="{StaticResource Ui.Inset.SettingsCard}">
              <StackPanel>
                <TextBlock Text="{l:Tr Project.Diagnostics}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
                <ItemsControl x:Name="SessionDetailList" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="{StaticResource Ui.Inset.RowDivider}" BorderBrush="{DynamicResource Border.Layer}" BorderThickness="0,0,0,1">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Primer.Mono.text}" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" Margin="{StaticResource Ui.Gap.Top.XXS}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Full Activity Panel -->
          <StackPanel x:Name="ActivityPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Workbench.Card}" Padding="{StaticResource Ui.Inset.SettingsCard}">
              <StackPanel>
                <TextBlock Text="{l:Tr Project.RecentActivity}" Style="{StaticResource Ui.Text.BodyStrong}" FontSize="14" Margin="{StaticResource Ui.Gap.Bottom.XS}" />
                <ListView x:Name="FullActivityList" BorderThickness="0" MaxHeight="520" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn x:Name="ColTime2" Width="130"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                      <GridViewColumn x:Name="ColTool2" Width="220"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.text}" FontSize="12" FontWeight="Medium" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                      <GridViewColumn x:Name="ColProject2" Width="260"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Project}" Style="{StaticResource Primer.Mono.textMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                      <GridViewColumn x:Name="ColResult2" Width="130"><GridViewColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Workbench.Tag}" HorizontalAlignment="Left"><TextBlock Text="{Binding Result}" VerticalAlignment="Center" /></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    </GridView>
                  </ListView.View>
                </ListView>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
