<UserControl
    x:Class="EplanMcp.Workbench.Project.ProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    xmlns:shell="clr-namespace:EplanMcp.Workbench.Shell"
    xmlns:project="clr-namespace:EplanMcp.Workbench.Project"
    Focusable="False">
  <!--
    Project workspace (Workbench 4.0 design, ADR-0065): the project tree on the left, read through the Workbench's own
    Host with read-only tools, grouped by structure prefix and page type; on the right the chosen page or group and its
    devices. Nothing on this page writes to EPLAN.
  -->
  <UserControl.Resources>
    <HierarchicalDataTemplate DataType="{x:Type project:ProjectTreeNode}" ItemsSource="{Binding Children}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Workbench.PaneCaptionCount}" VerticalAlignment="Center" Margin="{StaticResource Ui.Gap.Left.XS}" />
        <Border x:Name="Badge" DockPanel.Dock="Left" Style="{StaticResource Workbench.PageBadge}" Margin="{StaticResource Ui.Gap.Right.XS}">
          <TextBlock Text="{Binding Badge}" Style="{StaticResource Workbench.PageBadgeText}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource Workbench.TreeTitle}" />
          <TextBlock x:Name="Sub" Text="{Binding Sub}" Style="{StaticResource Workbench.QueueSub}" />
        </StackPanel>
      </DockPanel>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding Badge}" Value="">
          <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Sub}" Value="">
          <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsGroup}" Value="True">
          <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LeftCol" Width="262" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="LeftPane" Style="{StaticResource Workbench.LeftPane}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.PaneHeader}">
          <DockPanel>
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource Workbench.ToolButton}" Content="{l:Tr Project.Refresh}" AutomationProperties.AcceleratorKey="F5" Click="OnRefresh" />
            <TextBlock x:Name="PageTitle" Text="{l:Tr Project.Tree}" Style="{StaticResource Workbench.PaneHeaderText}"
                       AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource Primer.Focus}" />
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="{StaticResource Ui.Inset.TreeSearch}">
          <TextBox x:Name="TreeSearch" Style="{StaticResource Primer.Input}" Tag="{l:Tr Project.Search}" AutomationProperties.Name="{l:Tr Project.Search}" TextChanged="OnSearch" />
        </Border>
        <TreeView x:Name="Tree" Style="{StaticResource Workbench.Tree}" ItemContainerStyle="{StaticResource Workbench.TreeItem}" AutomationProperties.Name="{l:Tr Project.Tree}"
                  SelectedItemChanged="OnTreeSelected" />
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.IdeBar}">
        <DockPanel>
          <TextBlock x:Name="CountsText" DockPanel.Dock="Right" Style="{StaticResource Workbench.CellMono}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="HeaderBadge" Style="{StaticResource Workbench.PageBadge}" Margin="{StaticResource Ui.Gap.Right.XS}" Visibility="Collapsed">
              <TextBlock x:Name="HeaderBadgeText" Style="{StaticResource Workbench.PageBadgeText}" />
            </Border>
            <TextBlock x:Name="HeaderTitle" Style="{StaticResource Workbench.CellMonoStrong}" FontSize="13" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="HeaderEplan" Style="{StaticResource Workbench.CellText}" Foreground="{DynamicResource Text.Tertiary}" Margin="{StaticResource Ui.Gap.Left.XS}" />
            <!-- A chosen page has three views, as the Workbench 4.0 design's pills: net list, devices, check messages. -->
            <StackPanel x:Name="PageTabs" Orientation="Horizontal" Margin="{StaticResource Ui.Gap.Left.SM}" Visibility="Collapsed">
              <RadioButton x:Name="TabSchematic" GroupName="ProjectSub" Style="{StaticResource Workbench.IdePill}" Content="{l:Tr Project.TabSchematic}" Margin="{StaticResource Ui.Gap.Right.XXS}" Checked="OnTabChanged" />
              <RadioButton x:Name="TabDevices" GroupName="ProjectSub" Style="{StaticResource Workbench.IdePill}" Content="{l:Tr Project.TabDevices}" Margin="{StaticResource Ui.Gap.Right.XXS}" IsChecked="True" Checked="OnTabChanged" />
              <RadioButton x:Name="TabReview" GroupName="ProjectSub" Style="{StaticResource Workbench.IdePill}" AutomationProperties.Name="{l:Tr Project.TabReview}" Checked="OnTabChanged">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{l:Tr Project.TabReview}" VerticalAlignment="Center" />
                  <Border x:Name="ReviewCountPill" Style="{StaticResource Workbench.PillCount}" Margin="{StaticResource Ui.Gap.Left.Dot}" Visibility="Collapsed">
                    <TextBlock x:Name="ReviewCount" VerticalAlignment="Center" />
                  </Border>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <ProgressBar x:Name="Working" DockPanel.Dock="Top" Style="{StaticResource Primer.Progress}" IsIndeterminate="True" Height="2" Visibility="Collapsed" AutomationProperties.Name="{l:Tr Project.Reading}" />

      <Grid>
        <!-- The chosen page or group: its description and its devices. -->
        <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="{StaticResource Ui.Inset.DetailPage}" MaxWidth="880">
            <TextBlock x:Name="DetailTitle" Style="{StaticResource Workbench.DetailTitle}" />
            <TextBlock x:Name="DetailSub" Style="{StaticResource Workbench.CellText}" Margin="{StaticResource Ui.Gap.Top.XXS}" />
            <!-- The net list as plain, selectable lines (the design's "网表摘要"); EPLAN's drawing itself is not rendered. -->
            <Border x:Name="NetlistPanel" Style="{StaticResource Workbench.CodeBox}" Margin="{StaticResource Ui.Gap.Top.Normal}" Visibility="Collapsed">
              <Grid>
                <TextBox x:Name="NetlistText" Style="{StaticResource Workbench.CodeValue}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{l:Tr Project.TabSchematic}" />
                <TextBlock x:Name="NoNetlist" Text="{l:Tr Project.NoNetlist}" Style="{StaticResource Workbench.SettingHelp}" Visibility="Collapsed" />
              </Grid>
            </Border>

            <!-- The check messages EPLAN holds for this page or its devices, errors first. -->
            <Border x:Name="ReviewPanel" Style="{StaticResource Workbench.Box}" Margin="{StaticResource Ui.Gap.Top.Normal}" Padding="{StaticResource Ui.Inset.BoxBody}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ReviewSummary" Style="{StaticResource Workbench.RowTitle}" />
                <TextBlock Text="{l:Tr Project.ChecksHint}" Style="{StaticResource Workbench.SettingHelp}" Margin="{StaticResource Ui.Gap.Top.XXS}" />
                <ItemsControl x:Name="Checks" Focusable="False" AutomationProperties.Name="{l:Tr Project.TabReview}" Margin="{StaticResource Ui.Gap.Top.XS}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Workbench.CodeBox}" Margin="{StaticResource Ui.Gap.Top.XS}">
                        <DockPanel>
                          <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Workbench.CellMonoStrong}" Foreground="{DynamicResource State.Warning.Solid}" Margin="{StaticResource Ui.Gap.Right.XS}" />
                          <TextBlock TextWrapping="Wrap" Style="{StaticResource Workbench.CellMono}">
                            <Run Text="{Binding Code, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding Detail, Mode=OneWay}" />
                          </TextBlock>
                        </DockPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="error">
                          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource State.Error.Solid}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="hint">
                          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent.Text}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoChecks" Text="{l:Tr Project.NoChecks}" Style="{StaticResource Workbench.SettingHelp}" Foreground="{DynamicResource State.Success.Text}" Margin="{StaticResource Ui.Gap.Top.XS}" Visibility="Collapsed" />
              </StackPanel>
            </Border>

            <Border x:Name="DevicesPanel" Style="{StaticResource Workbench.Box}" Margin="{StaticResource Ui.Gap.Top.Normal}" ClipToBounds="True">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Workbench.TableHead}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="1.4*" />
                      <ColumnDefinition Width="1.6*" />
                      <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l:Tr Project.ColTag}" Style="{StaticResource Workbench.TableHeadText}" />
                    <TextBlock Grid.Column="1" Text="{l:Tr Project.ColFullTag}" Style="{StaticResource Workbench.TableHeadText}" />
                    <TextBlock Grid.Column="2" Text="{l:Tr Project.ColCategory}" Style="{StaticResource Workbench.TableHeadText}" />
                    <TextBlock Grid.Column="3" Text="{l:Tr Project.ColPage}" Style="{StaticResource Workbench.TableHeadText}" />
                    <TextBlock Grid.Column="4" Text="{l:Tr Project.ColParts}" Style="{StaticResource Workbench.TableHeadText}" />
                  </Grid>
                </Border>
                <Grid>
                  <ItemsControl x:Name="Devices" Focusable="False" AutomationProperties.Name="{l:Tr Project.Devices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Workbench.PassRow}" Padding="{StaticResource Ui.Inset.TableCell}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="140" />
                              <ColumnDefinition Width="2*" />
                              <ColumnDefinition Width="1.4*" />
                              <ColumnDefinition Width="1.6*" />
                              <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding VisibleTag}" Style="{StaticResource Workbench.CellMonoStrong}" />
                            <TextBlock Grid.Column="1" Text="{Binding Tag}" Style="{StaticResource Workbench.CellMono}" />
                            <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource Workbench.CellText}" />
                            <TextBlock Grid.Column="3" Text="{Binding Page}" Style="{StaticResource Workbench.CellMono}" />
                            <TextBlock Grid.Column="4" Text="{Binding PartsText}" Style="{StaticResource Workbench.CellMono}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="NoDevices" Text="{l:Tr Project.NoDevices}" Style="{StaticResource Workbench.SettingHelp}" Margin="{StaticResource Ui.Inset.BoxBody}" Visibility="Collapsed" />
                </Grid>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- No EPLAN, no Host, nothing chosen or a read that failed: the page says why. -->
        <StackPanel x:Name="Empty" VerticalAlignment="Center">
          <shell:EmptyState x:Name="EmptyState" />
          <Button x:Name="EmptyRefresh" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Project.ReadAgain}" HorizontalAlignment="Center" Margin="{StaticResource Ui.Gap.Top.Normal}" Click="OnRefresh" />
        </StackPanel>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>