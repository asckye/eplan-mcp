{
  "apiVersion": "eplanmcp.pack/v2",
  "kind": "rule",
  "metadata": {
    "name": "switch-letter"
  },
  "spec": {
    "severity": "recommended",
    "source": {
      "standard": "IEC 81346-2:2019",
      "clause": "letter code table; clause number to be confirmed at sign-off",
      "verification": "Values from secondary sources; confirm against the published standard at sign-off."
    },
    "scope": {
      "kind": "function",
      "where": {
        "all": [
          {
            "eq": [
              {
                "property": "function.main"
              },
              {
                "literal": true
              }
            ]
          },
          {
            "in": [
              {
                "property": "function.category"
              },
              {
                "literal": [
                  "Switch"
                ]
              }
            ]
          }
        ]
      }
    },
    "check": {
      "matches": [
        {
          "property": "function.letters"
        },
        {
          "literal": "^[SQB]"
        }
      ]
    },
    "message": {
      "zh": "开关的标识字母以 S（手动操作）、Q（主开关、隔离开关）或 B（位置开关等检测）开头。",
      "en": "Switch designations start with S (manual operation), Q (main or isolating switches) or B (position and other sensing switches)."
    }
  }
}
