# Text files are stored and checked out with LF, matching end_of_line in .editorconfig
# (otherwise `dotnet format --verify-no-changes` fails on Windows checkouts).
# Windows-only tooling below overrides this with CRLF.
* text=auto eol=lf

# Windows-only tooling keeps CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.sln  text eol=crlf
*.slnx text eol=crlf

# Shell scripts and git hooks must stay LF or bash fails with "$'\r': command not found".
*.sh           text eol=lf
eng/hooks/*    text eol=lf

# Source and docs use LF so diffs are identical everywhere.
*.cs     text eol=lf diff=csharp
*.csproj text eol=lf
*.props  text eol=lf
*.targets text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf diff=markdown

# Binary artefacts.
*.png  binary
*.jpg  binary
*.pdf  binary
*.zw1  binary
*.dll  binary
*.exe  binary

# Generated catalogs (`dotnet run --project eng/coverage -- generate` / `scan`). The local gate checks that they match
# their inputs, so reviews read the inputs instead: no text diff here, and GitHub collapses them.
catalog/coverage.json                linguist-generated=true -diff
catalog/mapping/bridge-usage.json    linguist-generated=true -diff
catalog/mapping/tools.json           linguist-generated=true -diff
catalog/**/*.g.tsv                   linguist-generated=true -diff
src/**/*.g.base64                    linguist-generated=true -diff
src/**/*.g.cs                        linguist-generated=true
